---
import '../styles/global.css';
import '../styles/brand-refresh.css';
interface Props { title?: string; description?: string; locale?: 'th'|'en'; path?: string }
const { title='HealthTAG', description='Healthcare interoperability infrastructure', locale='th', path='' } = Astro.props;
const isEn = locale === 'en';
const home = isEn ? '/en/' : '/';
const prefix = isEn ? '/en' : '';
const alt = isEn ? (path ? `/${path}/` : '/') : (path ? `/en/${path}/` : '/en/');
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#102f36"/><link rel="icon" href="/healthtag-mark.svg"/></head><body>
<header class="site-header"><div class="container nav"><a class="brand" href={home}><img class="brand-mark" src="/healthtag-mark.svg" alt=""/><span>HealthTAG</span></a><nav class="nav-links" aria-label="Main navigation"><a href={`${prefix}/interoperability/`}>{isEn?'Platform':'แพลตฟอร์ม'}</a><a href={`${prefix}/phr/`}>PHR</a><a href={`${prefix}/deployments/`}>{isEn?'Deployments':'การใช้งานจริง'}</a><a href={`${prefix}/network/`}>{isEn?'Network':'เครือข่าย'}</a><a href={`${prefix}/company/`}>{isEn?'Company':'บริษัท'}</a><a class="lang" href={alt}>{isEn?'TH':'EN'}</a><a class="nav-cta" href="mailto:contact@healthtag.io">{isEn?'Talk to HealthTAG':'คุยกับ HealthTAG'}</a></nav></div></header>
<slot/>
<footer class="footer"><div class="container footer-grid"><span>© {new Date().getFullYear()} HealthTAG Co., Ltd.</span><span>{isEn?'Clinical data is not stored on the blockchain.':'ข้อมูลเวชระเบียนไม่ได้ถูกเก็บไว้บน blockchain'}</span><a href="mailto:contact@healthtag.io">contact@healthtag.io</a></div></footer>
</body></html>
