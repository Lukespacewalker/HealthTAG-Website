---
import '../styles/reset.css';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/brand-refresh.css';
import '../styles/publications-nav.css';
import '../styles/thai.css';
import BrandLogo from '../components/BrandLogo.astro';
import {
  isNavigationGroupCurrent,
  isNavigationItemCurrent,
  navigationGroups,
  navigationHref,
  navigationUtilities,
} from '../data/navigation';
import plexSansRegular from '@ibm/plex/IBM-Plex-Sans/fonts/complete/woff2/IBMPlexSans-Regular.woff2?url';
import plexThaiRegular from '@ibm/plex/IBM-Plex-Sans-Thai-Looped/fonts/complete/woff2/IBMPlexSansThaiLooped-Regular.woff2?url';

interface Props {
  title?: string;
  description?: string;
  locale?: 'th' | 'en';
  path?: string;
  noindex?: boolean;
}

const {
  title = 'HealthTAG',
  description,
  locale = 'th',
  path = '',
  noindex = false,
} = Astro.props;

const isEn = locale === 'en';
const metaDescription = description ?? (isEn
  ? 'HealthTAG works toward a connected Thailand where health data belongs to patients, patients control consent and use, and hospitals steward records in their source systems.'
  : 'HealthTAG มุ่งสู่ประเทศไทยที่เชื่อมถึงกัน โดยข้อมูลสุขภาพเป็นของผู้ป่วย ผู้ป่วยควบคุมความยินยอมและการใช้ข้อมูล และโรงพยาบาลดูแลเวชระเบียนในระบบต้นทาง');
const prefix = isEn ? '/en' : '';
const home = isEn ? '/en/' : '/';
const normalizedPath = path.replace(/^\/+|\/+$/g, '');
const localizedPath = normalizedPath ? `${prefix}/${normalizedPath}/` : `${prefix}/`;
const alternatePath = normalizedPath
  ? `${isEn ? '' : '/en'}/${normalizedPath}/`
  : isEn ? '/' : '/en/';
const defaultPath = normalizedPath ? `/${normalizedPath}/` : '/';
const canonical = new URL(localizedPath, Astro.site ?? 'https://healthtag.io');
const alternate = new URL(alternatePath, Astro.site ?? 'https://healthtag.io');
const defaultCanonical = new URL(defaultPath, Astro.site ?? 'https://healthtag.io');
const socialImage = new URL('/og-healthtag.png', Astro.site ?? 'https://healthtag.io');

const visionLabel = isEn ? 'Our vision' : 'วิสัยทัศน์ของเรา';
const tagline = isEn
  ? 'Your data. Your consent. One connected Thailand.'
  : 'ข้อมูลของคุณ ความยินยอมของคุณ เชื่อมถึงกันทั้งประเทศ';
const stewardshipStatement = isEn
  ? 'Health data belongs to the patient. Patients control consent and how their data is used, while hospitals retain custody and stewardship of clinical records in their source systems.'
  : 'ข้อมูลสุขภาพเป็นของผู้ป่วย ผู้ป่วยมีอำนาจเหนือความยินยอมและการใช้ข้อมูล ขณะที่โรงพยาบาลเก็บรักษาและดูแลเวชระเบียนในระบบต้นทาง';
const socialImageAlt = `${visionLabel}: ${tagline}`;

const orgJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'HealthTAG Co., Ltd.',
  url: 'https://healthtag.io',
  email: 'contact@healthtag.io',
});
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#F6F8F7" />
    <link rel="preload" href={isEn ? plexSansRegular : plexThaiRegular} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="128x128" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={isEn ? 'th' : 'en'} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={defaultCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HealthTAG" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script type="application/ld+json" set:html={orgJson} is:inline></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{isEn ? 'Skip to main content' : 'ข้ามไปยังเนื้อหาหลัก'}</a>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href={home} aria-label={isEn ? 'HealthTAG home' : 'หน้าแรก HealthTAG'}><BrandLogo priority /></a>
        <nav class="desktop-nav" aria-label={isEn ? 'Main navigation' : 'เมนูหลัก'}>
          <div class="desktop-nav-groups">
            {navigationGroups.map((group) => (
              <details class="desktop-nav-group" name="primary-navigation" data-current={isNavigationGroupCurrent(group, normalizedPath) ? 'true' : undefined}>
                <summary aria-current={isNavigationGroupCurrent(group, normalizedPath) ? 'true' : undefined}>{group.label[locale]}</summary>
                <div class="desktop-nav-menu">
                  <ul>
                    {group.items.map((entry) => (
                      <li>
                        <a href={navigationHref(entry, locale)} aria-current={isNavigationItemCurrent(entry, normalizedPath) ? 'page' : undefined}>
                          {entry.label[locale]}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </details>
            ))}
          </div>
          <div class="desktop-nav-utilities">
            <a href={navigationHref(navigationUtilities.support, locale)} aria-current={normalizedPath === 'support' ? 'page' : undefined}>{navigationUtilities.support.label[locale]}</a>
            <a class="lang" href={alternatePath} lang={isEn ? 'th' : 'en'} aria-label={isEn ? 'อ่านภาษาไทย' : 'Read in English'}>{isEn ? 'TH' : 'EN'}</a>
            <a class="nav-cta" href={navigationHref(navigationUtilities.contact, locale)} aria-current={normalizedPath === 'contact' ? 'page' : undefined}>{isEn ? 'Talk to HealthTAG' : 'คุยกับ HealthTAG'}</a>
          </div>
        </nav>
        <details class="mobile-nav">
          <summary aria-label={isEn ? 'Open navigation' : 'เปิดเมนู'}><span></span><span></span><span></span></summary>
          <div class="mobile-panel">
            <nav aria-label={isEn ? 'Mobile navigation' : 'เมนูสำหรับอุปกรณ์พกพา'}>
              <a class="mobile-home" href={navigationHref(navigationUtilities.home, locale)} aria-current={normalizedPath === '' ? 'page' : undefined}>{navigationUtilities.home.label[locale]}</a>
              {navigationGroups.map((group) => (
                <details class="mobile-nav-group" data-current={isNavigationGroupCurrent(group, normalizedPath) ? 'true' : undefined} open={isNavigationGroupCurrent(group, normalizedPath)}>
                  <summary aria-current={isNavigationGroupCurrent(group, normalizedPath) ? 'true' : undefined}>{group.label[locale]}</summary>
                  <ul>
                    {group.items.map((entry) => (
                      <li>
                        <a href={navigationHref(entry, locale)} aria-current={isNavigationItemCurrent(entry, normalizedPath) ? 'page' : undefined}>
                          {entry.label[locale]}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ))}
              <div class="mobile-utilities">
                <a href={navigationHref(navigationUtilities.support, locale)} aria-current={normalizedPath === 'support' ? 'page' : undefined}>{navigationUtilities.support.label[locale]}</a>
                <a href={navigationHref(navigationUtilities.privacy, locale)} aria-current={normalizedPath === 'privacy' ? 'page' : undefined}>{navigationUtilities.privacy.label[locale]}</a>
                <a href={alternatePath} lang={isEn ? 'th' : 'en'}>{isEn ? 'ภาษาไทย' : 'English'}</a>
              </div>
              <a class="btn primary" href={navigationHref(navigationUtilities.contact, locale)} aria-current={normalizedPath === 'contact' ? 'page' : undefined}>{isEn ? 'Talk to HealthTAG' : 'คุยกับ HealthTAG'}</a>
            </nav>
          </div>
        </details>
      </div>
    </header>
    <div id="main-content"><slot /></div>
    <footer class="footer">
      <div class="container footer-main">
        <div class="footer-brand">
          <BrandLogo />
          <p class="footer-vision"><span>{visionLabel}</span><strong>{tagline}</strong></p>
          <p class="footer-stewardship">{stewardshipStatement}</p>
          <a href="mailto:contact@healthtag.io">contact@healthtag.io</a>
        </div>
        {navigationGroups.map((group) => (
          <nav aria-label={group.label[locale]}>
            <strong>{group.label[locale]}</strong>
            {group.items.map((entry) => (
              <a href={navigationHref(entry, locale)} aria-current={isNavigationItemCurrent(entry, normalizedPath) ? 'page' : undefined}>{entry.label[locale]}</a>
            ))}
          </nav>
        ))}
      </div>
      <div class="container footer-legal">
        <span>© {new Date().getFullYear()} HealthTAG Co., Ltd.</span>
        <nav aria-label={isEn ? 'Support, contact, and language' : 'ช่วยเหลือ ติดต่อ และภาษา'}>
          <a href={navigationHref(navigationUtilities.support, locale)} aria-current={normalizedPath === 'support' ? 'page' : undefined}>{navigationUtilities.support.label[locale]}</a>
          <a href={navigationHref(navigationUtilities.contact, locale)} aria-current={normalizedPath === 'contact' ? 'page' : undefined}>{navigationUtilities.contact.label[locale]}</a>
          <a href={navigationHref(navigationUtilities.privacy, locale)} aria-current={normalizedPath === 'privacy' ? 'page' : undefined}>{navigationUtilities.privacy.label[locale]}</a>
          <a href={alternatePath} lang={isEn ? 'th' : 'en'}>{isEn ? 'ภาษาไทย' : 'English'}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
