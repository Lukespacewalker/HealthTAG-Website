---
import '../styles/global.css';
import '../styles/brand-refresh.css';
import '../styles/production.css';
interface Props { title?: string; description?: string; locale?: 'th'|'en'; path?: string }
const { title='HealthTAG', description='Healthcare interoperability infrastructure', locale='th', path='' } = Astro.props;
const isEn = locale === 'en';
const home = isEn ? '/en/' : '/';
const prefix = isEn ? '/en' : '';
const normalizedPath = path ? `${path}/` : '';
const canonicalPath = isEn ? `/en/${normalizedPath}` : `/${normalizedPath}`;
const alternatePath = isEn ? `/${normalizedPath}` : `/en/${normalizedPath}`;
const canonical = new URL(canonicalPath, Astro.site ?? 'https://healthtag.io');
const alternate = new URL(alternatePath, Astro.site ?? 'https://healthtag.io');
const nav = [
  ['interoperability', isEn?'Platform':'แพลตฟอร์ม'],['phr','PHR'],['deployments',isEn?'Deployments':'การใช้งานจริง'],['network',isEn?'Network':'เครือข่าย'],['company',isEn?'Company':'บริษัท']
];
const orgJson = JSON.stringify({'@context':'https://schema.org','@type':'Organization',name:'HealthTAG Co., Ltd.',url:'https://healthtag.io',email:'contact@healthtag.io',telephone:'+66-2-460-9212'});
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#102f36"/><link rel="icon" href="/healthtag-mark.svg"/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang={locale} href={canonical}/><link rel="alternate" hreflang={isEn?'th':'en'} href={alternate}/><link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site ?? 'https://healthtag.io')}/><meta property="og:type" content="website"/><meta property="og:site_name" content="HealthTAG"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/og-healthtag.svg', Astro.site ?? 'https://healthtag.io')}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Thai+Looped:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet"/><script type="application/ld+json" set:html={orgJson}></script></head><body>
<header class="site-header"><div class="container nav"><a class="brand" href={home}><img class="brand-mark" src="/healthtag-mark.svg" alt=""/><span>HealthTAG</span></a><nav class="nav-links" aria-label="Main navigation">{nav.map(([slug,label])=><a href={`${prefix}/${slug}/`}>{label}</a>)}<a class="lang" href={alternatePath}>{isEn?'TH':'EN'}</a><a class="nav-cta" href="mailto:contact@healthtag.io">{isEn?'Talk to HealthTAG':'คุยกับ HealthTAG'}</a></nav><details class="mobile-nav"><summary aria-label={isEn?'Open navigation':'เปิดเมนู'}><span></span><span></span><span></span></summary><div class="mobile-panel"><nav aria-label="Mobile navigation">{nav.map(([slug,label])=><a href={`${prefix}/${slug}/`}>{label}</a>)}<a href={`${prefix}/evidence/`}>{isEn?'Evidence & sources':'หลักฐานและแหล่งข้อมูล'}</a><a href={alternatePath}>{isEn?'ภาษาไทย':'English'}</a><a class="btn primary" href="mailto:contact@healthtag.io">{isEn?'Talk to HealthTAG':'คุยกับ HealthTAG'}</a></nav></div></details></div></header>
<slot/>
<footer class="footer"><div class="container footer-grid"><span>© {new Date().getFullYear()} HealthTAG Co., Ltd.</span><span>{isEn?'Clinical data is not stored on the blockchain.':'ข้อมูลเวชระเบียนไม่ได้ถูกเก็บไว้บน blockchain'}</span><a href={`${prefix}/evidence/`}>{isEn?'Evidence & sources':'หลักฐานและแหล่งข้อมูล'}</a><a href="mailto:contact@healthtag.io">contact@healthtag.io</a></div></footer>
</body></html>
