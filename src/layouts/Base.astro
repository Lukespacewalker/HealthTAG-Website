---
import '../styles/reset.css';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/brand-refresh.css';
import '../styles/thai.css';
import BrandLogo from '../components/BrandLogo.astro';
import plexSansRegular from '@ibm/plex/IBM-Plex-Sans/fonts/complete/woff2/IBMPlexSans-Regular.woff2?url';
import plexThaiRegular from '@ibm/plex/IBM-Plex-Sans-Thai-Looped/fonts/complete/woff2/IBMPlexSansThaiLooped-Regular.woff2?url';

interface Props {
  title?: string;
  description?: string;
  locale?: 'th' | 'en';
  path?: string;
  noindex?: boolean;
}

const {
  title = 'HealthTAG',
  description = 'Healthcare interoperability infrastructure',
  locale = 'th',
  path = '',
  noindex = false,
} = Astro.props;

const isEn = locale === 'en';
const prefix = isEn ? '/en' : '';
const home = isEn ? '/en/' : '/';
const normalizedPath = path.replace(/^\/+|\/+$/g, '');
const localizedPath = normalizedPath ? `${prefix}/${normalizedPath}/` : `${prefix}/`;
const alternatePath = normalizedPath
  ? `${isEn ? '' : '/en'}/${normalizedPath}/`
  : isEn ? '/' : '/en/';
const canonical = new URL(localizedPath, Astro.site ?? 'https://healthtag.io');
const alternate = new URL(alternatePath, Astro.site ?? 'https://healthtag.io');
const socialImage = new URL('/og-healthtag.png', Astro.site ?? 'https://healthtag.io');

const nav = [
  ['interoperability', isEn ? 'Platform' : 'แพลตฟอร์ม'],
  ['phr', 'PHR'],
  ['deployments', isEn ? 'Deployments' : 'การใช้งานจริง'],
  ['network', isEn ? 'Network' : 'เครือข่าย'],
  ['company', isEn ? 'Company' : 'บริษัท'],
];

const orgJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'HealthTAG Co., Ltd.',
  url: 'https://healthtag.io',
  email: 'contact@healthtag.io',
});
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#102f36" />
    <link rel="preload" href={isEn ? plexSansRegular : plexThaiRegular} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="128x128" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={isEn ? 'th' : 'en'} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site ?? 'https://healthtag.io')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HealthTAG" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={isEn ? 'HealthTAG — healthcare interoperability with hospitals in control' : 'HealthTAG — เชื่อมข้อมูลสุขภาพโดยโรงพยาบาลยังเป็นผู้ควบคุม'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={isEn ? 'HealthTAG — healthcare interoperability with hospitals in control' : 'HealthTAG — เชื่อมข้อมูลสุขภาพโดยโรงพยาบาลยังเป็นผู้ควบคุม'} />
    <script type="application/ld+json" set:html={orgJson} is:inline></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{isEn ? 'Skip to main content' : 'ข้ามไปยังเนื้อหาหลัก'}</a>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href={home} aria-label={isEn ? 'HealthTAG home' : 'หน้าแรก HealthTAG'}><BrandLogo priority /></a>
        <nav class="nav-links" aria-label={isEn ? 'Main navigation' : 'เมนูหลัก'}>
          {nav.map(([slug, label]) => <a href={`${prefix}/${slug}/`}>{label}</a>)}
          <a class="lang" href={alternatePath} lang={isEn ? 'th' : 'en'}>{isEn ? 'TH' : 'EN'}</a>
          <a class="nav-cta" href={`${prefix}/contact/`}>{isEn ? 'Talk to HealthTAG' : 'คุยกับ HealthTAG'}</a>
        </nav>
        <details class="mobile-nav">
          <summary aria-label={isEn ? 'Open navigation' : 'เปิดเมนู'}><span></span><span></span><span></span></summary>
          <div class="mobile-panel">
            <nav aria-label={isEn ? 'Mobile navigation' : 'เมนูสำหรับอุปกรณ์พกพา'}>
              {nav.map(([slug, label]) => <a href={`${prefix}/${slug}/`}>{label}</a>)}
              <a href={`${prefix}/how-it-works/`}>{isEn ? 'How it works' : 'ระบบทำงานอย่างไร'}</a>
              <a href={`${prefix}/trust/`}>{isEn ? 'Trust & access' : 'ความไว้วางใจและสิทธิ์เข้าถึง'}</a>
              <a href={`${prefix}/evidence/`}>{isEn ? 'Evidence & sources' : 'หลักฐานและแหล่งข้อมูล'}</a>
              <a href={`${prefix}/privacy/`}>{isEn ? 'Website privacy' : 'ความเป็นส่วนตัวของเว็บไซต์'}</a>
              <a href={alternatePath} lang={isEn ? 'th' : 'en'}>{isEn ? 'ภาษาไทย' : 'English'}</a>
              <a class="btn primary" href={`${prefix}/contact/`}>{isEn ? 'Talk to HealthTAG' : 'คุยกับ HealthTAG'}</a>
            </nav>
          </div>
        </details>
      </div>
    </header>
    <div id="main-content"><slot /></div>
    <footer class="footer">
      <div class="container footer-main">
        <div class="footer-brand">
          <BrandLogo />
          <p>{isEn ? 'Healthcare interoperability infrastructure that keeps clinical data under hospital control.' : 'โครงสร้างพื้นฐานเพื่อเชื่อมโยงข้อมูลสุขภาพ โดยข้อมูลทางคลินิกยังอยู่ภายใต้การควบคุมของโรงพยาบาล'}</p>
          <a href="mailto:contact@healthtag.io">contact@healthtag.io</a>
        </div>
        <nav aria-label={isEn ? 'Platform links' : 'ลิงก์แพลตฟอร์ม'}>
          <strong>{isEn ? 'Platform' : 'แพลตฟอร์ม'}</strong>
          <a href={`${prefix}/interoperability/`}>{isEn ? 'Interoperability' : 'การเชื่อมโยงข้อมูลระหว่างระบบ'}</a>
          <a href={`${prefix}/how-it-works/`}>{isEn ? 'How it works' : 'ระบบทำงานอย่างไร'}</a>
          <a href={`${prefix}/trust/`}>{isEn ? 'Trust & access' : 'ความไว้วางใจและสิทธิ์เข้าถึง'}</a>
          <a href={`${prefix}/phr/`}>PHR</a>
        </nav>
        <nav aria-label={isEn ? 'Company links' : 'ลิงก์บริษัท'}>
          <strong>{isEn ? 'Company' : 'บริษัท'}</strong>
          <a href={`${prefix}/deployments/`}>{isEn ? 'Deployments' : 'การติดตั้งใช้งาน'}</a>
          <a href={`${prefix}/network/`}>{isEn ? 'Network' : 'เครือข่าย'}</a>
          <a href={`${prefix}/evidence/`}>{isEn ? 'Evidence & sources' : 'หลักฐานและแหล่งข้อมูล'}</a>
          <a href={`${prefix}/company/`}>{isEn ? 'Company & founder' : 'บริษัทและผู้ก่อตั้ง'}</a>
        </nav>
        <nav aria-label={isEn ? 'Contact and policy links' : 'ลิงก์ติดต่อและนโยบาย'}>
          <strong>{isEn ? 'Contact' : 'ติดต่อ'}</strong>
          <a href={`${prefix}/contact/`}>{isEn ? 'Contact HealthTAG' : 'ติดต่อ HealthTAG'}</a>
          <a href={`${prefix}/privacy/`}>{isEn ? 'Website privacy notice' : 'ประกาศความเป็นส่วนตัวของเว็บไซต์'}</a>
          <a href={alternatePath} lang={isEn ? 'th' : 'en'}>{isEn ? 'ภาษาไทย' : 'English'}</a>
        </nav>
      </div>
      <div class="container footer-legal"><span>© {new Date().getFullYear()} HealthTAG Co., Ltd.</span></div>
    </footer>
  </body>
</html>
