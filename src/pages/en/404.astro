---
import Base from '../../layouts/Base.astro';
---

<Base
  locale="en"
  path="404"
  noindex
  title="Page not found | HealthTAG"
  description="The requested HealthTAG page could not be found."
>
  <main>
    <section class="not-found">
      <div class="container not-found-grid">
        <div class="error-code" aria-hidden="true">404</div>
        <div>
          <div class="eyebrow">Page not found</div>
          <h1>This link may have moved to a more specific page.</h1>
          <p>Choose a primary destination below. If this was an older news, article, support, or download URL, it may not have been migrated; unrelated legacy links are not automatically sent to Home.</p>
          <div class="actions">
            <a class="btn primary" href="/en/">Home</a>
            <a class="btn secondary" href="/en/interoperability/">Platform</a>
            <a class="btn secondary" href="/en/evidence/">Evidence</a>
            <a class="btn secondary" href="/en/contact/">Contact</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .not-found { min-height: 72vh; padding: clamp(64px, 10vw, 130px) 0; display: grid; align-items: center; }
  .not-found-grid { display: grid; grid-template-columns: minmax(180px, .42fr) minmax(0, 1.2fr); gap: clamp(40px, 8vw, 110px); align-items: start; }
  .error-code { font-family: 'IBM Plex Mono', ui-monospace, monospace; color: var(--teal); font-size: clamp(6rem, 16vw, 13rem); line-height: .8; letter-spacing: -.1em; }
  h1 { max-width: 880px; margin: 0; font-size: clamp(2.4rem, 5vw, 4.8rem); line-height: 1.06; letter-spacing: -.05em; }
  p { max-width: 780px; color: var(--muted); font-size: 1.03rem; }
  @media (max-width: 760px) { .not-found-grid { grid-template-columns: 1fr; } .error-code { font-size: 6rem; } }
</style>
