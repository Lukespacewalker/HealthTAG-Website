---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PublicationDetail from '../../../components/PublicationDetail.astro';
import { pairedPublication } from '../../../lib/publications';
export async function getStaticPaths() { const entries = await getCollection('publications', ({ data }) => data.status === 'published' && data.locale === 'en' && data.kind === 'award'); return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } })); }
const { entry } = Astro.props as { entry: CollectionEntry<'publications'> }; const allEntries = await getCollection('publications', ({ data }) => data.status === 'published');
const alternate = pairedPublication(entry, allEntries); const { Content, headings } = await render(entry);
---
<PublicationDetail {entry} {alternate} {Content} {headings} />
