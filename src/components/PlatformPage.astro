---
import Base from '../layouts/Base.astro';
import { evidence } from '../data/evidence';
import type { Locale } from '../data/site-content';

interface Props { locale: Locale }

const { locale } = Astro.props;
const en = locale === 'en';
const prefix = en ? '/en' : '';

const localLinks = en
  ? [
      ['#overview', 'Overview'],
      ['#capabilities', 'Capabilities'],
      ['#operating-model', 'Operating model'],
      ['#hospital-leaders', 'For hospital leaders'],
      ['#it-teams', 'For IT teams'],
      ['#evidence', 'Evidence'],
    ]
  : [
      ['#overview', 'ภาพรวม'],
      ['#capabilities', 'ความสามารถ'],
      ['#operating-model', 'บทบาทของแต่ละฝ่าย'],
      ['#hospital-leaders', 'สำหรับผู้บริหารโรงพยาบาล'],
      ['#it-teams', 'สำหรับทีม IT'],
      ['#evidence', 'หลักฐาน'],
    ];

const capabilities = en
  ? [
      {
        name: 'Data Connect',
        body: 'Moves selected data from an existing HIS into a hospital-stewarded HL7 FHIR R4 system. Hospital IT can use its own integration script or HealthTAG FHIR Transformer.',
        href: `${prefix}/interoperability/`,
        link: 'Data interoperability',
      },
      {
        name: 'Patient identity linkage',
        body: 'Links the patient identifier used by each hospital to a common identity reference, while clinical records remain in hospital systems.',
        href: `${prefix}/phr/`,
        link: 'Identity and PHR',
      },
      {
        name: 'Consent and authorization',
        body: 'Records the patient\'s consent, while the authorization service evaluates each access request before the source system returns permitted information.',
        href: `${prefix}/trust/`,
        link: 'Consent, trust and access',
      },
      {
        name: 'Audit and provenance',
        body: 'Records consent and access events for later review and keeps the hospital source of the clinical record clear. Clinical records are not stored on blockchain.',
        href: `${prefix}/trust/`,
        link: 'Audit and record sources',
      },
    ]
  : [
      {
        name: 'Data Connect',
        body: 'นำข้อมูลที่เลือกจาก HIS เดิมเข้าสู่ระบบ HL7 FHIR R4 ที่โรงพยาบาลดูแล ทีม IT เลือกใช้สคริปต์ของตนเองหรือ HealthTAG FHIR Transformer ได้',
        href: `${prefix}/interoperability/`,
        link: 'การเชื่อมโยงข้อมูล',
      },
      {
        name: 'ระบบเชื่อมตัวตนผู้ป่วย',
        body: 'เชื่อมรหัสผู้ป่วยที่แต่ละโรงพยาบาลใช้กับตัวระบุกลาง ส่วนเวชระเบียนยังอยู่ในระบบของโรงพยาบาล',
        href: `${prefix}/phr/`,
        link: 'ตัวตนและ PHR',
      },
      {
        name: 'ความยินยอมและการอนุญาตสิทธิ์',
        body: 'ระบบบันทึกความยินยอมของผู้ป่วย ส่วนบริการตรวจสิทธิ์ประเมินคำขอแต่ละครั้งก่อนระบบต้นทางส่งข้อมูลตามสิทธิ์',
        href: `${prefix}/trust/`,
        link: 'ความยินยอม ความไว้วางใจ และสิทธิ์เข้าถึง',
      },
      {
        name: 'การตรวจสอบและที่มาของข้อมูล',
        body: 'บันทึกเหตุการณ์ความยินยอมและการเข้าถึงไว้ตรวจสอบภายหลัง พร้อมแยกให้ชัดว่าโรงพยาบาลใดดูแลเวชระเบียนต้นทาง โดยไม่เก็บเวชระเบียนบน blockchain',
        href: `${prefix}/trust/`,
        link: 'ขอบเขตการตรวจสอบย้อนหลัง',
      },
    ];

const proofIds = ['siriraj-5g-smart-hospital', 'apicta-2022', 'etda-digital-service-sandbox'];
const proofItems = evidence.filter((item) => proofIds.includes(item.id));

const audienceRoutes = en
  ? [
      ['Hospital leaders', 'Compare the two confirmed hospital integration paths and the responsibilities that remain with each hospital.', `${prefix}/deployments/`, 'Review deployments'],
      ['Hospital IT teams', 'Review ingestion options, FHIR components, access checks, and the hospital-side architecture.', `${prefix}/interoperability/`, 'Open the technical overview'],
      ['Public-sector and university partners', 'Check externally sourced programme, sandbox, award, and collaboration records.', `${prefix}/evidence/`, 'Review evidence'],
      ['Patients and general visitors', 'See how authorized records can appear in a Personal Health Record.', `${prefix}/phr/`, 'Explore PHR'],
    ]
  : [
      ['ผู้บริหารโรงพยาบาล', 'เปรียบเทียบแนวทางเชื่อมระบบของโรงพยาบาลสองแห่ง และดูหน้าที่ที่ยังอยู่กับแต่ละโรงพยาบาล', `${prefix}/deployments/`, 'ดูการใช้งานจริง'],
      ['ทีม IT โรงพยาบาล', 'ดูวิธีนำข้อมูลเข้า องค์ประกอบ FHIR การตรวจสิทธิ์ และขอบเขตทางเทคนิคของระบบปัจจุบัน', `${prefix}/interoperability/`, 'ดูรายละเอียดทางเทคนิค'],
      ['หน่วยงานภาครัฐและมหาวิทยาลัย', 'ตรวจสอบข้อมูลโครงการ sandbox รางวัล และความร่วมมือจากแหล่งภายนอก', `${prefix}/evidence/`, 'ดูหลักฐาน'],
      ['ผู้ป่วยและผู้สนใจทั่วไป', 'ดูวิธีที่เวชระเบียนตามสิทธิ์ปรากฏในสมุดสุขภาพส่วนบุคคล', `${prefix}/phr/`, 'ดู PHR'],
    ];
---

<Base
  locale={locale}
  path="platform"
  title={en ? 'Health data platform | HealthTAG' : 'แพลตฟอร์มข้อมูลสุขภาพ | HealthTAG'}
  description={en
    ? 'An overview of HealthTAG data interoperability, identity linkage, authorization, audit, and the responsibilities of patients and hospitals.'
    : 'ภาพรวมการเชื่อมโยงข้อมูล การเชื่อมตัวตน การอนุญาตสิทธิ์ การตรวจสอบย้อนหลัง และหน้าที่ของผู้ป่วยกับโรงพยาบาลในระบบ HealthTAG'}
>
  <main>
    <section id="overview" class="page-hero platform-hero" aria-labelledby="platform-heading">
      <div class="container hero-layout">
        <div>
          <div class="eyebrow">HealthTAG / {en ? 'Platform' : 'แพลตฟอร์ม'}</div>
          <h1 id="platform-heading">{en ? 'Connect health data while hospitals keep the clinical records' : 'เชื่อมข้อมูลสุขภาพ โดยเวชระเบียนยังอยู่กับโรงพยาบาล'}</h1>
          <p>{en
            ? 'HealthTAG connects existing hospital systems through HL7 FHIR R4, links patient identities, checks access, and records consent and access events. Patients own their health data. Hospitals continue to store and steward clinical records in their source systems.'
            : 'HealthTAG เชื่อมระบบเดิมของโรงพยาบาลด้วย HL7 FHIR R4 เชื่อมตัวตนผู้ป่วย ตรวจสิทธิ์ และบันทึกเหตุการณ์ความยินยอมกับการเข้าถึง ข้อมูลสุขภาพเป็นของผู้ป่วย ส่วนโรงพยาบาลยังจัดเก็บและดูแลเวชระเบียนในระบบต้นทาง'}</p>
          <div class="actions">
            <a class="btn primary" href={`${prefix}/how-it-works/`}>{en ? 'See how it works' : 'ดูขั้นตอนการทำงาน'}</a>
            <a class="btn secondary" href={`${prefix}/contact/`}>{en ? 'Talk to HealthTAG' : 'คุยกับ HealthTAG'}</a>
          </div>
        </div>
        <aside class="platform-register" aria-label={en ? 'Platform boundary summary' : 'สรุปขอบเขตแพลตฟอร์ม'}>
          <span class="mono">HEALTHTAG CONNECT</span>
          <dl>
            <div><dt>{en ? 'Records' : 'เวชระเบียน'}</dt><dd>{en ? 'Stay in hospital source systems' : 'อยู่ในระบบต้นทางของโรงพยาบาล'}</dd></div>
            <div><dt>{en ? 'Exchange' : 'การแลกเปลี่ยน'}</dt><dd>{en ? 'Uses HL7 FHIR R4' : 'ใช้ HL7 FHIR R4'}</dd></div>
            <div><dt>{en ? 'Audit' : 'การตรวจสอบ'}</dt><dd>{en ? 'Records consent and access events' : 'บันทึกเหตุการณ์ความยินยอมและการเข้าถึง'}</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    <nav class="page-index" aria-label={en ? 'On this page' : 'สารบัญหน้านี้'}>
      <div class="container">
        <span class="mono">{en ? 'ON THIS PAGE' : 'สารบัญ'}</span>
        <ul role="list">
          {localLinks.map(([href, label], index) => <li><a href={href}><span>0{index + 1}</span>{label}</a></li>)}
        </ul>
      </div>
    </nav>

    <section id="capabilities" class="section capabilities" aria-labelledby="capabilities-heading">
      <div class="container">
        <div class="section-head">
          <h2 id="capabilities-heading">{en ? 'Data, identity, access, and audit are handled separately' : 'ข้อมูล ตัวตน สิทธิ์เข้าถึง และประวัติตรวจสอบแยกจากกัน'}</h2>
          <p>{en
            ? 'Hospital systems retain the clinical records. An identity linkage service connects patient identifiers, an authorization service checks access requests, and blockchain records consent and access events.'
            : 'ระบบโรงพยาบาลยังเก็บเวชระเบียน บริการเชื่อมตัวตนจับคู่รหัสผู้ป่วย บริการตรวจสิทธิ์ประเมินคำขอเข้าถึง และ blockchain บันทึกเหตุการณ์ความยินยอมกับการเข้าถึง'}</p>
        </div>
        <ol class="capability-list">
          {capabilities.map((capability, index) => (
            <li>
              <span class="capability-number">0{index + 1}</span>
              <div>
                <h3>{capability.name}</h3>
                <p>{capability.body}</p>
              </div>
              <a href={capability.href}>{capability.link} <span aria-hidden="true">→</span></a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="operating-model" class="section operating-section" aria-labelledby="operating-heading">
      <div class="container operating-layout">
        <div class="operating-copy">
          <span class="mono">{en ? 'RESPONSIBILITY FIRST' : 'เริ่มจากหน้าที่'}</span>
          <h2 id="operating-heading">{en ? 'Patients retain ownership while hospitals retain the records' : 'ผู้ป่วยยังเป็นเจ้าของข้อมูล ส่วนโรงพยาบาลยังดูแลเวชระเบียน'}</h2>
          <p>{en
            ? 'This conceptual diagram describes responsibility boundaries. It does not prescribe the physical request sequence of every installation.'
            : 'แผนภาพนี้อธิบายขอบเขตความรับผิดชอบในเชิงแนวคิด ไม่ได้กำหนดลำดับคำขอทางเทคนิคของทุกการติดตั้ง'}</p>
        </div>
        <figure class="responsibility-figure" aria-labelledby="responsibility-caption">
          <div class="responsibility-visual" aria-hidden="true">
            <div class="responsibility-row patient-row">
              <span class="role-index">01</span>
              <strong>{en ? 'Patient' : 'ผู้ป่วย'}</strong>
              <p>{en ? 'Owns health data and controls consent and use' : 'เป็นเจ้าของข้อมูลสุขภาพและกำหนดความยินยอมกับการใช้ข้อมูล'}</p>
            </div>
            <div class="responsibility-row hospital-row">
              <span class="role-index">02</span>
              <strong>{en ? 'Hospital' : 'โรงพยาบาล'}</strong>
              <p>{en ? 'Stores and stewards the clinical record in source systems' : 'จัดเก็บและดูแลเวชระเบียนในระบบต้นทาง'}</p>
            </div>
            <div class="responsibility-row healthtag-row">
              <span class="role-index">03</span>
              <strong>HealthTAG</strong>
              <p>{en ? 'Provides identity, authorization, trusted exchange, and audit infrastructure' : 'จัดเตรียมโครงสร้างพื้นฐานด้านตัวตน การอนุญาต การแลกเปลี่ยนตามสิทธิ์ และการตรวจสอบ'}</p>
            </div>
            <div class="diagram-boundary">
              <span>{en ? 'Clinical records stay at source' : 'เวชระเบียนอยู่ที่ต้นทาง'}</span>
              <span>{en ? 'Blockchain records events, not records' : 'Blockchain บันทึกเหตุการณ์ ไม่ได้เก็บเวชระเบียน'}</span>
            </div>
          </div>
          <figcaption id="responsibility-caption">{en ? 'Conceptual responsibility model for authorized health-data exchange.' : 'แบบจำลองหน้าที่ในการแลกเปลี่ยนข้อมูลสุขภาพตามสิทธิ์'}</figcaption>
          <details class="diagram-transcript">
            <summary>{en ? 'Read the diagram as text' : 'อ่านคำอธิบายแผนภาพ'}</summary>
            <ol>
              <li>{en ? 'The patient owns their health data and controls consent and use.' : 'ผู้ป่วยเป็นเจ้าของข้อมูลสุขภาพและกำหนดความยินยอมกับการใช้ข้อมูล'}</li>
              <li>{en ? 'The hospital stores and stewards the clinical record in its source systems.' : 'โรงพยาบาลจัดเก็บและดูแลเวชระเบียนในระบบต้นทางของตน'}</li>
              <li>{en ? 'HealthTAG supplies infrastructure for identity linkage, authorization, permitted exchange, and audit.' : 'HealthTAG จัดเตรียมโครงสร้างพื้นฐานสำหรับเชื่อมตัวตน อนุญาตสิทธิ์ แลกเปลี่ยนข้อมูลตามสิทธิ์ และตรวจสอบย้อนหลัง'}</li>
              <li>{en ? 'Clinical records do not pass through blockchain. Blockchain records consent and access events.' : 'เวชระเบียนไม่ได้ไหลผ่าน blockchain โดย blockchain บันทึกเฉพาะเหตุการณ์ความยินยอมและการเข้าถึง'}</li>
            </ol>
          </details>
        </figure>
      </div>
    </section>

    <section id="hospital-leaders" class="section leader-section" aria-labelledby="leaders-heading">
      <div class="container decision-layout">
        <div>
          <span class="mono">{en ? 'FOR HOSPITAL LEADERS' : 'สำหรับผู้บริหารโรงพยาบาล'}</span>
          <h2 id="leaders-heading">{en ? 'Connect without replacing the core HIS' : 'เชื่อมระบบโดยไม่ต้องเปลี่ยน HIS หลัก'}</h2>
        </div>
        <div class="decision-copy">
          <p>{en
            ? 'The hospital keeps custody of its records and chooses the ingestion path that fits its IT capability. Siriraj uses a hospital-developed script. Khian Sa uses HealthTAG FHIR Transformer for four confirmed FHIR resources.'
            : 'โรงพยาบาลยังดูแลเวชระเบียนและเลือกวิธีนำข้อมูลเข้าที่เหมาะกับทีม IT ของตน ศิริราชใช้สคริปต์ที่ทีมโรงพยาบาลพัฒนาเอง ส่วนเคียนซาใช้ HealthTAG FHIR Transformer สำหรับ FHIR resources ที่ยืนยันแล้ว 4 ประเภท'}</p>
          <div class="actions">
            <a class="btn primary" href={`${prefix}/deployments/`}>{en ? 'Compare deployments' : 'เปรียบเทียบการใช้งานจริง'}</a>
            <a class="btn secondary" href={`${prefix}/contact/`}>{en ? 'Discuss an integration' : 'ปรึกษาการเชื่อมต่อ'}</a>
          </div>
        </div>
      </div>
    </section>

    <section id="it-teams" class="section it-section" aria-labelledby="it-heading">
      <div class="container it-layout">
        <div>
          <span class="mono">{en ? 'FOR IT TEAMS' : 'สำหรับทีม IT'}</span>
          <h2 id="it-heading">{en ? 'Two ingestion paths support different hospital IT models' : 'สองวิธีนำข้อมูลเข้า รองรับรูปแบบทีม IT ที่ต่างกัน'}</h2>
          <p>{en
            ? 'A hospital may use an IT-managed script or HealthTAG FHIR Transformer. The current hospital-side architecture separates FHIR storage, API protection, identity linkage, and authorization.'
            : 'โรงพยาบาลเลือกใช้สคริปต์ที่ทีม IT ดูแลเองหรือ HealthTAG FHIR Transformer ได้ สถาปัตยกรรมฝั่งโรงพยาบาลปัจจุบันแยกการจัดเก็บ FHIR การปกป้อง API การเชื่อมตัวตน และการอนุญาตสิทธิ์ออกจากกัน'}</p>
        </div>
        <details class="it-detail">
          <summary>{en ? 'Technical boundary and current implementation' : 'ขอบเขตทางเทคนิคและการทำงานปัจจุบัน'}</summary>
          <div class="it-detail-body">
            <dl>
              <div><dt>{en ? 'Ingestion' : 'การนำข้อมูลเข้า'}</dt><dd>{en ? 'Hospital IT script or HealthTAG FHIR Transformer.' : 'สคริปต์ของทีม IT โรงพยาบาล หรือ HealthTAG FHIR Transformer'}</dd></div>
              <div><dt>{en ? 'FHIR system' : 'ระบบ FHIR'}</dt><dd>{en ? 'FHIR Server using HL7 FHIR R4, backed by a relational database and protected by an API Gateway.' : 'FHIR Server บน HL7 FHIR R4 ใช้ relational database จัดเก็บข้อมูลและมี API Gateway ปกป้องการเข้าถึง'}</dd></div>
              <div><dt>{en ? 'Access check' : 'การตรวจสิทธิ์'}</dt><dd>{en ? 'Identity and authorization services link patient identifiers and check the current access window inside the hospital network.' : 'บริการเชื่อมตัวตนและตรวจสิทธิ์จับคู่รหัสผู้ป่วยและตรวจช่วงเวลาการเข้าถึงภายในเครือข่ายโรงพยาบาล'}</dd></div>
            </dl>
            <div class="technical-links">
              <a href={`${prefix}/interoperability/`}>{en ? 'Interoperability components' : 'องค์ประกอบการเชื่อมโยงข้อมูล'} <span aria-hidden="true">→</span></a>
              <a href={`${prefix}/how-it-works/`}>{en ? 'Conceptual exchange flow' : 'ลำดับการแลกเปลี่ยนเชิงแนวคิด'} <span aria-hidden="true">→</span></a>
              <a href={`${prefix}/contact/`}>{en ? 'Request technical architecture access' : 'ขอสิทธิ์เข้าถึงเอกสารสถาปัตยกรรม'} <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </details>
      </div>
    </section>

    <section class="section audience-section" aria-labelledby="audience-heading">
      <div class="container">
        <div class="section-head">
          <h2 id="audience-heading">{en ? 'Choose a starting point' : 'เลือกข้อมูลที่ต้องการดู'}</h2>
          <p>{en ? 'Compare deployments, inspect technical components, check published records, or see the PHR.' : 'เปรียบเทียบการติดตั้ง ดูองค์ประกอบทางเทคนิค ตรวจข้อมูลที่เผยแพร่ หรือดู PHR'}</p>
        </div>
        <ul class="audience-list" role="list">
          {audienceRoutes.map(([title, body, href, link], index) => (
            <li>
              <span class="route-number">0{index + 1}</span>
              <div><h3>{title}</h3><p>{body}</p></div>
              <a href={href}>{link} <span aria-hidden="true">→</span></a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="evidence" class="section proof-section" aria-labelledby="evidence-heading">
      <div class="container">
        <div class="section-head">
          <h2 id="evidence-heading">{en ? 'Siriraj, ETDA, and APICTA have published records related to HealthTAG' : 'ศิริราช ETDA และ APICTA เผยแพร่ข้อมูลที่เกี่ยวข้องกับ HealthTAG'}</h2>
          <p>{en
            ? 'Siriraj published the 5G Smart Hospital programme, ETDA recorded HealthTAG\'s Digital Service Sandbox participation, and APICTA named Healthtag as the 2022 Cross Category: Start-Up winner.'
            : 'ศิริราชเผยแพร่โครงการ 5G Smart Hospital, ETDA บันทึกการเข้าร่วม Digital Service Sandbox ของ HealthTAG และ APICTA ระบุ Healthtag เป็นผู้ชนะ Cross Category: Start-Up ประจำปี 2022'}</p>
