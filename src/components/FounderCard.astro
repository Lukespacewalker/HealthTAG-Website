---
import { Image } from 'astro:assets';
import { portraits } from '../data/team-portraits';
import type { Locale } from '../data/site-content';
interface Props { locale: Locale; variant?: 'profile' | 'portrait' }
const { locale, variant = 'profile' } = Astro.props;
const en = locale === 'en';
const name = en ? 'Dechowat Promda, M.D.' : 'นพ.เดโชวัต พรมดา';
const credentials = en
  ? [
      'Practicing physician',
      'Adjunct lecturer in digital health at KMITL and Khon Kaen University',
      'Guest lecturer, Faculty of Medicine, Chulalongkorn University',
      'TEDx speaker, TEDxSirirajFacultyOfMedicine',
    ]
  : [
      'แพทย์ผู้ยังปฏิบัติงานทางคลินิก',
      'อาจารย์พิเศษด้านสุขภาพดิจิทัลที่ สจล. และมหาวิทยาลัยขอนแก่น',
      'วิทยากรรับเชิญ คณะแพทยศาสตร์ จุฬาลงกรณ์มหาวิทยาลัย',
      'วิทยากร TEDxSirirajFacultyOfMedicine',
    ];
---
<article class:list={['founder-panel', variant]}>
  <div class="founder-photo"><Image src={portraits.dechowat} alt={name} width={320} widths={[200, 320, 480]} sizes="(max-width: 600px) 180px, 240px" format="webp" quality={90} loading="lazy" decoding="async" /></div>
  <div class="founder-caption">
    <div class="kicker">{en ? 'Founder' : 'ผู้ก่อตั้ง'}</div>
    <h3>{name}</h3>
    <p class="founder-role">{en ? 'Founder & CEO, HealthTAG' : 'ผู้ก่อตั้งและประธานเจ้าหน้าที่บริหาร HealthTAG'}</p>
    {variant === 'profile' && <ul>{credentials.map((credential) => <li>{credential}</li>)}</ul>}
    {variant === 'profile' && <a class="btn secondary" href={en ? '/en/company/#founder' : '/company/#founder'}>{en ? 'Company & founder' : 'บริษัทและผู้ก่อตั้ง'}</a>}
  </div>
</article>
<style>
  .founder-panel { min-width: 0; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: var(--white); }
  .founder-photo { display: flex; justify-content: center; height: 240px; padding: 16px 20px 0; background: var(--mint); }
  .founder-photo img { width: auto; max-width: 100%; height: 100%; object-fit: contain; object-position: center bottom; }
  .founder-caption { padding: 24px; }
  .kicker { color: var(--teal); font-size: .8rem; letter-spacing: .08em; }
  h3 { margin: 10px 0 2px; font-size: 1.5rem; line-height: 1.5; }
  .founder-role { color: var(--ink); margin: 0; font-weight: 600; }
  ul { display: grid; gap: 8px; margin: 18px 0 22px; padding: 16px 0 0; border-top: 1px solid var(--line); list-style: none; }
  li { position: relative; padding-left: 16px; color: var(--muted); font-size: .86rem; line-height: 1.55; }
  li::before { content: ''; position: absolute; top: .68em; left: 0; width: 6px; height: 1px; background: var(--teal); }
  .portrait .founder-caption { padding-bottom: 26px; }
  @media (max-width: 600px) { .founder-photo { height: 220px; } }
</style>
