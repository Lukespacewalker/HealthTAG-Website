---
interface Props { locale: 'th' | 'en' }

const { locale } = Astro.props;
const isEn = locale === 'en';
const labels = isEn
  ? { control: 'Appearance', auto: 'Auto', light: 'Light', dark: 'Dark' }
  : { control: 'รูปแบบการแสดงผล', auto: 'อัตโนมัติ', light: 'สว่าง', dark: 'มืด' };
---

<!-- Contract companion: health-tag-document/src/components/manual/ThemeMenu.astro and src/scripts/manual.ts. -->
<details data-theme-control data-theme-label={labels.control} data-theme-auto={labels.auto} data-theme-light={labels.light} data-theme-dark={labels.dark} hidden>
  <summary data-theme-trigger aria-label={`${labels.control}: ${labels.auto}`}>
    <span aria-hidden="true">◐</span>
    <span data-theme-trigger-label>{labels.auto}</span>
  </summary>
  <div data-theme-menu role="group" aria-label={labels.control}>
    <button type="button" data-theme-option="auto" aria-pressed="true"><span aria-hidden="true">◐</span>{labels.auto}</button>
    <button type="button" data-theme-option="light" aria-pressed="false"><span aria-hidden="true">☼</span>{labels.light}</button>
    <button type="button" data-theme-option="dark" aria-pressed="false"><span aria-hidden="true">☾</span>{labels.dark}</button>
  </div>
</details>
