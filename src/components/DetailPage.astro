---
import Base from '../layouts/Base.astro';
import PartnerNetwork from './PartnerNetwork.astro';
import { pageContent } from '../data/site-content';
import InteroperabilityPage from './deep-pages/InteroperabilityPage.astro';
import HowItWorksPage from './deep-pages/HowItWorksPage.astro';
import TrustPage from './deep-pages/TrustPage.astro';
import DeploymentsPage from './deep-pages/DeploymentsPage.astro';
import CompanyPage from './deep-pages/CompanyPage.astro';
import PhrPage from './deep-pages/PhrPage.astro';
interface Props { locale: 'th' | 'en'; slug: string }
const { locale, slug } = Astro.props;
const en = locale === 'en';
const d = pageContent[slug]?.[locale] ?? { label: 'HealthTAG', title: en ? 'Healthcare interoperability infrastructure' : 'โครงสร้างพื้นฐานเชื่อมโยงข้อมูลสุขภาพ', intro: '', sections: [] };
---
{slug === 'interoperability' && <InteroperabilityPage locale={locale} />}
{slug === 'how-it-works' && <HowItWorksPage locale={locale} />}
{slug === 'trust' && <TrustPage locale={locale} />}
{slug === 'deployments' && <DeploymentsPage locale={locale} />}
{slug === 'company' && <CompanyPage locale={locale} />}
{slug === 'phr' && <PhrPage locale={locale} />}
{!['interoperability', 'how-it-works', 'trust', 'deployments', 'company', 'phr'].includes(slug) &&
<Base locale={locale} path={slug} title={`${d.label} | HealthTAG`} description={d.intro}>
  <main>
    <section class="page-hero">
      <div class="container">
        <div class="eyebrow">HealthTAG / {d.label}</div>
        <h1>{d.title}</h1><p>{d.intro}</p>
      </div>
    </section>
    {d.sections.length > 0 && <section class="section">
      <div class="container detail-layout"><div class="prose">
        {d.sections.map((section) => <section class="detail-section"><h2>{section.heading}</h2><p>{section.body}</p></section>)}
        {slug === 'interoperability' && <div class="resource-list"><span class="chip">FHIR Server</span><span class="chip">FHIR R4</span><span class="chip">Relational database</span><span class="chip">API Gateway</span><span class="chip">Authorization service</span></div>}
      </div></div>
    </section>}
    {slug === 'network' && <PartnerNetwork locale={locale} />}
  </main>
</Base>
<style>
  .page-hero h1 { overflow-wrap: anywhere; }
</style>
}
