---
import Base from '../layouts/Base.astro';
import PartnerNetwork from './PartnerNetwork.astro';
import { pageContent } from '../data/site-content';
import InteroperabilityPage from './deep-pages/InteroperabilityPage.astro';
import HowItWorksPage from './deep-pages/HowItWorksPage.astro';
import TrustPage from './deep-pages/TrustPage.astro';
import DeploymentsPage from './deep-pages/DeploymentsPage.astro';
import CompanyPage from './deep-pages/CompanyPage.astro';
interface Props { locale: 'th' | 'en'; slug: string }
const { locale, slug } = Astro.props;
const en = locale === 'en';
const d = pageContent[slug]?.[locale] ?? { label: 'HealthTAG', title: en ? 'Healthcare interoperability infrastructure' : 'โครงสร้างพื้นฐานเชื่อมโยงข้อมูลสุขภาพ', intro: '', sections: [] };
---
{slug === 'interoperability' && <InteroperabilityPage locale={locale} />}
{slug === 'how-it-works' && <HowItWorksPage locale={locale} />}
{slug === 'trust' && <TrustPage locale={locale} />}
{slug === 'deployments' && <DeploymentsPage locale={locale} />}
{slug === 'company' && <CompanyPage locale={locale} />}
{!['interoperability', 'how-it-works', 'trust', 'deployments', 'company'].includes(slug) &&
<Base locale={locale} path={slug} title={`${d.label} | HealthTAG`} description={d.intro}>
  <main>
    <section class="page-hero">
      <div class="container">
        <div class="eyebrow">HealthTAG / {d.label}</div>
        <h1>{d.title}</h1><p>{d.intro}</p>
      </div>
    </section>
    {d.sections.length > 0 && <section class="section">
      <div class="container detail-layout"><div class="prose">
        {d.sections.map((section) => <section class="detail-section"><h2>{section.heading}</h2><p>{section.body}</p></section>)}
        {slug === 'interoperability' && <div class="resource-list"><span class="chip">HAPI FHIR</span><span class="chip">FHIR R4</span><span class="chip">PostgreSQL</span><span class="chip">Kong</span><span class="chip">Hospital API</span></div>}
      </div></div>
    </section>}
    {slug === 'phr' && <section class="section product-story">
      <div class="container product-story-grid">
        <div>
          <div class="eyebrow">{en ? 'Product proof' : 'ตัวอย่างผลิตภัณฑ์'}</div>
          <h2>{en ? 'A patient-facing view of authorized records.' : 'มุมมองข้อมูลที่ผู้ป่วยได้รับสิทธิ์เข้าถึง'}</h2>
          <p>{en ? 'This illustrative interface uses synthetic data. It is not a current-product screenshot or evidence of production exchange between named hospitals.' : 'หน้าจอนี้เป็นภาพประกอบที่ใช้ข้อมูลสังเคราะห์ ไม่ใช่ภาพหน้าจอผลิตภัณฑ์ปัจจุบันหรือหลักฐานการแลกเปลี่ยนข้อมูลจริงระหว่างโรงพยาบาลที่ระบุชื่อ'}</p>
          <a class="btn secondary" href="https://phr.healthtag.io" target="_blank" rel="noopener noreferrer" aria-label={en ? 'Open the HealthTAG PHR website in a new tab' : 'เปิดเว็บไซต์ HealthTAG PHR ในแท็บใหม่'}>{en ? 'Open PHR website' : 'เปิดเว็บไซต์ PHR'} ↗</a>
        </div>
        <div class="phr-window">
          <div class="phr-bar"><span></span><strong>{en ? 'Illustrative interface · synthetic data' : 'ภาพประกอบ · ข้อมูลสังเคราะห์'}</strong></div>
          <div class="phr-profile"><div class="avatar">PT</div><div><strong>PromptCare ID · PC-02814</strong><small>{en ? 'Illustrative providers: 2' : 'ผู้ให้บริการในภาพประกอบ: 2'}</small></div><span class="access-live">{en ? 'Access window · 15 minutes' : 'ช่วงเวลาการเข้าถึง · 15 นาที'}</span></div>
          <div class="phr-record"><time>12 AUG</time><div><strong>{en ? 'Outpatient encounter' : 'การรับบริการผู้ป่วยนอก'}</strong><small>{en ? 'Provider A' : 'ผู้ให้บริการ A'} · Encounter</small></div></div>
          <div class="phr-record"><time>04 JUL</time><div><strong>Amoxicillin</strong><small>{en ? 'Provider B' : 'ผู้ให้บริการ B'} · MedicationDispense</small></div></div>
        </div>
      </div>
    </section>}
    {slug === 'network' && <PartnerNetwork locale={locale} />}
  </main>
</Base>
<style>
  .page-hero h1 { overflow-wrap: anywhere; }
</style>
}
