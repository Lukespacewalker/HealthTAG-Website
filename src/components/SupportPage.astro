---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import currentReaderImage from '../assets/legacy/support/healthtag-card-reader.png';
import legacyReaderImage from '../assets/legacy/support/healthtag-nfc-reader-legacy.jpg';
import adr12Image from '../assets/support/silicon-craft-adr12-cutout.png';

interface Props { locale: 'th' | 'en' }
const { locale } = Astro.props;
const en = locale === 'en';
const prefix = en ? '/en' : '';

const links = {
  currentReader: 'https://software.healthtag.io/healthtag-reader/',
  driver: 'https://software.healthtag.io/nfc-scanner-driver/CH341SER-3.7.ZIP',
  legacyReader: 'https://software.healthtag.io/nfc-scanner-windows/',
  legacyWindows7: 'https://software.healthtag.io/nfc-scanner-legacy-windows-7/',
  android: 'https://healthtagdecentralizedhealth.sharepoint.com/:f:/s/teams/EiUmscZ56XNPtjZ650ue6iYBxlQjCUWN5h6mK0Y0dAuWPA?e=9PJioj',
};
---

<Base
  locale={locale}
  path="support"
  title={en ? 'Support | HealthTAG reader downloads and setup' : 'ศูนย์ช่วยเหลือ | ดาวน์โหลดและตั้งค่าเครื่องอ่าน HealthTAG'}
  description={en ? 'Set up HealthTAG readers and open the latest available Community Edition open-source manual.' : 'ตั้งค่าเครื่องอ่าน HealthTAG และเปิดคู่มือล่าสุดที่มีสำหรับ Community Edition แบบ open source'}
>
  <main>
    <section class="page-hero support-hero">
      <div class="container support-hero-grid">
        <div>
          <div class="eyebrow">HealthTAG / {en ? 'Support' : 'ศูนย์ช่วยเหลือ'}</div>
          <h1>{en ? 'Set up your HealthTAG reader.' : 'ตั้งค่าเครื่องอ่าน HealthTAG'}</h1>
          <p>{en ? 'Start with the Silicon Craft ADR12 driver, then install the reader program that matches your device.' : 'เริ่มจาก Driver ของ Silicon Craft ADR12 แล้วติดตั้งโปรแกรมให้ตรงกับอุปกรณ์ที่ใช้งาน'}</p>
          <div class="actions">
            <a class="btn primary" href="#recommended">{en ? 'Recommended setup' : 'ดูวิธีติดตั้งที่แนะนำ'}</a>
            <a class="btn secondary" href="#legacy">{en ? 'Legacy program' : 'โปรแกรม Legacy'}</a>
          </div>
        </div>
        <figure class="device-figure">
          <Image
            src={adr12Image}
            alt={en ? 'Front of the Silicon Craft ADR12 NFC reader' : 'ด้านหน้าของเครื่องอ่าน NFC รุ่น Silicon Craft ADR12'}
            widths={[480, 720, 960]}
            width={960}
            sizes="(max-width: 900px) 100vw, 42vw"
            loading="eager"
          />
          <figcaption><span>01</span> Silicon Craft ADR12</figcaption>
        </figure>
      </div>
    </section>

    <section class="setup-index" aria-labelledby="setup-index-heading">
      <div class="container setup-index-grid">
        <h2 id="setup-index-heading">{en ? 'Choose your setup' : 'เลือกชุดติดตั้ง'}</h2>
        <div class="setup-paths">
          <a href="#recommended">
            <span class="path-code">WIN / CURRENT</span>
            <strong>{en ? 'Windows 10 or 11' : 'Windows 10 หรือ 11'}</strong>
            <small>{en ? 'ADR12 or smart card reader' : 'ADR12 หรือเครื่องอ่าน Smartcard'}</small>
          </a>
          <a href="#android">
            <span class="path-code">ANDROID</span>
            <strong>{en ? 'Android 9 or newer' : 'Android 9 ขึ้นไป'}</strong>
            <small>Silicon Craft ADR12</small>
          </a>
          <a href="#community-edition">
            <span class="path-code community-code">OPEN SOURCE</span>
            <strong>Community Edition</strong>
            <small>{en ? 'Installation and usage manual' : 'คู่มือติดตั้งและใช้งาน'}</small>
          </a>
          <a href="#legacy">
            <span class="path-code legacy-code">LEGACY</span>
            <strong>{en ? 'Older HealthTAG reader' : 'โปรแกรม HealthTAG รุ่นเดิม'}</strong>
            <small>{en ? 'Use only when required' : 'ใช้เมื่อจำเป็นเท่านั้น'}</small>
          </a>
        </div>
      </div>
    </section>

    <section class="section recommended" id="recommended">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="sequence">01 / {en ? 'Recommended' : 'แนะนำ'}</span>
            <h2>{en ? 'Windows setup for ADR12' : 'ติดตั้งบน Windows สำหรับ ADR12'}</h2>
          </div>
          <p>{en ? 'Install Driver 3.7 before connecting the reader program. Driver 3.8 still has a connection problem with Silicon Craft ADR12.' : 'ติดตั้ง Driver 3.7 ก่อนเชื่อมต่อโปรแกรมเครื่องอ่าน เนื่องจาก Driver 3.8 ยังมีปัญหาการเชื่อมต่อกับ Silicon Craft ADR12'}</p>
        </div>

        <div class="driver-notice">
          <div class="driver-mark" aria-hidden="true">3.7</div>
          <div>
            <span class="notice-label">{en ? 'Required for ADR12' : 'ต้องใช้กับ ADR12'}</span>
            <h3>{en ? 'Silicon Craft ADR12 Driver' : 'Driver สำหรับ Silicon Craft ADR12'}</h3>
            <p>{en ? 'For Windows 7, 8, 8.1, 10, and 11 on x86, x64, or ARM64.' : 'รองรับ Windows 7, 8, 8.1, 10 และ 11 บน x86, x64 หรือ ARM64'}</p>
          </div>
          <a class="btn primary" href={links.driver}>{en ? 'Download Driver 3.7' : 'ดาวน์โหลด Driver 3.7'}</a>
        </div>

        <article class="program-spread">
          <div class="program-copy">
            <span class="status-badge">{en ? 'Recommended' : 'แนะนำ'}</span>
            <h3>HealthTAG NFC &amp; Smartcard Reader</h3>
            <p>{en ? 'Use this program with Silicon Craft ADR12 and a smart card reader. It supports Windows 10 build 17763 or newer and Windows 11 on x86, x64, or ARM64.' : 'ใช้โปรแกรมนี้กับ Silicon Craft ADR12 และเครื่องอ่าน Smartcard รองรับ Windows 10 Build 17763 ขึ้นไปและ Windows 11 บน x86, x64 หรือ ARM64'}</p>
            <dl class="program-specs">
              <div><dt>{en ? 'Current version' : 'เวอร์ชันปัจจุบัน'}</dt><dd>1.2.7.0</dd></div>
              <div><dt>{en ? 'Download host' : 'เว็บไซต์ดาวน์โหลด'}</dt><dd>software.healthtag.io</dd></div>
            </dl>
            <a class="btn primary" href={links.currentReader}>{en ? 'Open installer page' : 'เปิดหน้าติดตั้งโปรแกรม'}</a>
          </div>
          <figure class="app-shot">
            <Image
              src={currentReaderImage}
              alt={en ? 'HealthTAG Card Reader screen with smart card and NFC tag reader options' : 'หน้าจอ HealthTAG Card Reader ที่มีตัวเลือกเครื่องอ่าน Smartcard และ NFC tag'}
              widths={[640, 960, 1280]}
              width={1280}
              sizes="(max-width: 900px) 100vw, 48vw"
            />
            <figcaption>{en ? 'The recommended HealthTAG Card Reader interface' : 'หน้าจอ HealthTAG Card Reader ที่แนะนำให้ใช้'}</figcaption>
          </figure>
        </article>

        <ol class="install-steps" aria-label={en ? 'Installation sequence' : 'ลำดับการติดตั้ง'}>
          <li><span>01</span><div><strong>{en ? 'Check the reader' : 'ตรวจสอบเครื่องอ่าน'}</strong><p>{en ? 'Confirm that the device is a Silicon Craft ADR12.' : 'ตรวจสอบว่าอุปกรณ์เป็น Silicon Craft ADR12'}</p></div></li>
          <li><span>02</span><div><strong>{en ? 'Install Driver 3.7' : 'ติดตั้ง Driver 3.7'}</strong><p>{en ? 'Use the download above. Driver 3.8 has a known ADR12 connection problem.' : 'ใช้ไฟล์ดาวน์โหลดด้านบน เพราะ Driver 3.8 มีปัญหาการเชื่อมต่อกับ ADR12'}</p></div></li>
          <li><span>03</span><div><strong>{en ? 'Install HealthTAG Reader' : 'ติดตั้ง HealthTAG Reader'}</strong><p>{en ? 'Open the installer page and choose Get the app.' : 'เปิดหน้าติดตั้งแล้วเลือก Get the app'}</p></div></li>
          <li><span>04</span><div><strong>{en ? 'Connect and check' : 'เชื่อมต่อและตรวจสอบ'}</strong><p>{en ? 'Open the program and confirm that the reader appears before using an NFC tag or smart card.' : 'เปิดโปรแกรมและตรวจสอบว่าโปรแกรมพบเครื่องอ่านก่อนใช้ NFC tag หรือ Smartcard'}</p></div></li>
        </ol>
      </div>
    </section>

    <section class="section android-section" id="android">
      <div class="container android-grid">
        <div>
          <span class="sequence">02 / Android</span>
          <h2>{en ? 'ADR12 on Android' : 'ใช้ ADR12 บน Android'}</h2>
        </div>
        <div class="android-copy">
          <h3>ZeeSpeed Serial</h3>
          <p>{en ? 'Use ZeeSpeed Serial to connect Silicon Craft ADR12 to a device running Android 9 or newer. The download opens a HealthTAG SharePoint folder.' : 'ใช้ ZeeSpeed Serial เพื่อเชื่อมต่อ Silicon Craft ADR12 กับอุปกรณ์ Android 9 ขึ้นไป ลิงก์ดาวน์โหลดจะเปิดโฟลเดอร์ SharePoint ของ HealthTAG'}</p>
          <a class="btn secondary" href={links.android}>{en ? 'Open Android download' : 'เปิดไฟล์ดาวน์โหลด Android'}</a>
        </div>
      </div>
    </section>

    <section class="section community-section" id="community-edition">
      <div class="container">
        <div class="section-head community-head">
          <div>
            <span class="sequence">03 / Community Edition</span>
            <h2>{en ? 'Community Edition, open source' : 'Community Edition รุ่น open source'}</h2>
          </div>
          <p>{en ? 'Community Edition and Data Source Node are separate products. Their services, commands, and configuration files are not interchangeable.' : 'Community Edition และ Data Source Node เป็นคนละผลิตภัณฑ์ บริการ คำสั่ง และไฟล์ตั้งค่าของทั้งสองระบบใช้แทนกันไม่ได้'}</p>
        </div>

        <div class="community-product">
          <div class="community-copy">
            <span class="status-badge">{en ? 'Latest available manual' : 'คู่มือล่าสุดที่มี'}</span>
            <h3>Personal Health Record Community Edition</h3>
            <p>{en ? 'The open-source manual covers the Community Edition stack, Kong configuration, CSOP-to-FHIR processing, hospital administration, and the patient web application. The source manual is in Thai.' : 'คู่มือ open source ครอบคลุมการติดตั้งระบบ Community Edition, การตั้งค่า Kong, การแปลง CSOP เป็น FHIR, งานของผู้ดูแลระบบโรงพยาบาล และ web application สำหรับผู้ป่วย'}</p>
            <a class="btn primary" href={`${prefix}/support/community-edition/user-manual/`}>{en ? 'Open Community Edition manual' : 'เปิดคู่มือ Community Edition'}</a>
          </div>
          <div class="manual-scope">
            <span class="path-code">{en ? 'Manual sections' : 'เนื้อหาในคู่มือ'}</span>
            <ol>
              <li><span>01</span>{en ? 'HAPI FHIR Server and Docker' : 'HAPI FHIR Server และ Docker'}</li>
              <li><span>02</span>{en ? 'Kong API Gateway with Konga' : 'Kong API Gateway ด้วย Konga'}</li>
              <li><span>03</span>{en ? 'CSOP files and FHIR conversion' : 'ไฟล์ CSOP และการแปลงเป็น FHIR'}</li>
              <li><span>04</span>{en ? 'Hospital admin and patient web application' : 'ระบบผู้ดูแลโรงพยาบาลและ web application สำหรับผู้ป่วย'}</li>
            </ol>
            <div class="community-warning" role="note">
              <strong>{en ? 'Before installation' : 'ก่อนติดตั้ง'}</strong>
              <p>{en ? 'Example passwords and open ports come from the Community Edition manual. Use them only in an isolated test network and replace every credential before connecting a real system.' : 'รหัสผ่านและพอร์ตในตัวอย่างมาจากคู่มือ Community Edition ใช้เฉพาะในเครือข่ายทดสอบที่แยกจากระบบจริง และเปลี่ยน credential ทุกค่าก่อนเชื่อมต่อระบบจริง'}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section legacy-section" id="legacy">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="sequence legacy-sequence">04 / Legacy</span>
            <h2>{en ? 'Older HealthTAG NFC Reader' : 'HealthTAG NFC Reader รุ่นเดิม'}</h2>
          </div>
          <p>{en ? 'This program remains available for older installations. New installations should use HealthTAG NFC & Smartcard Reader above.' : 'โปรแกรมนี้มีไว้สำหรับระบบเดิม การติดตั้งใหม่ควรใช้ HealthTAG NFC & Smartcard Reader ด้านบน'}</p>
        </div>

        <details class="legacy-panel">
          <summary>
            <span>
              <small>{en ? 'Not recommended for new installations' : 'ไม่แนะนำสำหรับการติดตั้งใหม่'}</small>
              <strong>HealthTAG NFC Reader 1.4.5.0</strong>
            </span>
            <b aria-hidden="true">+</b>
          </summary>
          <div class="legacy-content">
            <div class="legacy-copy">
              <p>{en ? 'Use this program only when an existing installation requires it. The standard installer supports Windows 10 build 19041 or newer and Windows 11 on x86 or x64. Separate x86 and x64 installers remain available for Windows 7.' : 'ใช้โปรแกรมนี้เมื่อระบบเดิมจำเป็นต้องใช้เท่านั้น ตัวติดตั้งปกติรองรับ Windows 10 Build 19041 ขึ้นไปและ Windows 11 บน x86 หรือ x64 ส่วน Windows 7 มีตัวติดตั้ง x86 และ x64 แยกกัน'}</p>
              <div class="legacy-actions">
                <a class="btn secondary" href={links.legacyReader}>{en ? 'Open legacy installer' : 'เปิดตัวติดตั้ง Legacy'}</a>
                <a class="text-link" href={links.legacyWindows7}>{en ? 'Windows 7 files' : 'ไฟล์สำหรับ Windows 7'}</a>
              </div>
            </div>
            <figure>
              <Image
                src={legacyReaderImage}
                alt={en ? 'Legacy HealthTAG NFC Reader interface showing a connected USB serial device' : 'หน้าจอ HealthTAG NFC Reader รุ่นเดิมที่แสดงอุปกรณ์ USB serial เชื่อมต่ออยู่'}
                widths={[480, 720, 960]}
                width={960}
                sizes="(max-width: 800px) 100vw, 40vw"
              />
              <figcaption>{en ? 'Legacy HealthTAG NFC Reader interface' : 'หน้าจอ HealthTAG NFC Reader รุ่นเดิม'}</figcaption>
            </figure>
          </div>
        </details>
      </div>
    </section>

    <section class="section support-contact">
      <div class="container support-contact-grid">
        <div>
          <span class="sequence">{en ? 'Need help?' : 'ยังติดตั้งไม่ได้?'}</span>
          <h2>{en ? 'Contact HealthTAG support' : 'ติดต่อฝ่ายสนับสนุน HealthTAG'}</h2>
        </div>
        <div>
          <p>{en ? 'For reader issues, include the device model, operating system version, and failed step. For Data Source Node, include its revision, service versions, failed verification step, and redacted logs. Never send patient information, medical records, passwords, credentials, private keys, or unredacted logs.' : 'หากเครื่องอ่านมีปัญหา โปรดระบุรุ่นอุปกรณ์ เวอร์ชันระบบปฏิบัติการ และขั้นตอนที่เกิดปัญหา หากเป็น Data Source Node โปรดระบุ revision เวอร์ชันของ service ขั้นตอนตรวจสอบที่ไม่ผ่าน และ log ที่ปกปิดข้อมูลลับแล้ว ห้ามส่งข้อมูลผู้ป่วย เวชระเบียน รหัสผ่าน ข้อมูลรับรองการเข้าใช้ระบบ private key หรือ log ที่ยังมีข้อมูลลับ'}</p>
          <div class="actions">
            <a class="btn primary" href="mailto:support@healthtag.io">support@healthtag.io</a>
            <a class="btn secondary" href={`${prefix}/contact/`}>{en ? 'Corporate enquiries' : 'ติดต่อเรื่องอื่น'}</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .support-hero { padding-bottom: 82px; overflow: hidden; }
  .support-hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(40px, 7vw, 92px); align-items: center; }
  .support-hero h1 { max-width: 760px; }
  .device-figure { margin: 0; position: relative; aspect-ratio: 4 / 3; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; background: radial-gradient(circle at 50% 46%, var(--white) 0 34%, #e8eef2 72%, #d7e1e9 100%); box-shadow: var(--shadow); }
  .device-figure:before { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(145deg, transparent 55%, rgba(21,120,165,.08)); }
  .device-figure :global(img) { display: block; width: 92%; height: auto; object-fit: contain; clip-path: inset(7.8% 3.7% 9.5% 3.7% round 8%); filter: drop-shadow(0 16px 18px rgba(18,36,62,.16)); }
  .device-figure figcaption { position: absolute; z-index: 2; left: 18px; bottom: 18px; display: flex; align-items: center; gap: 11px; padding: 8px 12px; border-radius: 8px; background: rgba(246,248,252,.92); backdrop-filter: blur(8px); font-size: .82rem; font-weight: 600; }
  .device-figure figcaption span { font-family: 'IBM Plex Mono', monospace; color: var(--teal); }
  .setup-index { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--white); }
  .setup-index-grid { display: grid; grid-template-columns: .55fr 1.45fr; align-items: stretch; }
  .setup-index h2 { margin: 0; padding: 30px 30px 30px 0; align-self: center; font-size: 1.15rem; letter-spacing: -.02em; }
  .setup-paths { display: grid; grid-template-columns: repeat(4,1fr); border-left: 1px solid var(--line); }
  .setup-paths a { min-width: 0; padding: 24px; border-right: 1px solid var(--line); display: flex; flex-direction: column; transition: background .18s ease; }
  .setup-paths a:last-child { border-right: 0; }
  .setup-paths a:hover { background: var(--mint); }
  .setup-paths strong, .setup-paths small { display: block; }
  .setup-paths small { color: var(--muted); margin-top: 3px; }
  .path-code, .sequence { display: block; margin-bottom: 13px; font-family: 'IBM Plex Mono', monospace; color: var(--teal); font-size: .7rem; letter-spacing: .07em; text-transform: uppercase; }
  .legacy-code, .legacy-sequence { color: var(--amber-ink); }
  .community-code { color: var(--ink); }
  .driver-notice { display: grid; grid-template-columns: auto 1fr auto; gap: 22px; align-items: center; padding: 24px; margin-bottom: 22px; background: var(--amber-soft); border: 1px solid #dfc7a9; border-radius: var(--radius); }
  .driver-mark { width: 62px; height: 62px; display: grid; place-items: center; border-radius: 50%; background: var(--amber-ink); color: white; font-family: 'IBM Plex Mono', monospace; font-weight: 600; }
  .notice-label { color: var(--amber-ink); font-size: .74rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; }
  .driver-notice h3 { margin: 2px 0 0; font-size: 1.25rem; }
  .driver-notice p { margin: 2px 0 0; color: var(--muted); }
  .program-spread { display: grid; grid-template-columns: .85fr 1.15fr; background: var(--ink); color: var(--paper); border-radius: 26px; overflow: hidden; }
  .program-copy { padding: clamp(28px, 5vw, 54px); align-self: center; }
  .status-badge { display: inline-flex; padding: 5px 9px; border: 1px solid rgba(117,169,211,.5); border-radius: 999px; color: #9ac2e3; font-size: .72rem; text-transform: uppercase; letter-spacing: .07em; }
  .program-copy h3 { margin: 18px 0 12px; max-width: 530px; font-size: clamp(1.8rem, 3.2vw, 3rem); line-height: 1.12; letter-spacing: -.035em; }
  .program-copy > p { color: #bdc7d0; }
  .program-copy .btn { margin-top: 24px; }
  .program-specs { margin: 26px 0 0; border-top: 1px solid rgba(228,241,250,.18); }
  .program-specs div { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; padding: 10px 0; border-bottom: 1px solid rgba(228,241,250,.18); }
  .program-specs dt { color: #bdc7d0; }
  .program-specs dd { margin: 0; text-align: right; font-family: 'IBM Plex Mono', monospace; font-size: .78rem; overflow-wrap: anywhere; }
  .app-shot { margin: 0; align-self: stretch; position: relative; display: grid; grid-template-rows: minmax(0,1fr) auto; background: #e7ebef; }
  .app-shot :global(img), .legacy-content :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; box-sizing: border-box; padding: clamp(12px,2vw,24px); object-fit: contain; object-position: center; background: #e7ebef; }
  .app-shot figcaption, .legacy-content figcaption { padding: 10px 13px; color: var(--muted); background: var(--white); font-size: .76rem; }
  .install-steps { list-style: none; margin: 26px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4,1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .install-steps li { padding: 24px; display: grid; grid-template-columns: auto 1fr; gap: 14px; border-right: 1px solid var(--line); }
  .install-steps li:last-child { border-right: 0; }
  .install-steps li > span { font-family: 'IBM Plex Mono', monospace; color: var(--teal); font-size: .72rem; }
  .install-steps strong { display: block; }
