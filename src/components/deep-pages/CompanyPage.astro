---
import Base from '../../layouts/Base.astro';
import FounderCard from '../FounderCard.astro';
import TeamGallery from '../TeamGallery.astro';
import CompanyMilestones from '../CompanyMilestones.astro';
import type { Locale } from '../../data/site-content';

interface Props { locale: Locale }

const { locale } = Astro.props;
const en = locale === 'en';

const sectionLinks = en
  ? [
      ['#mission-vision', 'Mission & vision'],
      ['#values', 'Core values'],
      ['#milestones', 'Milestones'],
      ['#founder', 'Founder'],
      ['#team', 'Team'],
    ]
  : [
      ['#mission-vision', 'พันธกิจและวิสัยทัศน์'],
      ['#values', 'คุณค่าองค์กร'],
      ['#milestones', 'เหตุการณ์สำคัญ'],
      ['#founder', 'ผู้ก่อตั้ง'],
      ['#team', 'ทีมงาน'],
    ];

const operatingModel = en
  ? [
      ['Patient', 'Owns their health data and controls consent and use.'],
      ['Hospital', 'Stores and stewards the clinical record in its source systems.'],
      ['HealthTAG', 'Provides trust and interoperability infrastructure for authorized exchange.'],
    ]
  : [
      ['ผู้ป่วย', 'เป็นเจ้าของข้อมูลสุขภาพและกำหนดความยินยอมในการใช้ข้อมูล'],
      ['โรงพยาบาล', 'เก็บรักษาและดูแลเวชระเบียนในระบบต้นทาง'],
      ['HealthTAG', 'สร้างโครงสร้างพื้นฐานด้านความไว้วางใจและการเชื่อมโยงข้อมูลสำหรับการแลกเปลี่ยนที่ได้รับอนุญาต'],
    ];

const values = en
  ? [
      ['Patient Sovereignty', 'Health data belongs to the patient, not to a system. Consent must be explicit, limited in scope and time, auditable, and revocable. Hospitals store and steward clinical records in their source systems.'],
      ['Trust Before Intelligence', 'Before health data supports AI, it must be possible to verify where the data came from, who used it, when it was used, and under what right.'],
      ['Data Stays at Source', 'HealthTAG does not centralize the country\'s clinical records. Hospitals continue to store and steward their records while the infrastructure connects authorized access.'],
      ['Open Standards, Real Interoperability', 'We use open standards such as HL7 FHIR so systems from different vendors can connect without replacing the core HIS or creating unnecessary lock-in.'],
      ['Clinically Grounded', 'Founded by a physician, HealthTAG starts with a practical question: will this improve care for the patient? We choose technology only after the clinical need is clear.'],
      ['Ecosystem, Not Ego', 'National health data infrastructure requires accountable work with hospitals, universities, the public sector, industry, and technology partners. No organization can build it alone.'],
    ]
  : [
      ['เจ้าของข้อมูลคือประชาชน', 'ข้อมูลสุขภาพเป็นของผู้ป่วย ไม่ใช่ของระบบ ความยินยอมต้องชัดเจน จำกัดขอบเขต จำกัดเวลา ตรวจสอบได้ และเพิกถอนได้ ขณะที่โรงพยาบาลเก็บรักษาและดูแลเวชระเบียนในระบบต้นทาง'],
      ['ความไว้วางใจต้องมาก่อนปัญญา', 'ก่อนนำข้อมูลสุขภาพไปใช้กับ AI ต้องตรวจสอบได้ว่าข้อมูลมาจากไหน ใครใช้ ใช้เมื่อไร และใช้ด้วยสิทธิ์อะไร'],
      ['ข้อมูลอยู่ที่ต้นทาง', 'HealthTAG ไม่รวมเวชระเบียนของทั้งประเทศไว้ที่ส่วนกลาง โรงพยาบาลยังเก็บรักษาและดูแลเวชระเบียนของตน ส่วนโครงสร้างพื้นฐานช่วยเชื่อมการเข้าถึงที่ได้รับอนุญาต'],
      ['มาตรฐานเปิด เชื่อมได้จริง', 'เราใช้มาตรฐานเปิดอย่าง HL7 FHIR เพื่อให้ระบบจากผู้พัฒนาต่างรายเชื่อมต่อกันได้ โดยไม่ต้องเปลี่ยน HIS หลักหรือผูกติดกับผู้ให้บริการรายเดียวโดยไม่จำเป็น'],
      ['เกิดจากหน้างานจริง', 'HealthTAG ก่อตั้งโดยแพทย์ เราเริ่มจากคำถามว่าสิ่งที่ออกแบบจะช่วยให้การดูแลผู้ป่วยดีขึ้นหรือไม่ แล้วจึงเลือกเทคโนโลยีให้เหมาะกับความต้องการนั้น'],
      ['ทำงานร่วมกัน ไม่ทำคนเดียว', 'โครงสร้างพื้นฐานข้อมูลสุขภาพระดับประเทศต้องอาศัยการทำงานที่รับผิดชอบร่วมกับโรงพยาบาล มหาวิทยาลัย ภาครัฐ ภาคเอกชน และพันธมิตรเทคโนโลยี ไม่มีองค์กรใดสร้างได้โดยลำพัง'],
    ];

const founderEducation = en
  ? [
      ['M.D.', 'Khon Kaen University'],
      ['AI in Healthcare', 'National University of Singapore'],
    ]
  : [
      ['แพทยศาสตรบัณฑิต', 'มหาวิทยาลัยขอนแก่น'],
      ['AI in Healthcare', 'National University of Singapore'],
    ];

const founderAcademicRoles = en
  ? [
      ['KMITL', 'Adjunct Lecturer, Master\'s programme in Digital Health, Faculty of Medicine (International Programme), teaching Blockchain and Health Data'],
      ['Khon Kaen University', 'Adjunct Lecturer, KKU Academy, teaching Introduction to Blockchain'],
      ['Chulalongkorn University', 'Guest Lecturer, Master\'s programme in Digital Health, Faculty of Medicine'],
    ]
  : [
      ['สจล.', 'อาจารย์พิเศษ หลักสูตรปริญญาโทดิจิทัลเฮลท์ คณะแพทยศาสตร์ (หลักสูตรนานาชาติ) รายวิชา Blockchain and Health Data'],
      ['มหาวิทยาลัยขอนแก่น', 'อาจารย์พิเศษ หลักสูตร KKU Academy หัวข้อ Introduction to Blockchain'],
      ['จุฬาลงกรณ์มหาวิทยาลัย', 'วิทยากรรับเชิญ หลักสูตรปริญญาโทดิจิทัลเฮลท์ คณะแพทยศาสตร์'],
    ];
---

<Base
  locale={locale}
  path="company"
  title={en ? 'Company overview | HealthTAG' : 'ภาพรวมบริษัท | HealthTAG'}
  description={en
    ? 'HealthTAG mission, vision, values, milestones, founder, and current team.'
    : 'พันธกิจ วิสัยทัศน์ คุณค่า เหตุการณ์สำคัญ ผู้ก่อตั้ง และทีมงานปัจจุบันของ HealthTAG'}
>
  <main data-founder-copy>
    <section class="page-hero company-hero">
      <div class="container">
        <div class="eyebrow">HealthTAG / {en ? 'Company overview' : 'ภาพรวมบริษัท'}</div>
        <h1>{en ? 'Health data belongs to the patient' : 'ข้อมูลสุขภาพเป็นของผู้ป่วย'}</h1>
        <p>{en
          ? 'Patients control consent and use. Hospitals store and steward clinical records in their source systems. HealthTAG provides trust and interoperability infrastructure for authorized exchange.'
          : 'ผู้ป่วยเป็นผู้กำหนดความยินยอมและการใช้ข้อมูล โรงพยาบาลเก็บรักษาและดูแลเวชระเบียนในระบบต้นทาง ส่วน HealthTAG สร้างโครงสร้างพื้นฐานด้านความไว้วางใจและการเชื่อมโยงข้อมูล'}</p>
      </div>
    </section>

    <nav class="company-index" aria-label={en ? 'On this page' : 'สารบัญ'}>
      <div class="container">
        <span class="mono">{en ? 'ON THIS PAGE' : 'สารบัญ'}</span>
        <ul role="list">
          {sectionLinks.map(([href, label], index) => (
            <li><a href={href}><span>0{index + 1}</span>{label}</a></li>
          ))}
        </ul>
      </div>
    </nav>

    <section id="mission-vision" class="section mission-vision" aria-labelledby="vision-heading">
      <div class="container">
        <div class="vision-grid">
          <div class="vision-panel">
            <span class="mono">{en ? 'OUR VISION' : 'วิสัยทัศน์'}</span>
            <h2 id="vision-heading">{en
              ? 'Your data. Your consent. One connected Thailand.'
              : 'ข้อมูลของคุณ ความยินยอมของคุณ เชื่อมถึงกันทั้งประเทศ'}</h2>
            <p>{en
              ? 'We are working toward a Thailand where each person controls consent and use of their health data. Records can connect across the country, and that data can support better care with safeguards, transparency, and an audit trail.'
              : 'HealthTAG มุ่งให้ทุกคนกำหนดความยินยอมและการใช้ข้อมูลสุขภาพของตนเองได้ เวชระเบียนเชื่อมต่อกันได้ทั่วประเทศ และนำข้อมูลไปช่วยดูแลผู้ป่วยโดยมีมาตรการความปลอดภัย ความโปร่งใส และประวัติที่ตรวจสอบได้'}</p>
          </div>

          <div class="mission-panel">
            <span class="mono">{en ? 'OUR MISSION' : 'พันธกิจ'}</span>
            <h2>{en ? 'Build trusted health data infrastructure for Thailand' : 'สร้างโครงสร้างพื้นฐานข้อมูลสุขภาพที่วางใจได้สำหรับประเทศไทย'}</h2>
            <p>{en
              ? 'Our mission is to keep clinical records in hospital source systems and allow their authorized use according to the data owner\'s consent. Open standards connect hospitals, universities, public agencies, and industry. This can support better care and medical AI in the future.'
              : 'พันธกิจของเราคือเก็บเวชระเบียนไว้ในระบบต้นทางของโรงพยาบาล และให้การใช้ข้อมูลที่ได้รับอนุญาตเป็นไปตามความยินยอมของเจ้าของข้อมูล มาตรฐานเปิดช่วยเชื่อมโรงพยาบาล มหาวิทยาลัย หน่วยงานภาครัฐ และภาคเอกชน เพื่อรองรับการดูแลผู้ป่วยและ AI ทางการแพทย์ในอนาคต'}</p>

            <dl class="operating-model">
              {operatingModel.map(([term, detail]) => (
                <div><dt>{term}</dt><dd>{detail}</dd></div>
              ))}
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section id="values" class="section values" aria-labelledby="values-heading">
      <div class="container">
        <div class="section-head">
          <h2 id="values-heading">{en ? 'Six values that guide our work' : 'คุณค่า 6 ข้อที่กำกับการทำงานของเรา'}</h2>
          <p>{en
            ? 'These values guide HealthTAG product decisions, technical boundaries, and work with partners.'
            : 'คุณค่าเหล่านี้ใช้กำกับการตัดสินใจเรื่องผลิตภัณฑ์ ขอบเขตทางเทคนิค และการทำงานกับพันธมิตรของ HealthTAG'}</p>
        </div>
        <ol class="values-list">
          {values.map(([title, body], index) => (
            <li>
              <span class="value-number">0{index + 1}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <CompanyMilestones locale={locale} />

    <section id="founder" class="section founder-story" aria-labelledby="founder-heading">
      <div class="container founder-layout">
        <div class="founder-intro">
          <span class="mono">{en ? 'CLINICALLY GROUNDED' : 'เริ่มจากการดูแลผู้ป่วย'}</span>
          <h2 id="founder-heading">{en ? 'Dechowat Promda, M.D.' : 'นพ.เดโชวัต พรมดา'}</h2>
          <p class="founder-title">{en ? 'Founder & CEO, HealthTAG' : 'ผู้ก่อตั้งและประธานเจ้าหน้าที่บริหาร HealthTAG'}</p>
          <p>{en
            ? 'Dr. Dechowat founded HealthTAG after seeing a recurring problem in patient care: one patient\'s records were scattered across systems that did not connect, with no shared infrastructure for moving data correctly and with permission. He remains in clinical practice while leading the team, keeping product decisions tied to the realities of care.'
            : 'นพ.เดโชวัตก่อตั้ง HealthTAG จากปัญหาที่พบในการดูแลผู้ป่วยโดยตรง เวชระเบียนของผู้ป่วยหนึ่งคนกระจายอยู่ในระบบที่ไม่เชื่อมกัน และยังขาดโครงสร้างพื้นฐานที่ช่วยให้ข้อมูลเคลื่อนที่ได้อย่างถูกต้องและได้รับอนุญาต ปัจจุบันยังคงปฏิบัติงานทางคลินิกควบคู่กับการนำทีม เพื่อให้การออกแบบผลิตภัณฑ์เริ่มจากหน้างานจริง'}</p>
        </div>
        <FounderCard locale={locale} variant="portrait" />
        <div class="founder-details">
          <section aria-labelledby="founder-education-heading">
            <h3 id="founder-education-heading">{en ? 'Education' : 'การศึกษา'}</h3>
            <dl>{founderEducation.map(([course, institution]) => <div><dt>{course}</dt><dd>{institution}</dd></div>)}</dl>
          </section>
          <section aria-labelledby="founder-academic-heading">
            <h3 id="founder-academic-heading">{en ? 'Academic roles' : 'บทบาททางวิชาการ'}</h3>
            <dl>{founderAcademicRoles.map(([institution, role]) => <div><dt>{institution}</dt><dd>{role}</dd></div>)}</dl>
          </section>
        </div>
        <section class="founder-talk" aria-labelledby="founder-talk-heading">
          <div class="talk-copy">
            <span class="mono">TEDxSirirajFacultyOfMedicine · 2022</span>
            <h3 id="founder-talk-heading">DON'T TRUST JUST VERIFY!</h3>
            <p>{en
              ? 'The talk considers how verifiable health data can support connected care across healthcare institutions.'
              : 'การบรรยายกล่าวถึงข้อมูลสุขภาพที่ตรวจสอบได้และการดูแลที่เชื่อมถึงกันระหว่างสถานพยาบาล'}</p>
            <div class="talk-links">
              <a href="https://www.ted.com/talks/dechowat_promda_don_t_trust_just_verify" target="_blank" rel="noopener noreferrer">{en ? 'Watch on TED.com' : 'ดู talk บน TED.com'} <span aria-hidden="true">↗</span></a>
              <a href="https://www.ted.com/tedx/events/44335" target="_blank" rel="noopener noreferrer">{en ? 'Event record' : 'ข้อมูลงาน'} <span aria-hidden="true">↗</span></a>
              <a href="https://youtu.be/94WBbooeqhc" target="_blank" rel="noopener noreferrer">YouTube <span aria-hidden="true">↗</span></a>
            </div>
            <blockquote>"Don't trust. Just verify."</blockquote>
          </div>
          <div class="talk-embed">
            <iframe
              src="https://embed.ted.com/talks/dechowat_promda_don_t_trust_just_verify"
              title={en ? "DON'T TRUST JUST VERIFY! by Dechowat Promda at TEDxSirirajFacultyOfMedicine" : "DON'T TRUST JUST VERIFY! โดย นพ.เดโชวัต พรมดา ที่ TEDxSirirajFacultyOfMedicine"}
              loading="lazy"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </section>
      </div>
    </section>

    <div id="team" class="team-anchor"><TeamGallery locale={locale} /></div>
  </main>
</Base>

<style>
  .company-hero { padding-bottom: 78px; }
  .company-hero h1 { max-width: 1020px; }

  .company-index { border-block: 1px solid var(--line); background: var(--white); }
  .company-index .container { display: grid; grid-template-columns: minmax(130px, .32fr) 1fr; gap: 34px; align-items: center; padding-block: 20px; }
  .company-index > .container > .mono { color: var(--muted); font-size: .68rem; letter-spacing: .08em; }
  .company-index ul { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; margin: 0; padding: 0; list-style: none; }
  .company-index a { display: flex; gap: 9px; align-items: baseline; min-height: 44px; padding: 10px 12px; border-radius: 8px; font-weight: 600; line-height: 1.35; }
  .company-index a:hover { background: var(--mint); }
  .company-index a:focus-visible { outline: 3px solid var(--amber); }
  .company-index a span { font-family: 'IBM Plex Mono', ui-monospace, monospace; color: var(--teal); font-size: .68rem; }

  .mission-vision { background: var(--white); }
  .vision-grid { display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); gap: clamp(34px, 6vw, 88px); align-items: start; }
  .vision-panel { padding: clamp(28px, 5vw, 54px); border-radius: 16px; background: var(--ink); color: var(--paper); }
  .vision-panel .mono { color: #75d3c8; }
  .vision-panel h2 { margin: 20px 0 26px; color: var(--paper); font-size: clamp(2.45rem, 5vw, 4.8rem); }
  .vision-panel p { margin: 0; color: #c7d8d8; font-size: 1.05rem; }
  .mission-panel { padding-top: clamp(6px, 2vw, 20px); }
  .mission-panel > .mono, .founder-intro > .mono { color: var(--teal); font-size: .7rem; letter-spacing: .08em; }
  .mission-panel h2 { margin: 17px 0 22px; font-size: clamp(2.2rem, 4vw, 3.9rem); }
  .mission-panel > p { margin: 0; color: var(--muted); font-size: 1.06rem; }

  .operating-model { margin: 42px 0 0; }
  .operating-model div { display: grid; grid-template-columns: minmax(105px, .32fr) 1fr; gap: 20px; padding: 17px 0; border-top: 1px solid var(--line); }
  .operating-model div:last-child { border-bottom: 1px solid var(--line); }
  .operating-model dt { font-weight: 700; }
  .operating-model dd { margin: 0; color: var(--muted); }

  .values { background: var(--paper); }
  .values-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .values-list li { display: grid; grid-template-columns: 64px minmax(210px, .7fr) minmax(0, 1.3fr); gap: 24px; align-items: start; padding: 28px 0; border-bottom: 1px solid var(--line); }
  .value-number { font-family: 'IBM Plex Mono', ui-monospace, monospace; color: var(--teal); font-size: .72rem; }
  .values-list h3 { margin: 0; font-size: 1.3rem; line-height: 1.35; }
  .values-list p { margin: 0; color: var(--muted); }

  .founder-story { background: var(--mint); }
  .founder-layout { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(32px, 6vw, 78px); align-items: center; }
  .founder-intro h2 { margin: 16px 0 4px; font-size: clamp(2.2rem, 4vw, 4rem); }
  .founder-title { margin: 0 0 24px; color: var(--ink); font-weight: 600; }
  .founder-intro > p:last-child { color: var(--muted); font-size: 1.04rem; }
  .founder-details { grid-column: 1 / -1; display: grid; grid-template-columns: .72fr 1.28fr; border-top: 1px solid #9ccac2; border-bottom: 1px solid #9ccac2; }
  .founder-details > section { padding: 28px 32px 30px 0; }
  .founder-details > section + section { padding-left: 32px; border-left: 1px solid #9ccac2; }
  .founder-details h3 { margin: 0 0 18px; color: var(--teal); font-size: .76rem; letter-spacing: .07em; text-transform: uppercase; }
  .founder-details dl { margin: 0; }
  .founder-details dl div { display: grid; grid-template-columns: minmax(130px, .42fr) minmax(0, 1fr); gap: 18px; padding: 13px 0; border-top: 1px solid color-mix(in srgb, var(--teal) 22%, transparent); }
  .founder-details dt { font-weight: 600; }
  .founder-details dd { margin: 0; color: var(--muted); }
  .founder-talk { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(18rem, .72fr) minmax(0, 1.28fr); border: 1px solid #9ccac2; background: var(--white); }
  .talk-copy { display: flex; flex-direction: column; align-items: flex-start; padding: clamp(24px, 4vw, 42px); }
  .talk-copy > .mono { color: var(--teal); font-size: .66rem; letter-spacing: .06em; }
  .talk-copy h3 { margin: 18px 0 12px; font-size: clamp(1.75rem, 3vw, 2.8rem); line-height: 1.05; letter-spacing: -.04em; }
  .talk-copy p { margin: 0; color: var(--muted); }
  .talk-links { display: flex; flex-wrap: wrap; gap: 10px 16px; margin-top: 22px; }
