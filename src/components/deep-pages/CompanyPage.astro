---
import Base from '../../layouts/Base.astro';
import FounderCard from '../FounderCard.astro';
import TeamGallery from '../TeamGallery.astro';
import type { Locale } from '../../data/site-content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
---
<Base locale={locale} path="company" title={en ? 'Company | HealthTAG' : 'บริษัท | HealthTAG'} description={en ? 'Why HealthTAG helps move health information between existing clinical systems while hospitals retain control.' : 'เหตุผลที่ HealthTAG ช่วยเชื่อมข้อมูลระหว่างระบบเดิม โดยโรงพยาบาลยังควบคุมระบบและเวชระเบียนของตน'}>
  <main>
    <section class="page-hero"><div class="container"><div class="eyebrow">HealthTAG / {en ? 'Company' : 'บริษัท'}</div><h1>{en ? 'HealthTAG began with a problem seen in patient care' : 'HealthTAG เริ่มจากปัญหาที่พบในการดูแลผู้ป่วย'}</h1><p>{en ? 'Health records may exist in several systems but still be difficult to use when a patient needs care.' : 'เวชระเบียนอาจอยู่ในหลายระบบ แต่ยังนำมาใช้ได้ยากเมื่อผู้ป่วยต้องรับการดูแล'}</p></div></section>
    <section class="section founder-story"><div class="container"><div class="founder-copy"><span class="mono">{en ? 'CLINICAL EXPERIENCE' : 'ประสบการณ์ทางคลินิก'}</span><h2>{en ? 'Health records need a reliable way to move between systems' : 'ข้อมูลสุขภาพต้องเชื่อมต่อระหว่างระบบได้'}</h2><p>{en ? 'Dechowat Promda, M.D. founded HealthTAG after seeing how difficult it was to access health information across separate hospital systems.' : 'นพ. เดโชวัต พรมดา ก่อตั้ง HealthTAG หลังพบว่าการเข้าถึงข้อมูลสุขภาพจากระบบโรงพยาบาลที่แยกจากกันยังทำได้ยาก'}</p><p>{en ? 'HealthTAG works on FHIR interoperability, patient identity, access control, and audit while hospitals retain control of clinical records.' : 'HealthTAG พัฒนาการเชื่อมโยงข้อมูลด้วย FHIR การเชื่อมตัวตนผู้ป่วย การควบคุมสิทธิ์ และการตรวจสอบย้อนหลัง โดยโรงพยาบาลยังควบคุมเวชระเบียนของตน'}</p></div><FounderCard locale={locale} /></div></section>
    <section class="section principles"><div class="container"><div class="section-head"><h2>{en ? 'How HealthTAG approaches the problem' : 'แนวทางของ HealthTAG'}</h2><p>{en ? 'The product is designed around existing hospital systems and clearly separated responsibilities.' : 'ผลิตภัณฑ์ออกแบบให้ทำงานกับระบบโรงพยาบาลเดิม และแยกหน้าที่ของแต่ละส่วนให้ชัดเจน'}</p></div><ol><li><span>01</span><div><h3>{en ? 'Connect the existing HIS' : 'เชื่อม HIS เดิม'}</h3><p>{en ? 'Hospitals can connect data without replacing their core HIS.' : 'โรงพยาบาลเชื่อมข้อมูลได้โดยยังใช้ HIS หลักของตน'}</p></div></li><li><span>02</span><div><h3>{en ? 'Keep records under hospital control' : 'โรงพยาบาลยังควบคุมเวชระเบียน'}</h3><p>{en ? 'Clinical records stay in hospital-controlled systems.' : 'เวชระเบียนอยู่ในระบบที่โรงพยาบาลควบคุม'}</p></div></li><li><span>03</span><div><h3>{en ? 'Separate each responsibility' : 'แยกหน้าที่ของระบบ'}</h3><p>{en ? 'Identity, authorization, exchange, and audit are handled as separate functions.' : 'การเชื่อมตัวตน การตรวจสิทธิ์ การแลกเปลี่ยน และการตรวจสอบย้อนหลังทำหน้าที่แยกจากกัน'}</p></div></li></ol></div></section>
    <TeamGallery locale={locale} />
  </main>
</Base>
<style>
  .founder-story { background: var(--mint); } .founder-story .container { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(35px,8vw,110px); align-items: center; } .mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: .7rem; letter-spacing: .07em; color: var(--teal); } .founder-copy h2 { margin: 16px 0; font-size: clamp(2.2rem,4vw,4rem); line-height: 1.08; letter-spacing: -.05em; } .founder-copy p { color: var(--muted); } .principles { background: var(--white); } ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); } li { display: grid; grid-template-columns: 70px 1fr 1.3fr; gap: 20px; padding: 22px 0; border-bottom: 1px solid var(--line); } li > span { font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: .75rem; color: var(--teal); } li h3 { margin: 0; font-size: 1.22rem; line-height: 1.35; } li p { margin: 0; color: var(--muted); } @media (max-width: 760px) { .founder-story .container { grid-template-columns: 1fr; } li { grid-template-columns: 42px 1fr; gap: 12px; } li p { grid-column: 2; } }
</style>
