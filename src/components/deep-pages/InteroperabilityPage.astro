---
import Base from '../../layouts/Base.astro';
import ArchitectureDiagram from './ArchitectureDiagram.astro';
import type { Locale } from '../../data/site-content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const prefix = en ? '/en' : '';
---
<Base locale={locale} path="interoperability" title={en ? 'Data Interoperability | HealthTAG' : 'การเชื่อมโยงข้อมูล | HealthTAG'} description={en ? 'How hospitals connect an existing HIS to a hospital-managed FHIR system through open standards and protected API access.' : 'วิธีเชื่อม HIS เดิมเข้ากับระบบ FHIR ที่โรงพยาบาลดูแล ผ่านมาตรฐานเปิดและการปกป้องการเข้าถึง API'}>
  <main>
    <section class="page-hero" data-founder-copy><div class="container"><div class="eyebrow">HealthTAG / {en ? 'Interoperability' : 'การเชื่อมโยงข้อมูล'}</div><h1>{en ? 'Connect an existing HIS to a hospital-managed FHIR system' : 'เชื่อม HIS เดิมเข้ากับระบบ FHIR ที่โรงพยาบาลดูแล'}</h1><p>{en ? 'Health data belongs to the patient while hospitals store and steward clinical records in their source systems. Hospital teams can use their own integration script or HealthTAG FHIR Transformer without replacing the existing HIS.' : 'ข้อมูลสุขภาพเป็นของผู้ป่วย ขณะที่โรงพยาบาลจัดเก็บและดูแลเวชระเบียนในระบบต้นทาง ทีมโรงพยาบาลเลือกใช้สคริปต์ของตนเองหรือ HealthTAG FHIR Transformer ได้โดยไม่ต้องเปลี่ยน HIS เดิม'}</p></div></section>
    <section class="section diagram-section"><div class="container"><ArchitectureDiagram locale={locale} /></div></section>
    <section class="section"><div class="container"><div class="section-head"><h2>{en ? 'Two ways to send HIS data to FHIR' : 'สองวิธีนำข้อมูลจาก HIS เข้าสู่ FHIR'}</h2><p>{en ? 'Both methods send data to the hospital FHIR system. The hospital chooses the method that fits its existing integration work.' : 'ทั้งสองวิธีส่งข้อมูลเข้าสู่ระบบ FHIR ของโรงพยาบาล โดยแต่ละแห่งเลือกวิธีที่เหมาะกับงานเชื่อมระบบที่มีอยู่'}</p></div><div class="choice-grid"><article><span class="mono">PATH A</span><h3>{en ? 'Hospital IT script' : 'สคริปต์ของทีม IT โรงพยาบาล'}</h3><p>{en ? 'A hospital IT team can use its own script to send data to the FHIR Server. Siriraj uses this method.' : 'ทีม IT โรงพยาบาลใช้สคริปต์ของตนเองส่งข้อมูลเข้า FHIR Server ได้ โดยศิริราชใช้วิธีนี้'}</p><a href={`${prefix}/deployments/`}>{en ? 'Read the Siriraj case' : 'อ่านกรณีศิริราช'} →</a></article><article><span class="mono">PATH B</span><h3>HealthTAG FHIR Transformer</h3><p>{en ? 'HealthTAG FHIR Transformer maps selected HIS data to FHIR R4. The resource list depends on each installation.' : 'HealthTAG FHIR Transformer แปลงข้อมูล HIS ที่เลือกเป็น FHIR R4 โดยรายการ resource ขึ้นอยู่กับการติดตั้งแต่ละแห่ง'}</p><a href={`${prefix}/deployments/`}>{en ? 'Read the Khian Sa case' : 'อ่านกรณีเคียนซา'} →</a></article></div></div></section>
    <section class="section"><div class="container specification"><div><div class="eyebrow">{en ? 'FHIR system' : 'ระบบ FHIR'}</div><h2>{en ? 'What each component does' : 'หน้าที่ของแต่ละส่วน'}</h2></div><dl><div><dt>FHIR Server</dt><dd>{en ? 'Stores health data in the HL7 FHIR R4 format.' : 'เก็บข้อมูลสุขภาพในรูปแบบ HL7 FHIR R4'}</dd></div><div><dt>Relational database</dt><dd>{en ? 'Provides persistent storage for the FHIR Server.' : 'จัดเก็บข้อมูลของ FHIR Server'}</dd></div><div><dt>API Gateway</dt><dd>{en ? 'Provides the TLS gateway and protects access to the FHIR API.' : 'ทำหน้าที่เป็น TLS gateway และปกป้องการเข้าถึง FHIR API'}</dd></div><div><dt>{en ? 'Identity and authorization service' : 'บริการเชื่อมตัวตนและตรวจสิทธิ์'}</dt><dd>{en ? 'Links patient identity and checks authorization inside the hospital network.' : 'เชื่อมตัวตนผู้ป่วยและตรวจสิทธิ์ภายในเครือข่ายโรงพยาบาล'}</dd></div></dl></div></section>
    <section class="section standards-section" data-founder-copy>
      <div class="container">
        <div class="section-head"><span class="mono">{en ? 'DESIGN PRINCIPLES' : 'หลักการออกแบบ'}</span><h2>{en ? 'Keep records at source and use open standards' : 'เก็บเวชระเบียนไว้ที่ต้นทางและใช้มาตรฐานเปิด'}</h2></div>
        <div class="principle-grid">
          <article>
            <span class="principle-index">01</span>
            <h3>{en ? 'Data stays at source' : 'ข้อมูลอยู่ที่ระบบต้นทาง'}</h3>
            <p>{en ? 'The hospital remains responsible for storing and stewarding the clinical record. HealthTAG connects the systems around an authorized exchange instead of putting clinical records on blockchain.' : 'โรงพยาบาลยังรับผิดชอบการจัดเก็บและดูแลเวชระเบียน HealthTAG เชื่อมระบบเพื่อแลกเปลี่ยนข้อมูลตามสิทธิ์ โดยไม่นำเวชระเบียนไปเก็บบน blockchain'}</p>
          </article>
          <article>
            <span class="principle-index">02</span>
            <h3>{en ? 'Open standards let systems from different vendors exchange data' : 'มาตรฐานเปิดช่วยให้ระบบจากผู้พัฒนาต่างรายแลกเปลี่ยนข้อมูลกันได้'}</h3>
            <p>{en ? 'HL7 FHIR R4 gives connected systems a shared data structure. Open standards help different vendors communicate, reduce dependence on one proprietary format, and leave room for future integrations.' : 'HL7 FHIR R4 ทำให้ระบบที่เชื่อมต่อใช้โครงสร้างข้อมูลร่วมกัน มาตรฐานเปิดช่วยให้ระบบจากผู้ให้บริการต่างกันสื่อสารกัน ลดการพึ่งพารูปแบบเฉพาะราย และรองรับการเชื่อมต่อเพิ่มเติมในอนาคต'}</p>
          </article>
        </div>
      </div>
    </section>
    <section class="section resources"><div class="container"><div class="section-head"><h2>{en ? 'FHIR resources used at Khian Sa' : 'FHIR resources ที่ใช้ในโรงพยาบาลเคียนซา'}</h2><p>{en ? 'Khian Sa uses four FHIR resources in this installation.' : 'การติดตั้งที่เคียนซาใช้ FHIR resources 4 ประเภท'}</p></div><div class="resource-grid">{['Patient','AllergyIntolerance','Encounter','MedicationDispense'].map((resource) => <span class="mono">{resource}</span>)}</div><a class="btn secondary" href={`${prefix}/contact/`}>{en ? 'Request technical architecture access' : 'ขอสิทธิ์เข้าถึงเอกสารสถาปัตยกรรม'} <span aria-hidden="true">→</span></a></div></section>
  </main>
</Base>
<style>
  .diagram-section { background: #102f36; } .choice-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; } .choice-grid article { padding: 30px; border: 1px solid var(--line); border-radius: 14px; background: var(--white); } .mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: .72rem; letter-spacing: .06em; color: var(--teal); } h3 { margin: 12px 0 10px; font-size: 1.45rem; line-height: 1.25; letter-spacing: -.03em; } article p { margin: 0; color: var(--muted); } article a { display: inline-block; margin-top: 20px; color: var(--teal); font-weight: 600; } .specification { display: grid; grid-template-columns: .85fr 1.15fr; gap: 60px; } .specification h2 { margin: 0; font-size: clamp(2.1rem, 4vw, 3.8rem); line-height: 1.12; letter-spacing: -.045em; } dl { margin: 0; } dl div { display: grid; grid-template-columns: .8fr 1.2fr; gap: 18px; padding: 17px 0; border-top: 1px solid var(--line); } dt { font-weight: 600; } dd { margin: 0; color: var(--muted); }
  .standards-section { background: var(--white); } .standards-section .section-head .mono { display: block; margin-bottom: 1rem; } .principle-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); } .principle-grid article { padding: 28px 28px 0 0; } .principle-grid article + article { padding-left: 28px; border-left: 1px solid var(--line); } .principle-index { color: var(--amber-ink); font: 600 .78rem/1 'IBM Plex Mono', ui-monospace, monospace; }
  .resources { background: var(--mint); } .resource-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 26px; } .resource-grid span { padding: 18px 13px; border: 1px solid #9ccac2; background: rgba(255,255,255,.5); border-radius: 9px; color: var(--ink); overflow-wrap: anywhere; } @media (max-width: 760px) { .choice-grid, .specification, .resource-grid, .principle-grid { grid-template-columns: 1fr; } .specification { gap: 34px; } dl div { grid-template-columns: 1fr; gap: 3px; } .principle-grid article { padding: 24px 0; } .principle-grid article + article { padding-left: 0; border-top: 1px solid var(--line); border-left: 0; } }
</style>
