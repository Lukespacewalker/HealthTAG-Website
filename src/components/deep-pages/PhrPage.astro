---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import overviewScreen from '../../assets/phr/phr-overview-redacted.png';
import medicationsScreen from '../../assets/phr/phr-medications-redacted.png';
import reportsScreen from '../../assets/phr/phr-special-reports-redacted.png';
import connectionsScreen from '../../assets/phr/phr-hospital-connections-redacted.png';
import bioAgeScreen from '../../assets/phr/phr-biological-age-redacted.png';

interface Props { locale: 'th' | 'en' }
const { locale } = Astro.props;
const en = locale === 'en';
const prefix = en ? '/en' : '';

const capabilities = en ? [
  {
    index: '01',
    title: 'A health overview without losing the detail',
    body: 'The overview brings together the available clinical summary, biological-age results, and continuous readings. Patients can move from a high-level health score to the underlying category that needs attention.',
    labels: ['Clinical summary', 'Biological age', 'Continuous readings'],
  },
  {
    index: '02',
    title: 'Records organized around common patient questions',
    body: 'Separate views cover medicines, allergies, vaccinations, hospital visits, and special reports. The medicine view uses a calendar to show when medicine was received, while special reports group items such as NCD and kidney-clinic results.',
    labels: ['Medicines', 'Allergies', 'Vaccinations', 'Visits'],
  },
  {
    index: '03',
    title: 'Hospital connections remain visible',
    body: 'Patients can see connected data sources and the number of available visit, medicine, document, and medical-image records. Connection controls are shown alongside the hospital or provider identity.',
    labels: ['Data sources', 'Connection control', 'Record counts'],
  },
  {
    index: '04',
    title: 'Other tools available in the PHR',
    body: 'The PHR also includes biological-age analytics, an AI assistant area, referral, emergency information, and profile settings. Availability and content depend on the account, connected services, and the data supplied to the PHR.',
    labels: ['BioAge analytics', 'AI assistant', 'Referral', 'Emergency'],
  },
  {
    index: '05',
    title: 'NFC is an entry point, not the record store',
    body: 'An NFC sticker can open the user’s PHR on a compatible device. Normal identity and authorization checks still apply, and the sticker does not store the user’s clinical record.',
    labels: ['NFC sticker', 'PHR entry point', 'No clinical records on sticker'],
  },
] : [
  {
    index: '01',
    title: 'เห็นภาพรวมสุขภาพ โดยยังลงไปดูรายละเอียดได้',
    body: 'หน้า Overview รวมสรุปข้อมูลทางคลินิก ผลอายุชีวภาพ และข้อมูลต่อเนื่องที่มีอยู่ ผู้ป่วยจึงเริ่มจากคะแนนภาพรวม แล้วเลือกดูหมวดที่ต้องการติดตามต่อได้',
    labels: ['ข้อมูลทางคลินิก', 'อายุชีวภาพ', 'ข้อมูลต่อเนื่อง'],
  },
  {
    index: '02',
    title: 'แยกข้อมูลตามเรื่องที่ผู้ป่วยต้องการดู',
    body: 'ข้อมูลยา การแพ้ วัคซีน การรับบริการ และรายงานสุขภาพมีหน้าของตนเอง หน้ายาใช้ปฏิทินแสดงวันที่รับยา ส่วนรายงานสุขภาพรวบรวมหัวข้ออย่างคลินิก NCD และคลินิกโรคไต',
    labels: ['ยา', 'การแพ้', 'วัคซีน', 'การรับบริการ'],
  },
  {
    index: '03',
    title: 'ตรวจสอบการเชื่อมต่อโรงพยาบาลได้',
    body: 'ผู้ป่วยเห็นแหล่งข้อมูลที่เชื่อมต่อ พร้อมจำนวนข้อมูลการรับบริการ ยา เอกสาร และภาพทางการแพทย์ การควบคุมการเชื่อมต่อแสดงคู่กับชื่อโรงพยาบาลหรือผู้ให้บริการ',
    labels: ['แหล่งข้อมูล', 'ควบคุมการเชื่อมต่อ', 'จำนวนรายการ'],
  },
  {
    index: '04',
    title: 'เครื่องมืออื่นใน PHR',
    body: 'PHR มีการวิเคราะห์อายุชีวภาพ พื้นที่ผู้ช่วย AI การส่งต่อ ข้อมูลฉุกเฉิน และการตั้งค่าโปรไฟล์ เนื้อหาที่เห็นขึ้นกับบัญชี บริการที่เชื่อมต่อ และข้อมูลที่ส่งเข้ามายัง PHR',
    labels: ['BioAge analytics', 'ผู้ช่วย AI', 'การส่งต่อ', 'ข้อมูลฉุกเฉิน'],
  },
  {
    index: '05',
    title: 'NFC เป็นทางเข้า PHR ไม่ใช่ที่เก็บเวชระเบียน',
    body: 'NFC sticker ใช้เปิด PHR ของผู้ใช้บนอุปกรณ์ที่รองรับ โดยระบบยังตรวจตัวตนและสิทธิ์ตามปกติ ส่วนเวชระเบียนไม่ได้เก็บไว้บน sticker',
    labels: ['NFC sticker', 'ทางเข้า PHR', 'ไม่เก็บเวชระเบียนบน sticker'],
  },
];

const screenshots = en ? [
  { src: overviewScreen, title: 'Health overview', body: 'The overview combines the available clinical summary, biological-age results, and continuous readings. A patient can start here before opening a specific category.', alt: 'HealthTAG PHR health overview with a health score, clinical and biological summaries, and continuous readings', featured: true },
  { src: medicationsScreen, title: 'Medicine calendar', body: 'The medicine view marks dates on a calendar. When a patient selects a date, the available medicine details appear beside it.', alt: 'HealthTAG PHR medicine calendar with a panel for medicine details' },
  { src: reportsScreen, title: 'Special reports', body: 'Special reports group health information by clinical context, including NCD and kidney-clinic categories.', alt: 'HealthTAG PHR special-report list with NCD and kidney-clinic categories' },
  { src: connectionsScreen, title: 'Hospital connections', body: 'The connection view summarizes available visits, medicines, documents, and medical images, then lists the data sources a patient can connect.', alt: 'HealthTAG PHR hospital-connection view with record counts and connection controls' },
  { src: bioAgeScreen, title: 'Biological-age trends', body: 'BioAge Analytics compares results across testing rounds and presents the available biological-age, age-acceleration, and telomere measures.', alt: 'HealthTAG PHR BioAge Analytics screen with biological-age trends and test results' },
] : [
  { src: overviewScreen, title: 'ภาพรวมสุขภาพ', body: 'หน้า Overview รวมสรุปข้อมูลทางคลินิก ผลอายุชีวภาพ และข้อมูลต่อเนื่องที่มีอยู่ ผู้ป่วยเริ่มจากจุดนี้แล้วจึงเปิดดูหมวดที่ต้องการได้', alt: 'หน้าภาพรวม HealthTAG PHR แสดงคะแนนสุขภาพ สรุปข้อมูลทางคลินิกและชีวภาพ และข้อมูลต่อเนื่อง', featured: true },
  { src: medicationsScreen, title: 'ปฏิทินยา', body: 'หน้ายาใช้ปฏิทินระบุวันที่รับยา เมื่อเลือกวันที่ รายละเอียดยาที่มีในวันนั้นจะแสดงด้านข้าง', alt: 'หน้าปฏิทินยา HealthTAG PHR พร้อมพื้นที่แสดงรายละเอียดยา' },
  { src: reportsScreen, title: 'รายงานสุขภาพ', body: 'รายงานสุขภาพแยกข้อมูลตามบริบทของคลินิก เช่น คลินิก NCD และคลินิกโรคไต', alt: 'หน้ารายงานสุขภาพ HealthTAG PHR มีหมวดคลินิก NCD และคลินิกโรคไต' },
  { src: connectionsScreen, title: 'การเชื่อมต่อโรงพยาบาล', body: 'หน้าการเชื่อมต่อสรุปจำนวนข้อมูลการรับบริการ ยา เอกสาร และภาพทางการแพทย์ ก่อนแสดงแหล่งข้อมูลที่ผู้ป่วยเชื่อมต่อได้', alt: 'หน้าการเชื่อมต่อโรงพยาบาล HealthTAG PHR แสดงจำนวนข้อมูลและตัวควบคุมการเชื่อมต่อ' },
  { src: bioAgeScreen, title: 'แนวโน้มอายุชีวภาพ', body: 'BioAge Analytics เปรียบเทียบผลจากหลายรอบการตรวจ พร้อมค่าอายุชีวภาพ การเร่งอายุ และความยาวเทโลเมียร์ที่มีอยู่', alt: 'หน้า BioAge Analytics ของ HealthTAG PHR แสดงแนวโน้มอายุชีวภาพและผลการตรวจ' },
];
---

<Base
  locale={locale}
  path="phr"
  title={en ? 'Personal Health Record (PHR) | HealthTAG' : 'สมุดสุขภาพส่วนบุคคล (PHR) | HealthTAG'}
  description={en ? 'HealthTAG PHR presents permitted health information for the patient while hospitals steward clinical records in source systems.' : 'HealthTAG PHR แสดงข้อมูลสุขภาพตามสิทธิ์สำหรับผู้ป่วย โดยโรงพยาบาลยังดูแลเวชระเบียนในระบบต้นทาง'}
>
  <main>
    <section class="page-hero phr-hero" data-founder-copy>
      <div class="container phr-hero-grid">
        <div>
          <div class="eyebrow">HealthTAG / {en ? 'Personal Health Record (PHR)' : 'สมุดสุขภาพส่วนบุคคล (PHR)'}</div>
          <h1>{en ? 'Your health data, organized by purpose' : 'ข้อมูลสุขภาพของคุณ จัดเป็นหมวดตามการใช้งาน'}</h1>
          <p>{en ? 'Health data belongs to the patient. HealthTAG PHR presents the information available and permitted for that patient, organized by purpose with each data source kept visible.' : 'ข้อมูลสุขภาพเป็นของผู้ป่วย HealthTAG PHR แสดงข้อมูลที่มีอยู่และได้รับอนุญาตสำหรับผู้ป่วยคนนั้น โดยจัดตามวัตถุประสงค์การใช้งานและแสดงแหล่งที่มาของข้อมูล'}</p>
          <div class="actions">
            <a class="btn primary" href="https://phr.healthtag.io" target="_blank" rel="noopener noreferrer" aria-label={en ? 'Open the HealthTAG PHR website in a new tab' : 'เปิดเว็บไซต์ HealthTAG PHR ในแท็บใหม่'}>{en ? 'Open PHR website' : 'เปิดเว็บไซต์ PHR'} ↗</a>
            <a class="btn secondary" href={`${prefix}/how-it-works/`}>{en ? 'See how data reaches the PHR' : 'ดูเส้นทางข้อมูลมายัง PHR'} →</a>
          </div>
        </div>
        <div class="phr-map" aria-label={en ? 'PHR information map showing overview, health records, connected hospitals, and patient tools' : 'แผนผังข้อมูล PHR แสดงภาพรวม ข้อมูลสุขภาพ โรงพยาบาลที่เชื่อมต่อ และเครื่องมือสำหรับผู้ป่วย'}>
          <div class="map-title"><span>PHR</span><small>{en ? 'Authorized patient view' : 'มุมมองของผู้ป่วยตามสิทธิ์'}</small></div>
          <div class="map-grid">
            <div><b>{en ? 'Overview' : 'ภาพรวม'}</b><small>{en ? 'Clinical · biological · continuous' : 'คลินิก · ชีวภาพ · ต่อเนื่อง'}</small></div>
            <div><b>{en ? 'Records' : 'ข้อมูลสุขภาพ'}</b><small>{en ? 'Medicines · allergies · visits' : 'ยา · การแพ้ · การรับบริการ'}</small></div>
            <div><b>{en ? 'Connections' : 'การเชื่อมต่อ'}</b><small>{en ? 'Hospitals and providers' : 'โรงพยาบาลและผู้ให้บริการ'}</small></div>
            <div><b>{en ? 'Patient tools' : 'เครื่องมือผู้ป่วย'}</b><small>{en ? 'Reports · referral · emergency' : 'รายงาน · ส่งต่อ · ฉุกเฉิน'}</small></div>
          </div>
        </div>
      </div>
    </section>

    <section class="ownership-strip" data-founder-copy>
      <div class="container ownership-grid">
        <div><span class="mono">{en ? 'PATIENT OWNERSHIP' : 'ผู้ป่วยเป็นเจ้าของข้อมูล'}</span><h2>{en ? 'Patients control use; hospitals retain the original records' : 'ผู้ป่วยกำหนดการใช้ข้อมูล ส่วนโรงพยาบาลดูแลเวชระเบียนต้นฉบับ'}</h2></div>
        <p>{en ? 'Patients decide whether and how their health data may be used. Hospitals store and steward the original clinical records in source systems. The PHR displays the information permitted for each patient without moving those records.' : 'ผู้ป่วยกำหนดว่าจะยินยอมให้ใช้ข้อมูลสุขภาพของตนหรือไม่และใช้อย่างไร โรงพยาบาลจัดเก็บและดูแลเวชระเบียนต้นฉบับในระบบต้นทาง ส่วน PHR แสดงข้อมูลที่ผู้ป่วยได้รับอนุญาตให้เข้าถึงโดยไม่ย้ายเวชระเบียนออกจากโรงพยาบาล'}</p>
      </div>
    </section>

    <section class="section phr-capabilities">
      <div class="container">
        <div class="section-head phr-section-head">
          <span class="mono">{en ? 'PHR FEATURES' : 'การใช้งาน PHR'}</span>
          <h2>{en ? 'What patients can do in the PHR' : 'ผู้ป่วยใช้ PHR ทำอะไรได้บ้าง'}</h2>
        </div>
        <div class="capability-list">
          {capabilities.map((item) => (
            <article>
              <span class="capability-index">{item.index}</span>
              <div><h3>{item.title}</h3><p>{item.body}</p></div>
              <div class="capability-labels">{item.labels.map((label) => <span>{label}</span>)}</div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section phr-screens">
      <div class="container">
        <div class="screen-intro">
          <div>
            <span class="mono">{en ? 'PRODUCT SCREENS' : 'หน้าจอผลิตภัณฑ์'}</span>
            <h2>{en ? 'Explore the PHR' : 'ดูหน้าจอ PHR'}</h2>
          </div>
          <p>{en ? 'HealthTAG PHR organizes information into a health overview, medicines, special reports, hospital connections, and BioAge Analytics.' : 'HealthTAG PHR จัดข้อมูลเป็นภาพรวมสุขภาพ ยา รายงานสุขภาพ การเชื่อมต่อโรงพยาบาล และ BioAge Analytics'}</p>
        </div>
        <div class="screen-gallery">
          {screenshots.map((screen, index) => (
            <figure class:list={{ featured: screen.featured }}>
              <div class="screen-frame">
                <Image
                  src={screen.src}
                  alt={screen.alt}
                  width={screen.src.width}
                  height={screen.src.height}
                  widths={[640, 960, 1440]}
                  sizes={screen.featured ? '(max-width: 850px) 100vw, 1240px' : '(max-width: 850px) 100vw, 610px'}
                  format="webp"
                  quality={84}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{screen.title}</h3><p>{screen.body}</p></div></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="section phr-boundary">
      <div class="container boundary-grid">
        <div>
          <span class="mono">{en ? 'AVAILABLE INFORMATION' : 'ข้อมูลที่แสดงใน PHR'}</span>
          <h2>{en ? 'The PHR presents what is available and authorized' : 'PHR แสดงเฉพาะข้อมูลที่มีและได้รับอนุญาต'}</h2>
        </div>
        <div>
          <p>{en ? 'A category may be empty when no matching record is available. The information shown varies with the patient account, connected hospital or provider, authorization, and the data supplied by those systems.' : 'บางหมวดอาจไม่มีรายการเมื่อระบบต้นทางไม่มีข้อมูลที่ตรงกัน ข้อมูลที่แสดงจึงแตกต่างตามบัญชีผู้ป่วย โรงพยาบาลหรือผู้ให้บริการที่เชื่อมต่อ สิทธิ์การเข้าถึง และข้อมูลที่ระบบเหล่านั้นส่งมา'}</p>
          <a href={`${prefix}/trust/`}>{en ? 'Read about authorization and audit' : 'อ่านเรื่องการอนุญาตและการตรวจสอบย้อนหลัง'} →</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .phr-hero { padding-bottom: clamp(3.5rem, 8vw, 7rem); }
  .phr-hero-grid { display: grid; grid-template-columns: minmax(0, 1.02fr) minmax(22rem, .98fr); gap: clamp(2.5rem, 7vw, 7rem); align-items: center; }
  .phr-hero h1 { max-width: 16ch; overflow-wrap: anywhere; }
  .phr-hero p { max-width: 62ch; }
  .ownership-strip { padding: clamp(2.5rem, 5vw, 4rem) 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--mint); }
  .ownership-grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(2rem, 7vw, 7rem); align-items: start; }
  .ownership-grid .mono { display: block; margin-bottom: 1rem; color: var(--teal); }
  .ownership-grid h2 { margin: 0; max-width: 18ch; font-size: clamp(1.65rem, 3vw, 2.6rem); }
  .ownership-grid p { margin: 0; color: var(--ink); font-size: clamp(1rem, 1.4vw, 1.15rem); }
  .phr-map { position: relative; padding: 1rem; border: 1px solid var(--line); background: var(--white); }
  .phr-map::before { content: ''; position: absolute; inset: -12px 12px 12px -12px; z-index: -1; background: var(--mint); border: 1px solid color-mix(in srgb, var(--teal) 20%, transparent); }
  .map-title { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.2rem 1.3rem; border-bottom: 1px solid var(--line); }
  .map-title span { color: var(--teal); font: 700 clamp(2.5rem, 6vw, 5rem)/.85 'IBM Plex Sans', sans-serif; letter-spacing: -.08em; }
  .map-title small { color: var(--muted); text-align: right; }
  .map-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .map-grid > div { min-height: 8.5rem; padding: 1.25rem; display: flex; flex-direction: column; justify-content: flex-end; gap: .35rem; border-bottom: 1px solid var(--line); }
  .map-grid > div:nth-child(odd) { border-right: 1px solid var(--line); }
  .map-grid > div:nth-child(3), .map-grid > div:nth-child(4) { border-bottom: 0; }
  .map-grid b { font-size: 1.05rem; }
  .map-grid small { color: var(--muted); line-height: 1.45; }
  .phr-capabilities { background: var(--white); }
  .phr-section-head { max-width: 54rem; }
  .phr-section-head .mono, .phr-boundary .mono { display: block; margin-bottom: 1rem; color: var(--teal); }
  .capability-list { border-top: 1px solid var(--line); }
  .capability-list article { display: grid; grid-template-columns: 5rem minmax(0, 1.35fr) minmax(13rem, .65fr); gap: clamp(1rem, 3vw, 3rem); padding: 2.2rem 0; border-bottom: 1px solid var(--line); align-items: start; }
  .capability-index { color: var(--teal); font: 600 1rem/1 'IBM Plex Mono', monospace; }
  .capability-list h3 { margin: 0 0 .65rem; font-size: clamp(1.25rem, 2.4vw, 1.75rem); }
  .capability-list p { margin: 0; color: var(--muted); max-width: 68ch; }
  .capability-labels { display: flex; flex-wrap: wrap; gap: .5rem; }
  .capability-labels span { padding: .45rem .65rem; border: 1px solid var(--line); color: var(--ink); font: 500 .75rem/1.2 'IBM Plex Mono', monospace; }
  .phr-screens { background: var(--paper); }
  .screen-intro { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(18rem, .9fr); gap: clamp(2rem, 7vw, 7rem); align-items: end; margin-bottom: clamp(2.5rem, 6vw, 5rem); }
  .screen-intro .mono { display: block; margin-bottom: 1rem; color: var(--teal); }
  .screen-intro p { margin: 0 0 .35rem; color: var(--muted); max-width: 62ch; }
  .screen-gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 4vw, 4rem) clamp(1.25rem, 3vw, 2.5rem); }
  .screen-gallery figure { min-width: 0; margin: 0; }
