---
import Base from '../../layouts/Base.astro';
import type { Locale } from '../../data/site-content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const prefix = en ? '/en' : '';
const stages = en ? [
  ['01','Connect','Send HIS data to the hospital FHIR system through an IT script or HealthTAG FHIR Transformer.','interoperability'],
  ['02','Standardize','Use HL7 FHIR R4 so connected systems share the same data structure.','interoperability'],
  ['03','Identify','The identity linkage service connects each hospital-local patient identifier to a common identity reference.','phr'],
  ['04','Authorize','The authorization service checks whether an access request is valid for the 15-minute window defined from blockchain state.','trust'],
  ['05','Return a permitted response','After the check, the hospital source system can return the permitted FHIR response to the approved PHR or application.','phr'],
  ['06','Record','Write consent and access events to blockchain for later review. Clinical records remain in hospital systems.','trust']
] : [
  ['01','เชื่อมข้อมูล','ส่งข้อมูลจาก HIS เข้าสู่ระบบ FHIR ของโรงพยาบาล ผ่านสคริปต์ของทีม IT หรือ HealthTAG FHIR Transformer','interoperability'],
  ['02','ทำให้เป็นมาตรฐาน','ใช้ HL7 FHIR R4 เพื่อให้ระบบที่เชื่อมต่อกันใช้โครงสร้างข้อมูลเดียวกัน','interoperability'],
  ['03','เชื่อมตัวตน','ระบบเชื่อมตัวตนผู้ป่วยเชื่อมรหัสผู้ป่วยของแต่ละสถานพยาบาลกับตัวระบุกลาง เพื่อจับคู่ข้อมูลของบุคคลเดียวกัน','phr'],
  ['04','อนุญาตสิทธิ์','บริการตรวจสิทธิ์ตรวจว่าคำขออยู่ภายในช่วงเวลา 15 นาทีที่กำหนดจากสถานะบน blockchain หรือไม่','trust'],
  ['05','ส่งคำตอบตามสิทธิ์','หลังตรวจสิทธิ์แล้ว ระบบต้นทางของโรงพยาบาลจึงส่งคำตอบ FHIR ตามขอบเขตที่อนุญาตไปยัง PHR หรือแอปที่ได้รับสิทธิ์','phr'],
  ['06','บันทึกเหตุการณ์','บันทึกเหตุการณ์การให้ความยินยอมและการเข้าถึงบน blockchain เพื่อตรวจสอบภายหลัง โดยเวชระเบียนยังอยู่ในระบบโรงพยาบาล','trust']
];
const detailLabels: Record<string, string> = en ? {
  interoperability: 'Read about interoperability',
  phr: 'Explore PHR',
  trust: 'Read about consent and access',
} : {
  interoperability: 'อ่านเรื่องการเชื่อมโยงข้อมูล',
  phr: 'ดู PHR',
  trust: 'อ่านเรื่องความยินยอมและสิทธิ์',
};
---
<Base locale={locale} path="how-it-works" title={en ? 'How It Works | HealthTAG' : 'ระบบทำงานอย่างไร | HealthTAG'} description={en ? 'A conceptual flow from HIS ingestion and identity matching to authorization, a permitted response, and audit.' : 'ภาพรวมตั้งแต่การนำข้อมูลจาก HIS และการจับคู่ตัวตน ไปจนถึงการตรวจสิทธิ์ การส่งคำตอบตามสิทธิ์ และการตรวจสอบย้อนหลัง'}>
  <main>
    <section class="page-hero" data-founder-copy><div class="container"><div class="eyebrow">HealthTAG / {en ? 'How it works' : 'ระบบทำงานอย่างไร'}</div><h1>{en ? 'Six stages from HIS ingestion to audit' : 'จาก HIS ถึงการตรวจสอบย้อนหลังใน 6 ขั้น'}</h1><p>{en ? 'Patients control consent. Hospitals steward the source systems. HealthTAG provides identity and access infrastructure. The technical request sequence may differ between installations.' : 'ผู้ป่วยกำหนดความยินยอม โรงพยาบาลดูแลระบบต้นทาง และ HealthTAG จัดโครงสร้างพื้นฐานด้านตัวตนกับสิทธิ์เข้าถึง ส่วนลำดับคำขอทางเทคนิคอาจแตกต่างกันในแต่ละการติดตั้ง'}</p></div></section>
    <section class="section system-overview">
      <div class="container system-overview-grid">
        <div class="system-overview-copy">
          <span class="mono">{en ? 'SYSTEM BOUNDARIES' : 'ขอบเขตของระบบ'}</span>
          <h2>{en ? 'Clinical records stay with the hospital' : 'เวชระเบียนยังอยู่กับโรงพยาบาล'}</h2>
          <p>{en
            ? 'The hospital stewards its HIS and FHIR environment. Identity and authorization services support permitted exchange, while consent and access events go to the audit ledger.'
            : 'โรงพยาบาลดูแล HIS และระบบ FHIR ของตนเอง บริการเชื่อมตัวตนและตรวจสิทธิ์รองรับการแลกเปลี่ยนตามสิทธิ์ ส่วนเหตุการณ์ความยินยอมและการเข้าถึงเข้าสู่ประวัติตรวจสอบ'}</p>
          <p class="concept-note">{en
            ? 'The physical request sequence may differ between installations.'
            : 'แต่ละการติดตั้งอาจใช้ลำดับคำขอทางเทคนิคแตกต่างกัน'}</p>
        </div>
        <div class="topology-card" role="img" aria-label={en
          ? 'Conceptual architecture: an existing HIS uses a hospital IT script or FHIR Transformer to reach the hospital-stewarded FHIR system. An API Gateway and identity and authorization services protect permitted exchange to PHR applications. Consent and access events go to the audit ledger, while clinical records remain in hospital source systems.'
          : 'สถาปัตยกรรมเชิงแนวคิด: HIS เดิมใช้สคริปต์ของโรงพยาบาลหรือ FHIR Transformer เพื่อนำข้อมูลเข้าสู่ระบบ FHIR ที่โรงพยาบาลดูแล API Gateway และบริการเชื่อมตัวตนกับตรวจสิทธิ์ปกป้องการแลกเปลี่ยนตามสิทธิ์ไปยัง PHR เหตุการณ์การให้ความยินยอมและการเข้าถึงเข้าสู่ประวัติตรวจสอบ ส่วนเวชระเบียนยังอยู่ในระบบต้นทางของโรงพยาบาล'}>
          <div class="boundary-label">{en ? 'Conceptual · hospital-stewarded source environment' : 'ภาพเชิงแนวคิด · ระบบต้นทางที่โรงพยาบาลดูแล'}</div>
          <div class="topology-ingress"><div class="topology-node"><strong>Existing HIS</strong><small>{en ? 'Hospital source system' : 'ระบบต้นทางของโรงพยาบาล'}</small></div><div class="topology-split"><span>↓</span><div><b>IT Script</b><b>FHIR Transformer</b></div><span>↓</span></div></div>
          <div class="topology-fhir"><strong>FHIR System</strong><span>HL7 FHIR R4</span><em>{en ? 'Hospital stewardship' : 'โรงพยาบาลดูแล'}</em></div>
          <div class="topology-edge"><div><strong>API Gateway</strong><small>{en ? 'FHIR API protection' : 'ปกป้อง FHIR API'}</small></div><div><strong>{en ? 'Identity and authorization service' : 'บริการเชื่อมตัวตนและตรวจสิทธิ์'}</strong><small>{en ? 'Identity · Authorization' : 'ตัวตน · การอนุญาต'}</small></div></div>
          <div class="topology-out">↓ {en ? 'Permitted exchange' : 'แลกเปลี่ยนตามสิทธิ์'} ↓</div>
          <div class="topology-dest"><span>PHR</span><span>{en ? 'Permitted apps' : 'แอปที่ได้รับสิทธิ์'}</span></div>
          <div class="topology-audit"><strong>{en ? 'Consent/access events → audit ledger' : 'เหตุการณ์การให้ความยินยอม/การเข้าถึง → ประวัติตรวจสอบ'}</strong><small>{en ? 'Clinical records remain in hospital source systems' : 'เวชระเบียนยังอยู่ในระบบต้นทางของโรงพยาบาล'}</small></div>
        </div>
      </div>
    </section>
    <section class="section flow-section"><div class="container"><ol class="flow" aria-label={en ? 'Six stages of HealthTAG exchange' : 'หกขั้นของการแลกเปลี่ยนข้อมูล HealthTAG'}>{stages.map(([number, title, body, slug], index) => <li class:list={[index > 2 && 'permission-stage']}><div class="stage-number mono">{number}</div><div class="stage-copy"><h2>{title}</h2><p>{body}</p><a href={`${prefix}/${slug}/`}>{detailLabels[slug]} <span aria-hidden="true">→</span></a></div></li>)}</ol></div></section>
    <section class="section decision-section" data-founder-copy>
      <div class="container">
        <div class="section-head"><span class="mono">{en ? 'TRUST DECISIONS' : 'ลำดับการตัดสินใจเรื่องสิทธิ์'}</span><h2>{en ? 'Consent comes before the access decision' : 'ความยินยอมมาก่อนการตัดสินใจให้เข้าถึง'}</h2><p>{en ? 'Consent states the patient’s choice. Authorization evaluates a specific request. A permitted response comes from the hospital source system, and the access event remains available for audit.' : 'ความยินยอมแสดงเจตนาของผู้ป่วย การอนุญาตสิทธิ์ใช้ประเมินคำขอแต่ละครั้ง ระบบต้นทางของโรงพยาบาลส่งคำตอบตามขอบเขตที่อนุญาต และเก็บเหตุการณ์การเข้าถึงไว้ตรวจสอบย้อนหลัง'}</p></div>
        <ol class="decision-path" aria-label={en ? 'Consent, authorization, permitted response, and audit' : 'ความยินยอม การอนุญาตสิทธิ์ คำตอบตามสิทธิ์ และการตรวจสอบย้อนหลัง'}>
          <li><span>01</span><b>{en ? 'Consent' : 'ความยินยอม'}</b><small>{en ? 'The patient defines whether and how data may be used.' : 'ผู้ป่วยกำหนดว่าจะอนุญาตให้ใช้ข้อมูลหรือไม่และอย่างไร'}</small></li>
          <li><span>02</span><b>{en ? 'Authorization' : 'การอนุญาตสิทธิ์'}</b><small>{en ? 'The system evaluates the request against the applicable permission.' : 'ระบบประเมินคำขอกับสิทธิ์ที่ใช้ในขณะนั้น'}</small></li>
          <li><span>03</span><b>{en ? 'Permitted response' : 'คำตอบตามสิทธิ์'}</b><small>{en ? 'The hospital source returns only the response allowed for that request.' : 'ระบบต้นทางของโรงพยาบาลส่งเฉพาะคำตอบที่คำขอนั้นได้รับอนุญาต'}</small></li>
          <li><span>04</span><b>{en ? 'Audit' : 'ตรวจสอบย้อนหลัง'}</b><small>{en ? 'Consent and access events are recorded for later review.' : 'บันทึกเหตุการณ์ความยินยอมและการเข้าถึงไว้ตรวจสอบภายหลัง'}</small></li>
        </ol>
      </div>
    </section>
    <section class="section boundaries"><div class="container"><div class="section-head"><h2>{en ? 'Patients own the data. Hospitals keep the records. HealthTAG supports the exchange.' : 'ผู้ป่วยเป็นเจ้าของข้อมูล โรงพยาบาลดูแลเวชระเบียน และ HealthTAG รองรับการแลกเปลี่ยน'}</h2></div><div class="boundary-notes"><p><b>{en ? 'Clinical records:' : 'เวชระเบียน:'}</b> {en ? 'stored and stewarded in hospital source systems.' : 'จัดเก็บและดูแลในระบบต้นทางของโรงพยาบาล'}</p><p><b>{en ? 'Authorization:' : 'การอนุญาตสิทธิ์:'}</b> {en ? 'checked for a defined access window.' : 'ตรวจสอบตามช่วงเวลาการเข้าถึงที่กำหนด'}</p><p><b>{en ? 'Blockchain:' : 'Blockchain:'}</b> {en ? 'records consent and access events.' : 'บันทึกเหตุการณ์การให้ความยินยอมและการเข้าถึง'}</p></div></div></section>
  </main>
</Base>
<style>
  .system-overview { background: #eef5f2; }
  .system-overview-grid { display: grid; grid-template-columns: minmax(0, .78fr) minmax(30rem, 1.22fr); gap: clamp(2.5rem, 7vw, 6.5rem); align-items: center; }
  .system-overview-copy .mono { display: block; margin-bottom: 1rem; color: var(--teal); }
  .page-hero p { color: var(--muted); font-size: 1.16rem; line-height: 1.7; }
  .system-overview-copy h2 { font-size: clamp(2.2rem, 4vw, 4rem); line-height: 1.08; letter-spacing: -.045em; }
  .system-overview-copy p { color: var(--muted); font-size: 1rem; }
  .system-overview-copy .concept-note { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); font-size: .88rem; }
  .flow-section { background: #102f36; color: var(--paper); } .flow { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(6, 1fr); position: relative; } .flow:before { content: ''; position: absolute; top: 25px; left: 5%; right: 5%; border-top: 1px solid rgba(117,211,200,.55); } .flow li { min-width: 0; position: relative; padding: 0 14px 22px; border-left: 1px solid rgba(221,243,235,.17); } .flow li:first-child { border-left: 0; } .stage-number { display: inline-grid; place-items: center; width: 51px; height: 51px; border-radius: 50%; border: 1px solid #75d3c8; background: #102f36; color: #9ae3da; position: relative; z-index: 1; font-size: .72rem; } .stage-copy { margin-top: 38px; } h2 { margin: 0; font-size: 1.3rem; line-height: 1.25; letter-spacing: -.025em; } p { margin: 10px 0 0; color: #bdd0d0; font-size: .86rem; line-height: 1.55; } .stage-copy a { display: inline-block; margin-top: 18px; color: #9ae3da; font-size: .8rem; font-weight: 600; } .permission-stage .stage-number { border-color: #e1a458; color: #f1c28d; }
  .decision-section { background: var(--white); } .decision-section .section-head .mono { display: block; margin-bottom: 1rem; color: var(--teal); } .decision-section .section-head p { color: var(--muted); font-size: 1rem; } .decision-path { margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); list-style: none; border-top: 1px solid var(--line); } .decision-path li { min-width: 0; padding: 24px 24px 0; border-left: 1px solid var(--line); } .decision-path li:first-child { padding-left: 0; border-left: 0; } .decision-path span { display: block; margin-bottom: 14px; color: var(--amber-ink); font: 600 .75rem/1 'IBM Plex Mono', ui-monospace, monospace; } .decision-path b, .decision-path small { display: block; } .decision-path small { margin-top: 8px; color: var(--muted); line-height: 1.55; }
  .boundaries { background: var(--mint); } .boundaries .section-head p { color: var(--ink); font-size: 1rem; } .boundary-notes { display: grid; grid-template-columns: repeat(3,1fr); border-top: 1px solid #a7cec7; } .boundary-notes p { margin: 0; padding: 20px; border-right: 1px solid #a7cec7; color: var(--ink); } .boundary-notes p:first-child { padding-left: 0; } .boundary-notes p:last-child { border: 0; } @media (max-width: 980px) { .system-overview-grid { grid-template-columns: 1fr; } .topology-card { max-width: 44rem; } .flow { grid-template-columns: repeat(3,1fr); gap: 25px 0; } .flow:before { display: none; } .flow li { border-top: 1px solid rgba(221,243,235,.17); padding-top: 15px; } .flow li:nth-child(3n + 1) { border-left: 0; } .stage-copy { margin-top: 18px; } .decision-path { grid-template-columns: repeat(2, 1fr); } .decision-path li:nth-child(3) { padding-left: 0; border-left: 0; } } @media (max-width: 620px) { .flow, .decision-path { grid-template-columns: 1fr; } .flow li { display: grid; grid-template-columns: 58px 1fr; gap: 16px; border-left: 0; } .stage-copy { margin-top: 5px; } .decision-path li, .decision-path li:first-child, .decision-path li:nth-child(3) { padding: 20px 0; border-top: 1px solid var(--line); border-left: 0; } .boundary-notes { grid-template-columns: 1fr; } .boundary-notes p, .boundary-notes p:first-child { padding: 18px 0; border-right: 0; border-bottom: 1px solid #a7cec7; } .boundary-notes p:last-child { border-bottom: 0; } }
</style>
