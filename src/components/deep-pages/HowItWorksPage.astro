---
import Base from '../../layouts/Base.astro';
import type { Locale } from '../../data/site-content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const prefix = en ? '/en' : '';
const stages = en ? [
  ['01','Connect','Send HIS data to the hospital FHIR system through an IT script or HealthTAG FHIR Transformer.','interoperability'],
  ['02','Standardize','Use HL7 FHIR R4 so connected systems share the same data structure.','interoperability'],
  ['03','Identify','Link each hospital patient ID to PromptCare ID so records can be matched to the same person.','phr'],
  ['04','Authorize','Hospital API checks whether an access request is valid for the 15-minute window defined from blockchain state.','trust'],
  ['05','Exchange','Send authorized FHIR data to the PHR or another approved application.','phr'],
  ['06','Record','Write consent and access events to blockchain for later review. Clinical records remain in hospital systems.','trust']
] : [
  ['01','เชื่อมข้อมูล','ส่งข้อมูลจาก HIS เข้าสู่ระบบ FHIR ของโรงพยาบาล ผ่านสคริปต์ของทีม IT หรือ HealthTAG FHIR Transformer','interoperability'],
  ['02','ทำให้เป็นมาตรฐาน','ใช้ HL7 FHIR R4 เพื่อให้ระบบที่เชื่อมต่อกันใช้โครงสร้างข้อมูลเดียวกัน','interoperability'],
  ['03','เชื่อมตัวตน','เชื่อมรหัสผู้ป่วยของแต่ละโรงพยาบาลกับ PromptCare ID เพื่อจับคู่ข้อมูลของคนเดียวกัน','phr'],
  ['04','อนุญาตสิทธิ์','Hospital API ตรวจว่าคำขอมีสิทธิ์ภายในช่วงเวลา 15 นาทีที่กำหนดจากสถานะบน blockchain หรือไม่','trust'],
  ['05','แลกเปลี่ยน','ส่งข้อมูล FHIR ที่ได้รับอนุญาตไปยัง PHR หรือแอปอื่นที่ได้รับสิทธิ์','phr'],
  ['06','บันทึกเหตุการณ์','บันทึกเหตุการณ์การให้ความยินยอมและการเข้าถึงบน blockchain เพื่อตรวจสอบภายหลัง โดยเวชระเบียนยังอยู่ในระบบโรงพยาบาล','trust']
];
---
<Base locale={locale} path="how-it-works" title={en ? 'How It Works | HealthTAG' : 'ระบบทำงานอย่างไร | HealthTAG'} description={en ? 'Six stages from HIS ingestion and identity matching to authorized exchange and audit.' : '6 ขั้นตั้งแต่การนำข้อมูลจาก HIS และการจับคู่ตัวตน ไปจนถึงการแลกเปลี่ยนตามสิทธิ์และตรวจสอบย้อนหลัง'}>
  <main>
    <section class="page-hero"><div class="container"><div class="eyebrow">HealthTAG / {en ? 'How it works' : 'ระบบทำงานอย่างไร'}</div><h1>{en ? 'Six stages from HIS ingestion to audit' : 'จาก HIS ถึงการตรวจสอบย้อนหลังใน 6 ขั้น'}</h1><p>{en ? 'The six stages separate the responsibility of each system. The physical request sequence depends on the installation.' : 'ทั้ง 6 ขั้นแยกหน้าที่ของแต่ละระบบ ส่วนลำดับคำขอทางเทคนิคขึ้นอยู่กับการติดตั้งแต่ละแห่ง'}</p></div></section>
    <section class="section flow-section"><div class="container"><ol class="flow" aria-label={en ? 'Six stages of HealthTAG exchange' : 'หกขั้นของการแลกเปลี่ยนข้อมูล HealthTAG'}>{stages.map(([number, title, body, slug], index) => <li class:list={[index > 2 && 'permission-stage']}><div class="stage-number mono">{number}</div><div class="stage-copy"><h2>{title}</h2><p>{body}</p><a href={`${prefix}/${slug}/`}>{en ? 'Read more' : 'ดูรายละเอียด'} <span aria-hidden="true">→</span></a></div></li>)}</ol></div></section>
    <section class="section boundaries"><div class="container"><div class="section-head"><h2>{en ? 'Data, permission, and audit have different roles' : 'ข้อมูล สิทธิ์ และการตรวจสอบมีหน้าที่ต่างกัน'}</h2><p>{en ? 'Separating these responsibilities makes it clear where records are stored, who checks access, and what is written to blockchain.' : 'การแยกหน้าที่ช่วยให้เห็นชัดว่าเวชระเบียนอยู่ที่ใด ใครตรวจสิทธิ์ และข้อมูลใดถูกบันทึกบน blockchain'}</p></div><div class="boundary-notes"><p><b>{en ? 'Clinical data:' : 'ข้อมูลทางคลินิก:'}</b> {en ? 'stored in hospital-controlled FHIR systems.' : 'เก็บในระบบ FHIR ที่โรงพยาบาลควบคุม'}</p><p><b>{en ? 'Permission:' : 'สิทธิ์:'}</b> {en ? 'checked for a defined access window.' : 'ตรวจสอบตามช่วงเวลาการเข้าถึงที่กำหนด'}</p><p><b>{en ? 'Blockchain:' : 'Blockchain:'}</b> {en ? 'records consent and access events.' : 'บันทึกเหตุการณ์การให้ความยินยอมและการเข้าถึง'}</p></div></div></section>
  </main>
</Base>
<style>
  .flow-section { background: #102f36; color: var(--paper); } .flow { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(6, 1fr); position: relative; } .flow:before { content: ''; position: absolute; top: 25px; left: 5%; right: 5%; border-top: 1px solid rgba(117,211,200,.55); } .flow li { min-width: 0; position: relative; padding: 0 14px 22px; border-left: 1px solid rgba(221,243,235,.17); } .flow li:first-child { border-left: 0; } .stage-number { display: inline-grid; place-items: center; width: 51px; height: 51px; border-radius: 50%; border: 1px solid #75d3c8; background: #102f36; color: #9ae3da; position: relative; z-index: 1; font-size: .72rem; } .stage-copy { margin-top: 38px; } h2 { margin: 0; font-size: 1.3rem; line-height: 1.25; letter-spacing: -.025em; } p { margin: 10px 0 0; color: #bdd0d0; font-size: .86rem; line-height: 1.55; } .stage-copy a { display: inline-block; margin-top: 18px; color: #9ae3da; font-size: .8rem; font-weight: 600; } .permission-stage .stage-number { border-color: #e1a458; color: #f1c28d; } .boundaries { background: var(--mint); } .boundary-notes { display: grid; grid-template-columns: repeat(3,1fr); border-top: 1px solid #a7cec7; } .boundary-notes p { margin: 0; padding: 20px; border-right: 1px solid #a7cec7; color: var(--ink); } .boundary-notes p:first-child { padding-left: 0; } .boundary-notes p:last-child { border: 0; } @media (max-width: 980px) { .flow { grid-template-columns: repeat(3,1fr); gap: 25px 0; } .flow:before { display: none; } .flow li { border-top: 1px solid rgba(221,243,235,.17); padding-top: 15px; } .flow li:nth-child(3n + 1) { border-left: 0; } .stage-copy { margin-top: 18px; } } @media (max-width: 620px) { .flow { grid-template-columns: 1fr; } .flow li { display: grid; grid-template-columns: 58px 1fr; gap: 16px; border-left: 0; } .stage-copy { margin-top: 5px; } .boundary-notes { grid-template-columns: 1fr; } .boundary-notes p, .boundary-notes p:first-child { padding: 18px 0; border-right: 0; border-bottom: 1px solid #a7cec7; } .boundary-notes p:last-child { border-bottom: 0; } }
</style>
