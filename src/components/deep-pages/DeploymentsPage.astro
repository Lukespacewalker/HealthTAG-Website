---
import Base from '../../layouts/Base.astro';
import type { Locale } from '../../data/site-content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const prefix = en ? '/en' : '';
const sirirajEvidence = en ? 'https://www2.si.mahidol.ac.th/en/news-events/siriraj-jointly-launched-siriraj-world-class-5g-smart-hospital-with-nbtc-huawei/' : 'https://si.mahidol.ac.th/th/hotnewsdetail.asp?hn_id=2728';
const muSites = en
  ? ['Faculty of Medicine Siriraj Hospital', 'Siriraj Piyamaharajkarun Hospital', 'Golden Jubilee Medical Center', 'Faculty of Medicine Ramathibodi Hospital', 'Faculty of Tropical Medicine']
  : ['คณะแพทยศาสตร์ศิริราชพยาบาล', 'โรงพยาบาลศิริราช ปิยมหาราชการุณย์', 'ศูนย์การแพทย์กาญจนาภิเษก', 'คณะแพทยศาสตร์โรงพยาบาลรามาธิบดี', 'คณะเวชศาสตร์เขตร้อน'];
---
<Base locale={locale} path="deployments" title={en ? 'Deployments | HealthTAG' : 'การใช้งานจริง | HealthTAG'} description={en ? 'Confirmed HealthTAG deployments at Siriraj, Khian Sa, and five institutions in MU Health Data Network.' : 'การติดตั้ง HealthTAG ที่ยืนยันแล้วในศิริราช เคียนซา และ 5 หน่วยงานใน MU Health Data Network'}>
  <main>
    <section class="page-hero"><div class="container"><div class="eyebrow">HealthTAG / {en ? 'Deployments' : 'การใช้งานจริง'}</div><h1>{en ? 'Different institutions use HealthTAG through different deployment models' : 'แต่ละหน่วยงานใช้ HealthTAG ผ่านรูปแบบการติดตั้งที่ต่างกัน'}</h1><p>{en ? 'Siriraj uses a hospital-developed integration script. Khian Sa uses HealthTAG FHIR Transformer. MU Health Data Network connects five live institutions and 60,000 active users.' : 'ศิริราชใช้สคริปต์เชื่อมระบบที่ทีมโรงพยาบาลพัฒนาเอง เคียนซาใช้ HealthTAG FHIR Transformer ส่วน MU Health Data Network เชื่อม 5 หน่วยงานที่เปิดใช้งานจริงและมีผู้ใช้งานจริง 60,000 คน'}</p></div></section>
    <section class="section" id="siriraj"><div class="container case-study"><div class="case-index"><span class="mono">CASE 01</span><h2>Siriraj<br/>5G Smart Hospital</h2><span class="route-mark">HIS → {en ? 'Hospital IT script' : 'สคริปต์ของทีม IT โรงพยาบาล'} → FHIR</span><a class="case-cta" href={`${prefix}/contact/`}>{en ? 'Discuss integration for a large hospital' : 'ปรึกษาการเชื่อมต่อสำหรับโรงพยาบาลขนาดใหญ่'} →</a></div><div class="case-facts"><article><span class="source-label">{en ? 'Published programme information' : 'ข้อมูลโครงการที่เผยแพร่'}</span><p>{en ? 'Siriraj published nine Smart Hospital subprojects. Permission-based Blockchain for Personal Health Record was one of them. The announcement does not mention HealthTAG.' : 'ศิริราชเผยแพร่โครงการย่อย Smart Hospital 9 โครงการ โดย Permission-based Blockchain for Personal Health Record เป็นหนึ่งในนั้น ประกาศฉบับนี้ไม่ได้เอ่ยชื่อ HealthTAG'}</p><a href={sirirajEvidence} target="_blank" rel="noopener noreferrer">{en ? 'Read the Siriraj announcement' : 'อ่านประกาศจากศิริราช'} ↗</a></article><article><span class="source-label confirmed">{en ? 'Implementation information from HealthTAG' : 'ข้อมูลการติดตั้งจาก HealthTAG'}</span><p>{en ? 'HealthTAG says it participated in the PHR subproject. Siriraj IT uses its own HIS-to-FHIR script to send data to the FHIR Server.' : 'HealthTAG ระบุว่าเข้าร่วมโครงการย่อยด้าน PHR ส่วนทีม IT ศิริราชใช้ HIS-to-FHIR script ของตนเองส่งข้อมูลเข้า FHIR Server'}</p><a href={`${prefix}/interoperability/`}>{en ? 'Compare the two ingestion methods' : 'เปรียบเทียบวิธีนำข้อมูลเข้าสองแบบ'} →</a></article></div></div></section>
    <section class="section khian" id="khian-sa"><div class="container case-study"><div class="case-index"><span class="mono">CASE 02</span><h2>{en ? 'Khian Sa Hospital' : 'โรงพยาบาลเคียนซา'}</h2><span class="route-mark">HIS → HealthTAG FHIR Transformer → FHIR R4</span><a class="case-cta" href={`${prefix}/contact/`}>{en ? 'Discuss integration for a community hospital' : 'ปรึกษาการเชื่อมต่อสำหรับโรงพยาบาลชุมชน'} →</a></div><div class="case-facts"><article><span class="source-label confirmed">{en ? 'Implementation information from HealthTAG' : 'ข้อมูลการติดตั้งจาก HealthTAG'}</span><p>{en ? 'Khian Sa Hospital has used HealthTAG FHIR Transformer since 1 June 2025 to map selected HIS data to FHIR R4.' : 'โรงพยาบาลเคียนซาเริ่มใช้งาน HealthTAG FHIR Transformer เมื่อ 1 มิถุนายน 2025 เพื่อแปลงข้อมูล HIS ที่เลือกเป็น FHIR R4'}</p><a href={`${prefix}/contact/`}>{en ? 'Discuss the technical architecture' : 'สอบถามข้อมูลสถาปัตยกรรม'} →</a></article><article class="scope"><span class="source-label">{en ? 'FHIR resources in this installation' : 'FHIR resources ในการติดตั้งนี้'}</span><div class="resources">{['Patient','AllergyIntolerance','Encounter','MedicationDispense'].map((resource) => <span class="mono">{resource}</span>)}</div><p>{en ? 'Khian Sa uses these four FHIR resources with a FHIR Server, API Gateway, and authorization service.' : 'เคียนซาใช้ FHIR resources ทั้ง 4 ประเภทร่วมกับ FHIR Server, API Gateway และบริการตรวจสิทธิ์'}</p></article></div></div></section>
    <section class="section mu-network" id="mu-health-data-network"><div class="container case-study"><div class="case-index"><span class="mono">CASE 03</span><h2>MU Health<br/>Data Network</h2><span class="route-mark">5 {en ? 'live institutions' : 'หน่วยงานที่เปิดใช้งานจริง'} · 60,000 {en ? 'active users' : 'ผู้ใช้งานจริง'}</span><a class="case-cta" href={`${prefix}/contact/`}>{en ? 'Discuss a multi-institution network' : 'ปรึกษาการเชื่อมระบบหลายหน่วยงาน'} →</a></div><div class="case-facts"><article><span class="source-label confirmed">{en ? 'Deployment information from HealthTAG' : 'ข้อมูลการติดตั้งจาก HealthTAG'}</span><p>{en ? 'HealthTAG is the technology partner for MU Health Data Network and MU Health Wallet. Five Mahidol University institutions are live in 2026, serving 60,000 active personnel and student users.' : 'HealthTAG เป็น Technology Partner ของ MU Health Data Network และ MU Health Wallet โดยมี 5 หน่วยงานของมหาวิทยาลัยมหิดลเปิดใช้งานจริงในปี 2569 รองรับบุคลากรและนักศึกษาที่ใช้งานจริง 60,000 คน'}</p><ul class="site-list">{muSites.map((site) => <li>{site}</li>)}</ul></article><article><span class="source-label confirmed">{en ? 'Funding and infrastructure' : 'ทุนและโครงสร้างพื้นฐาน'}</span><p>{en ? 'The project received a THB 30 million grant from BTFP through Mahidol University. Equipment was delivered in August 2026. True Corporation and Huawei support the project infrastructure.' : 'โครงการได้รับทุน 30 ล้านบาทจาก กทปส. ผ่านมหาวิทยาลัยมหิดล และส่งมอบครุภัณฑ์แล้วในเดือนสิงหาคม 2569 โดย True Corporation และ Huawei สนับสนุนโครงสร้างพื้นฐานของโครงการ'}</p><a href={`${prefix}/network/`}>{en ? 'See funders and infrastructure supporters' : 'ดูผู้ให้ทุนและผู้สนับสนุนโครงสร้างพื้นฐาน'} →</a></article></div></div></section>
  </main>
</Base>
<style>
  .case-study { display: grid; grid-template-columns: .75fr 1.25fr; gap: clamp(35px,7vw,100px); } .case-index { padding-top: 4px; } .mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: .69rem; letter-spacing: .07em; color: var(--teal); } .case-index h2 { margin: 14px 0 20px; font-size: clamp(2.35rem,4.6vw,4.5rem); line-height: .98; letter-spacing: -.06em; } .route-mark { display: inline-block; border-left: 3px solid var(--teal); padding: 8px 0 8px 13px; color: var(--muted); font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: .76rem; line-height: 1.6; } .case-cta { display: block; max-width: 290px; margin-top: 24px; color: var(--teal); font-size: .9rem; font-weight: 600; } .case-facts { display: grid; gap: 14px; } .case-facts article { padding: 26px; border: 1px solid var(--line); border-radius: 13px; background: var(--white); } .source-label { display: inline-block; color: var(--muted); font-size: .71rem; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; } .source-label.confirmed { color: var(--teal); } .case-facts p { margin: 15px 0 0; color: var(--muted); } .case-facts a { display: inline-block; margin-top: 18px; color: var(--teal); font-size: .9rem; font-weight: 600; } .khian { background: var(--mint); } .khian .case-facts article { background: rgba(255,255,255,.7); } .mu-network { background: #eef3f1; } .resources { display: grid; grid-template-columns: repeat(4,1fr); gap: 8px; margin: 16px 0 0; } .resources span { padding: 10px 9px; border: 1px solid #a7cec7; border-radius: 7px; color: var(--ink); background: var(--white); overflow-wrap: anywhere; } .scope p { font-size: .86rem; } .site-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px 22px; margin: 20px 0 0; padding: 18px 0 0 18px; border-top: 1px solid var(--line); color: var(--ink); font-size: .88rem; } @media (max-width: 800px) { .case-study { grid-template-columns: 1fr; gap: 30px; } .resources,.site-list { grid-template-columns: 1fr 1fr; } } @media (max-width: 520px) { .site-list { grid-template-columns: 1fr; } }
</style>
