---
import Base from '../../layouts/Base.astro';
import type { Locale } from '../../data/site-content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const prefix = en ? '/en' : '';
const sirirajEvidence = en ? 'https://www2.si.mahidol.ac.th/en/news-events/siriraj-jointly-launched-siriraj-world-class-5g-smart-hospital-with-nbtc-huawei/' : 'https://si.mahidol.ac.th/th/hotnewsdetail.asp?hn_id=2728';
---
<Base locale={locale} path="deployments" title={en ? 'Deployments | HealthTAG' : 'การใช้งานจริง | HealthTAG'} description={en ? 'How Siriraj and Khian Sa send HIS data to FHIR through different integration methods.' : 'วิธีที่ศิริราชและเคียนซานำข้อมูลจาก HIS เข้าสู่ FHIR ด้วยแนวทางที่ต่างกัน'}>
  <main>
    <section class="page-hero"><div class="container"><div class="eyebrow">HealthTAG / {en ? 'Deployments' : 'การติดตั้งใช้งาน'}</div><h1>{en ? 'Siriraj and Khian Sa use different ingestion paths' : 'ศิริราชและเคียนซาใช้วิธีนำข้อมูลเข้าแตกต่างกัน'}</h1><p>{en ? 'Siriraj uses a script developed by its hospital IT team. Khian Sa uses HealthTAG FHIR Transformer. The two cases describe separate installations.' : 'ศิริราชใช้สคริปต์ที่ทีม IT ของโรงพยาบาลพัฒนาเอง ส่วนเคียนซาใช้ HealthTAG FHIR Transformer โดยเป็นการติดตั้งคนละกรณี'}</p></div></section>
    <section class="section"><div class="container case-study"><div class="case-index"><span class="mono">CASE 01</span><h2>Siriraj<br/>5G Smart Hospital</h2><span class="route-mark">HIS → {en ? 'Hospital IT script' : 'สคริปต์ของทีม IT โรงพยาบาล'} → FHIR</span></div><div class="case-facts"><article><span class="source-label">{en ? 'Published programme information' : 'ข้อมูลโครงการที่เผยแพร่'}</span><p>{en ? 'Siriraj published nine Smart Hospital subprojects. Permission-based Blockchain for Personal Health Record was one of them. The announcement does not mention HealthTAG.' : 'ศิริราชเผยแพร่โครงการย่อย Smart Hospital 9 โครงการ โดย Permission-based Blockchain for Personal Health Record เป็นหนึ่งในนั้น ประกาศฉบับนี้ไม่ได้เอ่ยชื่อ HealthTAG'}</p><a href={sirirajEvidence} target="_blank" rel="noopener noreferrer">{en ? 'Read the Siriraj announcement' : 'อ่านประกาศจากศิริราช'} ↗</a></article><article><span class="source-label confirmed">{en ? 'Implementation information from HealthTAG' : 'ข้อมูลการติดตั้งจาก HealthTAG'}</span><p>{en ? 'HealthTAG says it participated in the PHR subproject. Siriraj IT uses its own HIS-to-FHIR script to send data to the FHIR Server.' : 'HealthTAG ระบุว่าเข้าร่วมโครงการย่อยด้าน PHR ส่วนทีม IT ศิริราชใช้ HIS-to-FHIR script ของตนเองส่งข้อมูลเข้า FHIR Server'}</p><a href={`${prefix}/interoperability/`}>{en ? 'Compare the two ingestion methods' : 'เปรียบเทียบวิธีนำข้อมูลเข้าสองแบบ'} →</a></article></div></div></section>
    <section class="section khian"><div class="container case-study"><div class="case-index"><span class="mono">CASE 02</span><h2>{en ? 'Khian Sa Hospital' : 'โรงพยาบาลเคียนซา'}</h2><span class="route-mark">HIS → HealthTAG FHIR Transformer → FHIR R4</span></div><div class="case-facts"><article><span class="source-label confirmed">{en ? 'Implementation information from HealthTAG' : 'ข้อมูลการติดตั้งจาก HealthTAG'}</span><p>{en ? 'Khian Sa Hospital uses HealthTAG FHIR Transformer to map selected HIS data to FHIR R4.' : 'โรงพยาบาลเคียนซาใช้ HealthTAG FHIR Transformer แปลงข้อมูล HIS ที่เลือกเป็น FHIR R4'}</p><a href="https://health-tag-document.suttisak-lukesp.workers.dev/guides/data-source-node/architecture/" target="_blank" rel="noopener noreferrer">{en ? 'Read the Hospital API, Kong, and HAPI architecture' : 'อ่านสถาปัตยกรรม Hospital API, Kong และ HAPI'} ↗</a></article><article class="scope"><span class="source-label">{en ? 'FHIR resources in this installation' : 'FHIR resources ในการติดตั้งนี้'}</span><div class="resources">{['Patient','AllergyIntolerance','Encounter','MedicationDispense'].map((resource) => <span class="mono">{resource}</span>)}</div><p>{en ? 'This list applies to the Khian Sa installation. The linked System Architecture page describes the shared Hospital API, Kong, and HAPI components.' : 'รายการนี้เป็นข้อมูลของการติดตั้งที่เคียนซา ส่วนหน้า System Architecture อธิบาย Hospital API, Kong และ HAPI ที่ใช้ร่วมกันในสถาปัตยกรรม'}</p></article></div></div></section>
    <section class="section reading-note"><div class="container"><div><span class="mono">{en ? 'RELATIONSHIPS' : 'ความสัมพันธ์'}</span><h2>{en ? 'Deployment and network relationships are listed separately' : 'การติดตั้งและเครือข่ายแสดงแยกจากกัน'}</h2></div><p>{en ? 'Programme participation, network status, awards, and public collaborations appear on the Evidence and Network pages with their own labels.' : 'การเข้าร่วมโครงการ สถานะเครือข่าย รางวัล และความร่วมมือสาธารณะ แสดงไว้ในหน้าหลักฐานและเครือข่ายพร้อมป้ายกำกับของแต่ละประเภท'}</p><a class="btn secondary" href={`${prefix}/evidence/`}>{en ? 'Review evidence & sources' : 'ดูหลักฐานและแหล่งข้อมูล'}</a></div></section>
  </main>
</Base>
<style>
  .case-study { display: grid; grid-template-columns: .75fr 1.25fr; gap: clamp(35px,7vw,100px); } .case-index { padding-top: 4px; } .mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: .69rem; letter-spacing: .07em; color: var(--teal); } .case-index h2 { margin: 14px 0 20px; font-size: clamp(2.35rem,4.6vw,4.5rem); line-height: .98; letter-spacing: -.06em; } .route-mark { display: inline-block; border-left: 3px solid var(--teal); padding: 8px 0 8px 13px; color: var(--muted); font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: .76rem; line-height: 1.6; } .case-facts { display: grid; gap: 14px; } .case-facts article { padding: 26px; border: 1px solid var(--line); border-radius: 13px; background: var(--white); } .source-label { display: inline-block; color: var(--muted); font-size: .71rem; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; } .source-label.confirmed { color: var(--teal); } .case-facts p { margin: 15px 0 0; color: var(--muted); } .case-facts a { display: inline-block; margin-top: 18px; color: var(--teal); font-size: .9rem; font-weight: 600; } .khian { background: var(--mint); } .khian .case-facts article { background: rgba(255,255,255,.7); } .resources { display: grid; grid-template-columns: repeat(4,1fr); gap: 8px; margin: 16px 0 0; } .resources span { padding: 10px 9px; border: 1px solid #a7cec7; border-radius: 7px; color: var(--ink); background: var(--white); overflow-wrap: anywhere; } .scope p { font-size: .86rem; } .reading-note { background: var(--ink); color: var(--paper); } .reading-note .container { display: grid; grid-template-columns: .8fr 1.2fr auto; gap: 35px; align-items: end; } .reading-note .mono { color: #9ae3da; } .reading-note h2 { margin: 10px 0 0; font-size: clamp(1.8rem,3.2vw,3rem); line-height: 1.12; letter-spacing: -.04em; } .reading-note p { margin: 0; color: #bdd0d0; } .reading-note .btn { color: var(--paper); border-color: rgba(221,243,235,.6); white-space: nowrap; } @media (max-width: 800px) { .case-study, .reading-note .container { grid-template-columns: 1fr; gap: 30px; } .resources { grid-template-columns: 1fr 1fr; } }
</style>
