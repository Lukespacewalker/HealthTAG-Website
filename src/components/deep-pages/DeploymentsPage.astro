---
import Base from '../../layouts/Base.astro';
import type { Locale } from '../../data/site-content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const prefix = en ? '/en' : '';
const sirirajEvidence = en ? 'https://www2.si.mahidol.ac.th/en/news-events/siriraj-jointly-launched-siriraj-world-class-5g-smart-hospital-with-nbtc-huawei/' : 'https://si.mahidol.ac.th/th/hotnewsdetail.asp?hn_id=2728';
---
<Base locale={locale} path="deployments" title={en ? 'Deployments | HealthTAG' : 'การใช้งานจริง | HealthTAG'} description={en ? 'Two confirmed implementations show different HIS-to-FHIR ingestion choices.' : 'การติดตั้งที่ยืนยันแล้วสองกรณี แสดงทางเลือกการนำข้อมูลจาก HIS สู่ FHIR ที่แตกต่างกัน'}>
  <main>
    <section class="page-hero"><div class="container"><div class="eyebrow">HealthTAG / {en ? 'Deployments' : 'การติดตั้งใช้งาน'}</div><h1>{en ? 'The architecture is shared. The integration path is local.' : 'ใช้สถาปัตยกรรมร่วมกันได้ แต่เส้นทางนำข้อมูลเข้าเป็นของแต่ละแห่ง'}</h1><p>{en ? 'These case studies distinguish published programme evidence from HealthTAG-confirmed implementation facts. They do not claim that the two hospitals exchange records with each other.' : 'กรณีศึกษาเหล่านี้แยกหลักฐานโครงการที่เผยแพร่ต่อสาธารณะ ออกจากข้อเท็จจริงการติดตั้งที่ HealthTAG ยืนยัน และไม่ได้อ้างว่าโรงพยาบาลทั้งสองแลกเปลี่ยนเวชระเบียนระหว่างกัน'}</p></div></section>
    <section class="section"><div class="container case-study"><div class="case-index"><span class="mono">CASE 01</span><h2>Siriraj<br/>5G Smart Hospital</h2><span class="route-mark">HIS → {en ? 'Hospital IT script' : 'สคริปต์ของทีม IT โรงพยาบาล'} → FHIR</span></div><div class="case-facts"><article><span class="source-label">{en ? 'Externally confirmed programme fact' : 'ข้อเท็จจริงของโครงการที่แหล่งภายนอกยืนยัน'}</span><p>{en ? 'Siriraj described nine Smart Hospital subprojects. Permission-based Blockchain for Personal Health Record was one of those subprojects. The linked Siriraj announcement does not name HealthTAG.' : 'ศิริราชเผยแพร่โครงการย่อย Smart Hospital 9 โครงการ โดย Permission-based Blockchain for Personal Health Record เป็นหนึ่งในโครงการ ประกาศของศิริราชที่ลิงก์ไว้ไม่ได้เอ่ยชื่อ HealthTAG'}</p><a href={sirirajEvidence} target="_blank" rel="noopener noreferrer">{en ? 'Read the Siriraj announcement' : 'อ่านประกาศจากศิริราช'} ↗</a></article><article><span class="source-label confirmed">{en ? 'HealthTAG-confirmed participation and implementation' : 'การเข้าร่วมและการติดตั้งที่ HealthTAG ยืนยัน'}</span><p>{en ? 'HealthTAG confirms its participation in that PHR workstream. Siriraj IT uses its own HIS-to-FHIR script to populate the FHIR Server, and this implementation does not use HealthTAG FHIR Transformer.' : 'HealthTAG ยืนยันการเข้าร่วม workstream ด้าน PHR ดังกล่าว ทีม IT ศิริราชใช้ HIS-to-FHIR script ของตนเองเพื่อนำข้อมูลเข้า FHIR Server และการติดตั้งนี้ไม่ได้ใช้ HealthTAG FHIR Transformer'}</p><a href={`${prefix}/interoperability/`}>{en ? 'See the two ingestion choices' : 'ดูทางเลือกการนำข้อมูลเข้าสองแบบ'} →</a></article></div></div></section>
    <section class="section khian"><div class="container case-study"><div class="case-index"><span class="mono">CASE 02</span><h2>{en ? 'Khian Sa Hospital' : 'โรงพยาบาลเคียนซา'}</h2><span class="route-mark">HIS → HealthTAG FHIR Transformer → FHIR R4</span></div><div class="case-facts"><article><span class="source-label confirmed">{en ? 'HealthTAG-confirmed implementation fact' : 'ข้อเท็จจริงการติดตั้งที่ HealthTAG ยืนยัน'}</span><p>{en ? 'Khian Sa Hospital uses HealthTAG FHIR Transformer for selected HIS-to-FHIR R4 transformation.' : 'โรงพยาบาลเคียนซาใช้ HealthTAG FHIR Transformer เพื่อแปลงข้อมูล HIS ที่เลือกเป็น FHIR R4'}</p><a href="https://health-tag-document.suttisak-lukesp.workers.dev/guides/data-source-node/architecture/" target="_blank" rel="noopener noreferrer">{en ? 'Read the official Hospital API, Kong, and HAPI component architecture' : 'อ่านสถาปัตยกรรมส่วนประกอบ Hospital API, Kong และ HAPI ทางการ'} ↗</a></article><article class="scope"><span class="source-label">{en ? 'Currently confirmed resource scope' : 'ขอบเขต resource ที่ยืนยันแล้วในปัจจุบัน'}</span><div class="resources">{['Patient','AllergyIntolerance','Encounter','MedicationDispense'].map((resource) => <span class="mono">{resource}</span>)}</div><p>{en ? 'The resource list describes this implementation’s confirmed scope, not a universal production scope. The linked System Architecture page documents the shared component stack, not the Khian Sa deployment claim itself.' : 'รายชื่อ resource นี้อธิบายขอบเขตที่ยืนยันแล้วของการติดตั้งนี้ ไม่ใช่ขอบเขตการใช้งานจริงแบบครอบจักรวาล ส่วนหน้า System Architecture ที่ลิงก์ไว้ยืนยันชุดส่วนประกอบร่วม ไม่ได้เป็นหลักฐานของการติดตั้งที่เคียนซาโดยตรง'}</p></article></div></div></section>
    <section class="section reading-note"><div class="container"><div><span class="mono">READING THESE CASES</span><h2>{en ? 'A deployment is not a network claim.' : 'การติดตั้งไม่ใช่คำกล่าวอ้างแบบเดียวกับเครือข่าย'}</h2></div><p>{en ? 'Programme participation, historical network presence, awards, and public collaborations have their own evidence categories. Review them separately before drawing conclusions about current deployments or contracts.' : 'การเข้าร่วมโครงการ การปรากฏในเครือข่ายเดิม รางวัล และความร่วมมือสาธารณะ มีหมวดหลักฐานของตนเอง ควรพิจารณาแยกกันก่อนสรุปถึงการติดตั้งหรือสัญญาปัจจุบัน'}</p><a class="btn secondary" href={`${prefix}/evidence/`}>{en ? 'Review evidence & sources' : 'ดูหลักฐานและแหล่งข้อมูล'}</a></div></section>
  </main>
</Base>
<style>
  .case-study { display: grid; grid-template-columns: .75fr 1.25fr; gap: clamp(35px,7vw,100px); } .case-index { padding-top: 4px; } .mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: .69rem; letter-spacing: .07em; color: var(--teal); } .case-index h2 { margin: 14px 0 20px; font-size: clamp(2.35rem,4.6vw,4.5rem); line-height: .98; letter-spacing: -.06em; } .route-mark { display: inline-block; border-left: 3px solid var(--teal); padding: 8px 0 8px 13px; color: var(--muted); font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: .76rem; line-height: 1.6; } .case-facts { display: grid; gap: 14px; } .case-facts article { padding: 26px; border: 1px solid var(--line); border-radius: 13px; background: var(--white); } .source-label { display: inline-block; color: var(--muted); font-size: .71rem; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; } .source-label.confirmed { color: var(--teal); } .case-facts p { margin: 15px 0 0; color: var(--muted); } .case-facts a { display: inline-block; margin-top: 18px; color: var(--teal); font-size: .9rem; font-weight: 600; } .khian { background: var(--mint); } .khian .case-facts article { background: rgba(255,255,255,.7); } .resources { display: grid; grid-template-columns: repeat(4,1fr); gap: 8px; margin: 16px 0 0; } .resources span { padding: 10px 9px; border: 1px solid #a7cec7; border-radius: 7px; color: var(--ink); background: var(--white); overflow-wrap: anywhere; } .scope p { font-size: .86rem; } .reading-note { background: var(--ink); color: var(--paper); } .reading-note .container { display: grid; grid-template-columns: .8fr 1.2fr auto; gap: 35px; align-items: end; } .reading-note .mono { color: #9ae3da; } .reading-note h2 { margin: 10px 0 0; font-size: clamp(1.8rem,3.2vw,3rem); line-height: 1.12; letter-spacing: -.04em; } .reading-note p { margin: 0; color: #bdd0d0; } .reading-note .btn { color: var(--paper); border-color: rgba(221,243,235,.6); white-space: nowrap; } @media (max-width: 800px) { .case-study, .reading-note .container { grid-template-columns: 1fr; gap: 30px; } .resources { grid-template-columns: 1fr 1fr; } }
</style>
