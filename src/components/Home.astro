---
import Base from '../layouts/Base.astro';
import FounderCard from './FounderCard.astro';
interface Props { locale:'th'|'en' }
const { locale }=Astro.props; const en=locale==='en'; const p=en?'/en':'';
const resources=['Patient','AllergyIntolerance','Encounter','MedicationDispense'];
const proof = en ? [
  ['NIA Corporate SPARK','China Program 2025','https://www.nia.or.th/Shanghai-CorporateSPARK2025'],
  ['ETDA Digital Service Sandbox','Testing goals met','https://www.etda.or.th/th/Our-Service/Digital-Service-Sandbox/announce.aspx'],
  ['APICTA 2022','Start-Up category winner','https://apicta.org/files/apicta_wl_2022.html'],
  ['Orbix × HealthTAG','Strategic collaboration','https://www.kasikornbank.com/en/news/pages/healthtag.aspx']
] : [
  ['NIA Corporate SPARK','China Program 2025','https://www.nia.or.th/Shanghai-CorporateSPARK2025'],
  ['ETDA Digital Service Sandbox','ผ่านเป้าหมายการทดสอบ','https://www.etda.or.th/th/Our-Service/Digital-Service-Sandbox/announce.aspx'],
  ['APICTA 2022','รางวัลชนะเลิศหมวด Start-Up','https://apicta.org/files/apicta_wl_2022.html'],
  ['Orbix × HealthTAG','ความร่วมมือเชิงยุทธศาสตร์','https://www.kasikornbank.com/th/news/pages/healthtag.aspx']
];
const capabilities = en ? [
  ['Connect data','Send data from an existing HIS to the hospital FHIR system through an IT-managed script or HealthTAG FHIR Transformer.','/interoperability/'],
  ['Connect identity','Link hospital-local identities with PromptCare ID so one patient can be recognized across providers.','/how-it-works/'],
  ['Control access','Authorize data exchange through a time-limited, auditable access model.','/trust/']
] : [
  ['เชื่อมข้อมูล','ส่งข้อมูลจาก HIS เดิมเข้าสู่ระบบ FHIR ของโรงพยาบาล ผ่านสคริปต์ของทีม IT หรือ HealthTAG FHIR Transformer','/interoperability/'],
  ['เชื่อมตัวตนผู้ป่วย','เชื่อมตัวตนผู้ป่วยเฉพาะโรงพยาบาลกับ PromptCare ID เพื่อระบุผู้ป่วยคนเดียวกันข้ามสถานพยาบาล','/how-it-works/'],
  ['ควบคุมการเข้าถึง','อนุญาตการแลกเปลี่ยนข้อมูลด้วยสิทธิ์ที่มีอายุจำกัดและตรวจสอบย้อนหลังได้','/trust/']
];
---
<Base locale={locale} title={en?'HealthTAG | Healthcare interoperability with hospitals in control':'HealthTAG | เชื่อมข้อมูลสุขภาพโดยโรงพยาบาลยังควบคุมข้อมูล'} description={en?'HealthTAG connects hospital-controlled healthcare data with identity, authorization, PHR, and trusted exchange.':'HealthTAG เชื่อมข้อมูลสุขภาพที่โรงพยาบาลควบคุมเองเข้ากับตัวตนผู้ป่วย การอนุญาต PHR และการแลกเปลี่ยนข้อมูลที่ตรวจสอบย้อนหลังได้'}>
<main>
<section class="hero"><div class="container hero-grid"><div><div class="eyebrow">{en?'Healthcare interoperability infrastructure':'โครงสร้างพื้นฐานเพื่อการเชื่อมโยงข้อมูลสุขภาพ'}</div><h1>{en?'Connect health information. Keep hospitals in control.':'เชื่อมข้อมูลสุขภาพ โดยโรงพยาบาลยังเป็นผู้ควบคุม'}</h1><p>{en?'HealthTAG connects an existing HIS to interoperable health data, patient identity, access control, and PHR while hospitals keep their core systems and clinical records.':'HealthTAG เชื่อม HIS เดิมเข้ากับข้อมูลสุขภาพที่แลกเปลี่ยนได้ ตัวตนผู้ป่วย การควบคุมสิทธิ์ และ PHR โดยโรงพยาบาลยังใช้ระบบหลักและดูแลเวชระเบียนของตน'}</p><div class="actions"><a class="btn primary" href={`${p}/interoperability/`}>{en?'Explore the platform':'ดูแพลตฟอร์ม'}</a><a class="btn secondary" href={`${p}/deployments/`}>{en?'See deployments':'ดูการติดตั้งใช้งาน'}</a></div></div><div class="topology-card" role="img" aria-label={en?'Conceptual architecture: an existing HIS uses a hospital IT script or FHIR Transformer to reach the hospital-controlled FHIR system. Kong and HealthTAG Module protect authorized exchange to PHR applications. Consent and access events go to the audit ledger, while clinical records remain in hospital systems.' : 'สถาปัตยกรรมเชิงแนวคิด: HIS เดิมใช้สคริปต์ของโรงพยาบาลหรือ FHIR Transformer เพื่อนำข้อมูลเข้าสู่ระบบ FHIR ที่โรงพยาบาลควบคุม Kong และ HealthTAG Module ปกป้องการแลกเปลี่ยนตามสิทธิ์ไปยัง PHR เหตุการณ์การให้ความยินยอมและการเข้าถึงเข้าสู่ประวัติตรวจสอบ ส่วนเวชระเบียนยังอยู่ในระบบโรงพยาบาล'}><div class="boundary-label">{en?'Conceptual · hospital-controlled environment':'ภาพเชิงแนวคิด · สภาพแวดล้อมที่โรงพยาบาลควบคุม'}</div><div class="topology-ingress"><div class="topology-node"><strong>Existing HIS</strong><small>{en?'Hospital system':'ระบบเดิม'}</small></div><div class="topology-split"><span>↓</span><div><b>IT Script</b><b>FHIR Transformer</b></div><span>↓</span></div></div><div class="topology-fhir"><strong>FHIR System</strong><span>HL7 FHIR R4</span><em>{en?'Hospital controlled':'โรงพยาบาลควบคุม'}</em></div><div class="topology-edge"><div><strong>Kong API Gateway</strong><small>{en?'FHIR API protection':'ปกป้อง FHIR API'}</small></div><div><strong>HealthTAG Module</strong><small>{en?'Identity · Authorization':'ตัวตน · การอนุญาต'}</small></div></div><div class="topology-out">↓ {en?'Authorized exchange':'แลกเปลี่ยนตามสิทธิ์'} ↓</div><div class="topology-dest"><span>PHR</span><span>{en?'Authorized apps':'แอปที่ได้รับสิทธิ์'}</span></div><div class="topology-audit"><strong>{en?'Consent/access events → audit ledger':'เหตุการณ์การให้ความยินยอม/การเข้าถึง → ประวัติตรวจสอบ'}</strong><small>{en?'Clinical records remain in hospital systems':'เวชระเบียนยังอยู่ในระบบโรงพยาบาล'}</small></div></div></div></section>

<section class="proof-band"><div class="container"><div class="proof-band-head"><div><div class="eyebrow">{en?'Evidence':'หลักฐาน'}</div><h2>{en?'Evidence from original sources':'หลักฐานจากแหล่งข้อมูลต้นทาง'}</h2></div><a href={`${p}/evidence/`}>{en?'See all evidence & sources':'ดูหลักฐานและแหล่งข้อมูลทั้งหมด'} →</a></div><div class="proof-row">{proof.map(([title,meta,href])=><a class="proof-item" href={href} target="_blank" rel="noopener noreferrer"><strong>{title}</strong><span>{meta}</span><i>↗</i></a>)}</div></div></section>

<section class="section"><div class="container"><div class="section-head"><h2>{en?'What HealthTAG does':'HealthTAG ทำอะไร'}</h2><p>{en?'Hospitals can use the parts that match their existing systems and integration needs.':'โรงพยาบาลเลือกใช้ส่วนที่เหมาะกับระบบและงานเชื่อมต่อของตน'}</p></div><div class="product-grid">{capabilities.map(([title,body,path])=><article class="card"><div class="kicker">{en?'HealthTAG platform':'แพลตฟอร์ม HealthTAG'}</div><h3>{title}</h3><p>{body}</p><div class="actions"><a class="btn secondary" href={`${p}${path}`}>{en?'Learn more':'ดูรายละเอียด'}</a></div></article>)}</div></div></section>

<section class="section"><div class="container"><div class="section-head"><h2>{en?'Siriraj and Khian Sa use different ingestion paths':'ศิริราชและเคียนซาใช้วิธีนำข้อมูลเข้าแตกต่างกัน'}</h2><p>{en?'Each hospital can connect its HIS in the way that fits its own systems.':'แต่ละโรงพยาบาลเลือกวิธีเชื่อม HIS ให้เหมาะกับระบบของตน'}</p></div><div class="case-spread"><article><div class="kicker">Siriraj 5G Smart Hospital</div><h3>{en?'Hospital IT script':'สคริปต์ของทีม IT โรงพยาบาล'}</h3><p>{en?'Siriraj IT uses its own script to send HIS data to the FHIR Server. HealthTAG says it participated in the Permission-based Blockchain for Personal Health Record subproject.':'ทีม IT ศิริราชใช้สคริปต์ของตนเองนำข้อมูลจาก HIS เข้า FHIR Server ส่วน HealthTAG ระบุว่าเข้าร่วมโครงการย่อย Permission-based Blockchain for Personal Health Record'}</p><a href={`${p}/deployments/`}>{en?'Read the Siriraj case':'อ่านกรณีศิริราช'} →</a></article><article><div class="kicker">Khian Sa Hospital</div><h3>HealthTAG FHIR Transformer</h3><p>{en?'HealthTAG FHIR Transformer maps selected HIS data to HL7 FHIR R4.':'HealthTAG FHIR Transformer แปลงข้อมูล HIS ที่เลือกเป็น HL7 FHIR R4'}</p><div class="resource-list">{resources.map(r=><span class="chip">{r}</span>)}</div></article></div></div></section>

<section class="section product-story"><div class="container product-story-grid"><div><div class="eyebrow">Personal Health Record</div><h2>{en?'PHR presents records that a patient is authorized to access':'PHR แสดงข้อมูลที่ผู้ป่วยได้รับสิทธิ์เข้าถึง'}</h2><p>{en?'This illustration uses synthetic data and generic provider names. It shows the information structure rather than the current product interface or a live exchange between named hospitals.':'ภาพประกอบนี้ใช้ข้อมูลสังเคราะห์และชื่อผู้ให้บริการทั่วไป เพื่อแสดงโครงสร้างข้อมูล โดยไม่ได้อ้างอิงหน้าจอผลิตภัณฑ์ปัจจุบันหรือการแลกเปลี่ยนข้อมูลจริงระหว่างโรงพยาบาลที่ระบุชื่อ'}</p><div class="actions"><a class="btn secondary" href={`${p}/phr/`}>{en?'Explore PHR':'ดู PHR'}</a><a class="btn secondary" href="https://phr.healthtag.io" target="_blank" rel="noopener noreferrer" aria-label={en?'Open the HealthTAG PHR website in a new tab':'เปิดเว็บไซต์ HealthTAG PHR ในแท็บใหม่'}>{en?'Open PHR website':'เปิดเว็บไซต์ PHR'} ↗</a></div></div><div class="phr-window" aria-label={en?'Illustrative PHR interface using synthetic data':'ภาพประกอบหน้าจอ PHR ที่ใช้ข้อมูลสังเคราะห์'}><div class="phr-bar"><span></span><strong>{en?'Illustration · synthetic data':'ภาพประกอบ · ข้อมูลสังเคราะห์'}</strong></div><div class="phr-profile"><div class="avatar">PT</div><div><strong>PromptCare ID · PC-02814</strong><small>{en?'Example providers: 2':'ตัวอย่างผู้ให้บริการ: 2'}</small></div><span class="access-live">{en?'Access window · 15 minutes':'ช่วงเวลาการเข้าถึง · 15 นาที'}</span></div><div class="phr-tabs"><b>{en?'Timeline':'ไทม์ไลน์'}</b><span>{en?'Allergies':'การแพ้ยา'}</span><span>{en?'Medicines':'ยา'}</span></div><div class="phr-record"><time>12 AUG</time><div><strong>{en?'Outpatient encounter':'การรับบริการผู้ป่วยนอก'}</strong><small>{en?'Provider A':'ผู้ให้บริการ A'} · Encounter</small></div></div><div class="phr-record"><time>04 JUL</time><div><strong>Amoxicillin</strong><small>{en?'Provider B':'ผู้ให้บริการ B'} · MedicationDispense</small></div></div><div class="phr-consent"><strong>{en?'Authorized access':'การเข้าถึงที่ได้รับอนุญาต'}</strong><span>{en?'Time-limited':'มีเวลาจำกัด'}</span></div></div></div></section>

<section class="section"><div class="container company-grid"><div><div class="eyebrow">{en?'Company':'บริษัท'}</div><h2>{en?'HealthTAG began with a problem its founder saw in patient care':'HealthTAG เริ่มจากปัญหาที่ผู้ก่อตั้งพบในการดูแลผู้ป่วย'}</h2><p class="lead-copy">{en?'Health records may exist in several systems but still be difficult to use when a patient needs care.':'เวชระเบียนอาจอยู่ในหลายระบบ แต่ยังนำมาใช้ได้ยากเมื่อผู้ป่วยต้องรับการดูแล'}</p></div><FounderCard locale={locale} /></div></section>

<section class="section final-cta"><div class="container"><div class="section-head"><h2>{en?'Talk to HealthTAG about connecting your hospital systems':'คุยกับ HealthTAG เรื่องการเชื่อมระบบโรงพยาบาล'}</h2><p>{en?'Contact us about technical integration, deployment, or partnership.' : 'ติดต่อเราเรื่องการเชื่อมต่อทางเทคนิค การติดตั้งใช้งาน หรือความร่วมมือ'}</p></div><div class="actions"><a class="btn primary" href={`${p}/contact/`}>{en?'Contact HealthTAG':'ติดต่อ HealthTAG'}</a><a class="btn secondary" href={`${p}/evidence/`}>{en?'View evidence & sources':'ดูหลักฐานและแหล่งข้อมูล'}</a></div></div></section>
</main></Base>
