---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import overviewScreen from '../assets/phr/phr-overview-redacted.png';
import { evidence } from '../data/evidence';
import { formatPublicationDate, getPublishedPublications, publicationPath } from '../lib/publications';
import FounderCard from './FounderCard.astro';

interface Props { locale: 'th' | 'en' }

const { locale } = Astro.props;
const en = locale === 'en';
const prefix = en ? '/en' : '';

const trustBarIds = [
  'who-thailand-dhw-workshop-2026',
  'mahidol-moph-digital-health-mou-2026',
  'asean-digital-awards-2024',
  'apicta-2022',
  'etda-digital-service-sandbox',
  'orbix-healthtag',
];
const trustBarEvidence = trustBarIds.map((id) => {
  const entry = evidence.find((candidate) => candidate.id === id);
  if (!entry) throw new Error(`Missing Home trust bar entry: ${id}`);
  return entry;
});
const trustBarPaths: Record<string, string> = {
  'who-thailand-dhw-workshop-2026': `${prefix}/news/who-thailand-trusted-phr-workshop-2026/`,
  'mahidol-moph-digital-health-mou-2026': `${prefix}/evidence/#mahidol-moph-digital-health-mou-2026`,
  'asean-digital-awards-2024': `${prefix}/awards/asean-digital-awards-2024/`,
  'etda-digital-service-sandbox': `${prefix}/evidence/#etda-digital-service-sandbox`,
  'apicta-2022': `${prefix}/awards/apicta-2022/`,
  'orbix-healthtag': `${prefix}/news/orbix-healthtag/`,
};
const trustBarTitles: Record<string, Record<'th' | 'en', string>> = {
  'who-thailand-dhw-workshop-2026': { th: 'WHO Thailand DHW Workshop', en: 'WHO Thailand DHW Workshop' },
  'mahidol-moph-digital-health-mou-2026': { th: 'MOU มหิดล - สธ.', en: 'Mahidol - MOPH MOU' },
  'asean-digital-awards-2024': { th: 'ASEAN Digital Awards 2024', en: 'ASEAN Digital Awards 2024' },
  'etda-digital-service-sandbox': { th: 'ETDA Digital Service Sandbox', en: 'ETDA Digital Service Sandbox' },
  'apicta-2022': { th: 'APICTA 2022', en: 'APICTA 2022' },
  'orbix-healthtag': { th: 'Orbix × HealthTAG', en: 'Orbix × HealthTAG' },
};

const homeNews = await getPublishedPublications(locale, 'news');
const featuredStories = homeNews.filter((entry) => entry.data.featured).slice(0, 2);
const latestStories = homeNews.filter((entry) => !entry.data.featured).slice(0, 3);
if (featuredStories.length !== 2 || latestStories.length < 2) throw new Error(`Home news selection is incomplete for ${locale}`);

const responsibilities = en ? [
  {
    number: '01',
    role: 'Patient',
    title: 'Owns the health data',
    body: 'The patient decides whether and how their health data may be used.',
    path: '/trust/',
    cta: 'Consent and access',
  },
  {
    number: '02',
    role: 'Hospital',
    title: 'Stewards the clinical record',
    body: 'The hospital stores clinical records in its source systems and remains responsible for those systems.',
    path: '/interoperability/',
    cta: 'Hospital-held records',
  },
  {
    number: '03',
    role: 'HealthTAG',
    title: 'Connects authorized exchange',
    body: 'HealthTAG provides infrastructure for identity linkage, authorization, exchange, and audit.',
    path: '/platform/',
    cta: 'HealthTAG platform',
  },
] : [
  {
    number: '01',
    role: 'ผู้ป่วย',
    title: 'เป็นเจ้าของข้อมูลสุขภาพ',
    body: 'ผู้ป่วยตัดสินใจว่าจะยินยอมให้ใช้ข้อมูลสุขภาพของตนหรือไม่และใช้อย่างไร',
    path: '/trust/',
    cta: 'ความยินยอมและสิทธิ์เข้าถึง',
  },
  {
    number: '02',
    role: 'โรงพยาบาล',
    title: 'ดูแลเวชระเบียน',
    body: 'โรงพยาบาลเก็บเวชระเบียนในระบบต้นทางและรับผิดชอบระบบเหล่านั้น',
    path: '/interoperability/',
    cta: 'เวชระเบียนในระบบโรงพยาบาล',
  },
  {
    number: '03',
    role: 'HealthTAG',
    title: 'เชื่อมการแลกเปลี่ยนที่ได้รับอนุญาต',
    body: 'HealthTAG จัดโครงสร้างพื้นฐานสำหรับเชื่อมตัวตน ตรวจสิทธิ์ แลกเปลี่ยนข้อมูล และบันทึกเหตุการณ์',
    path: '/platform/',
    cta: 'แพลตฟอร์ม HealthTAG',
  },
];

const capabilities = en ? [
  {
    number: '01',
    title: 'Data Connect',
    body: 'Connect an existing HIS to the hospital FHIR system through a hospital-managed script or HealthTAG FHIR Transformer.',
    path: '/interoperability/',
    cta: 'How systems connect',
  },
  {
    number: '02',
    title: 'Patient identity linkage',
    body: 'Link hospital-local patient identifiers to a common identity reference so records can be matched to the same person.',
    path: '/how-it-works/',
    cta: 'Follow the exchange flow',
  },
  {
    number: '03',
    title: 'Consent and Authorization',
    body: 'Record the patient\'s consent, then evaluate each access request separately.',
    path: '/trust/',
    cta: 'Consent and access',
  },
  {
    number: '04',
    title: 'Audit and Provenance',
    body: 'Record consent and access events for later review while keeping the hospital source of each clinical record clear.',
    path: '/trust/',
    cta: 'Audit and data sources',
  },
] : [
  {
    number: '01',
    title: 'Data Connect',
    body: 'เชื่อม HIS เดิมกับระบบ FHIR ของโรงพยาบาล ผ่านสคริปต์ของทีมโรงพยาบาลหรือ HealthTAG FHIR Transformer',
    path: '/interoperability/',
    cta: 'ดูวิธีเชื่อมระบบ',
  },
  {
    number: '02',
    title: 'ระบบเชื่อมตัวตนผู้ป่วย',
    body: 'เชื่อมรหัสผู้ป่วยของแต่ละสถานพยาบาลกับตัวระบุกลาง เพื่อจับคู่ข้อมูลของบุคคลเดียวกัน',
    path: '/how-it-works/',
    cta: 'ดูขั้นตอนการแลกเปลี่ยน',
  },
  {
    number: '03',
    title: 'ความยินยอมและการอนุญาตสิทธิ์',
    body: 'บันทึกความยินยอมของผู้ป่วย แล้วตรวจคำขอเข้าถึงแต่ละครั้งแยกกัน',
    path: '/trust/',
    cta: 'ดูความยินยอมและสิทธิ์เข้าถึง',
  },
  {
    number: '04',
    title: 'การตรวจสอบและที่มาของข้อมูล',
    body: 'บันทึกเหตุการณ์ความยินยอมและการเข้าถึงไว้ตรวจสอบภายหลัง พร้อมระบุโรงพยาบาลที่ดูแลเวชระเบียนต้นทางให้ชัดเจน',
    path: '/trust/',
    cta: 'การตรวจสอบและที่มาของข้อมูล',
  },
];

const audiences = en ? [
  {
    label: 'Hospital leadership',
    body: 'Compare the deployment models used at Siriraj, Khian Sa, and MU Health Data Network.',
    path: '/deployments/',
  },
  {
    label: 'Hospital IT and security',
    body: 'Review integration paths, standards, authorization, and system boundaries.',
    path: '/interoperability/',
  },
  {
    label: 'Public sector and ecosystem partners',
    body: 'Read records published by organizations connected with HealthTAG.',
    path: '/evidence/',
  },
  {
    label: 'Investors',
    body: 'Read about the business model, deployments, and public records.',
    path: '/investors/',
  },
] : [
  {
    label: 'ผู้บริหารโรงพยาบาล',
    body: 'เปรียบเทียบรูปแบบการติดตั้งที่ศิริราช เคียนซา และ MU Health Data Network',
    path: '/deployments/',
  },
  {
    label: 'ทีม IT และความมั่นคงปลอดภัยของโรงพยาบาล',
    body: 'ดูแนวทางเชื่อมระบบ มาตรฐาน การตรวจสิทธิ์ และขอบเขตของแต่ละระบบ',
    path: '/interoperability/',
  },
  {
    label: 'ภาครัฐและพันธมิตรในระบบสุขภาพ',
    body: 'อ่านข้อมูลที่หน่วยงานซึ่งเกี่ยวข้องกับ HealthTAG เผยแพร่ไว้',
    path: '/evidence/',
  },
  {
    label: 'นักลงทุน',
    body: 'ดูโมเดลธุรกิจ การติดตั้งใช้งาน และข้อมูลที่เผยแพร่ต่อสาธารณะ',
    path: '/investors/',
  },
];

const heroPhases = en ? [
  {
    number: '01',
    title: 'Hospital-held records',
    body: 'Hospitals retain clinical records in their own source systems.',
  },
  {
    number: '02',
    title: 'Connect to the Wallet',
    body: 'FHIR provides a standard structure for permitted information exchanged with the Wallet.',
  },
  {
    number: '03',
    title: 'Authorized data exchange',
    body: 'After identity and authorization are checked, permitted data can travel along the connections.',
  },
  {
    number: '04',
    title: 'Consent and access audit',
    body: 'Consent and access events are recorded on blockchain. Clinical records are not stored there.',
  },
] : [
  {
    number: '01',
    title: 'เวชระเบียนอยู่กับโรงพยาบาล',
    body: 'โรงพยาบาลเก็บเวชระเบียนไว้ในระบบต้นทางของตนเอง',
  },
  {
    number: '02',
    title: 'เชื่อมต่อเข้าสู่ Wallet',
    body: 'FHIR กำหนดโครงสร้างมาตรฐานสำหรับแลกเปลี่ยนข้อมูลที่ได้รับอนุญาตกับ Wallet',
  },
  {
    number: '03',
    title: 'แลกเปลี่ยนข้อมูลที่ได้รับอนุญาต',
    body: 'หลังตรวจตัวตนและสิทธิ์แล้ว ข้อมูลที่ได้รับอนุญาตจึงเดินทางผ่านเส้นเชื่อมได้',
  },
  {
    number: '04',
    title: 'บันทึกความยินยอมและการเข้าถึง',
    body: 'บันทึกเหตุการณ์ความยินยอมและการเข้าถึงลงบนบล็อกเชน โดยไม่เก็บเวชระเบียนไว้บนบล็อกเชน',
  },
];
---

<Base
  locale={locale}
  title={en ? 'HealthTAG | Trusted health data infrastructure for Thailand' : 'HealthTAG | โครงสร้างพื้นฐานข้อมูลสุขภาพที่ประเทศไทยวางใจได้'}
  description={en
    ? 'HealthTAG provides identity, authorization, interoperability, and audit infrastructure for permitted health data exchange.'
    : 'HealthTAG จัดโครงสร้างพื้นฐานด้านตัวตน สิทธิ์ การเชื่อมโยงข้อมูล และการตรวจสอบย้อนหลัง สำหรับการแลกเปลี่ยนข้อมูลสุขภาพที่ได้รับอนุญาต'}
>
  <main>
    <section class="hero home-hero" data-home-section="hero" data-network-hero data-phase="0">
      <div class="hero-network" aria-hidden="true" data-three-hero></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <div class="eyebrow">{en ? 'Health data infrastructure · Thailand' : 'โครงสร้างพื้นฐานข้อมูลสุขภาพ · ประเทศไทย'}</div>
          <h1 aria-label={en ? undefined : 'โครงสร้างพื้นฐานข้อมูลสุขภาพที่ประเทศไทยวางใจได้'}>{en ? 'Trusted health data infrastructure for Thailand' : <><span>โครงสร้างพื้นฐาน</span><span>ข้อมูลสุขภาพ</span><span>ที่ประเทศไทย</span><span>วางใจได้</span></>}</h1>
          <p class="hero-body">{en
            ? 'HealthTAG connects hospital systems through open standards and checks identity and access before permitted data is returned. The original clinical records remain in hospital source systems.'
            : 'HealthTAG เชื่อมระบบโรงพยาบาลด้วยมาตรฐานเปิด พร้อมตรวจตัวตนและสิทธิ์ก่อนส่งข้อมูลที่ได้รับอนุญาต โดยเวชระเบียนต้นฉบับยังอยู่ในระบบต้นทางของโรงพยาบาล'}</p>
          <div class="hero-story" aria-label={en ? 'Conceptual exchange sequence' : 'ลำดับแนวคิดการแลกเปลี่ยนข้อมูล'}>
            <p class="hero-story-kicker">{en ? 'Authorized exchange' : 'การแลกเปลี่ยนที่ได้รับอนุญาต'}</p>
            <div class="hero-phase-controls" role="group" aria-label={en ? 'Choose a sequence step' : 'เลือกขั้นตอน'}>
              {heroPhases.map((phase, index) => (
                <button type="button" class:list={['hero-phase-control', { active: index === 0 }]} data-hero-phase={index} aria-pressed={index === 0 ? 'true' : 'false'} data-title={phase.title} data-body={phase.body}>
                  <span>{phase.number}</span><span>{phase.title}</span>
                </button>
              ))}
            </div>
            <p class="hero-story-status" aria-live="polite" data-hero-status><strong>{heroPhases[0].number} · {heroPhases[0].title}</strong><span>{heroPhases[0].body}</span></p>
          </div>
          <div class="actions hero-actions">
            <a class="btn primary" href={`${prefix}/platform/`}>{en ? 'Explore the platform' : 'ดูภาพรวมแพลตฟอร์ม'}</a>
            <a class="btn secondary" href={`${prefix}/contact/`}>{en ? 'Talk to HealthTAG' : 'คุยกับ HealthTAG'}</a>
          </div>
          <p class="hero-story-note">{en ? 'Conceptual view: clinical records remain with hospitals.' : 'ภาพแนวคิด: เวชระเบียนยังอยู่กับโรงพยาบาล'}</p>
          <button
            type="button"
            class="hero-motion-toggle"
            data-hero-motion-toggle
            data-pause-label={en ? 'Pause motion' : 'หยุดภาพเคลื่อนไหว'}
            data-play-label={en ? 'Play motion' : 'เล่นภาพเคลื่อนไหว'}
            aria-label={en ? 'Pause motion' : 'หยุดภาพเคลื่อนไหว'}
          ><span aria-hidden="true" data-motion-icon>Ⅱ</span><span data-motion-label>{en ? 'Pause motion' : 'หยุดภาพเคลื่อนไหว'}</span></button>
        </div>
      </div>
    </section>

    <section class="trust-bar" data-home-section="proof" aria-labelledby="home-proof-heading">
      <div class="container trust-bar-frame">
        <header class="trust-bar-intro">
          <div>
            <span class="trust-bar-kicker">{en ? 'VERIFIABLE RECORDS' : 'ข้อมูลที่ตรวจสอบได้'}</span>
            <h2 id="home-proof-heading">{en ? 'Public records behind the work' : 'หลักฐานสาธารณะที่เกี่ยวข้องกับงานของเรา'}</h2>
          </div>
          <a href={`${prefix}/evidence/`}>{en ? 'Evidence and sources' : 'ดูหลักฐานและแหล่งข้อมูล'} <span aria-hidden="true">→</span></a>
        </header>
        <ol class="trust-bar-list">
          {trustBarEvidence.map((entry, index) => (
            <li>
              <a href={trustBarPaths[entry.id]}>
                <span class="trust-bar-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="trust-bar-type">{entry.tag[locale]}</span>
                <strong>{trustBarTitles[entry.id][locale]}</strong>
                <small>{entry.id === 'asean-digital-awards-2024' ? (en ? 'Silver · Public Sector' : 'Silver · Public Sector') : entry.sourceOrganization[locale]}</small>
                <i aria-hidden="true">→</i>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="home-news-section" data-home-section="news" aria-labelledby="home-news-heading">
      <div class="container">
        <div class="home-news-head">
          <div>
            <div class="eyebrow">{en ? 'News from HealthTAG' : 'ข่าวจาก HealthTAG'}</div>
            <h2 id="home-news-heading">{en ? 'Featured news' : 'ข่าวเด่น'}</h2>
          </div>
          <a href={`${prefix}/news/`}>{en ? 'View all news' : 'ดูข่าวทั้งหมด'} <span aria-hidden="true">→</span></a>
        </div>

        <div class="featured-story-grid">
          {featuredStories.map((story, index) => {
            const image = story.data.images[0];
            const date = story.data.publishedAt ?? story.data.eventDate ?? story.data.migratedAt;
            return <article class:list={['featured-story', { primary: index === 0 }]}>
              <a class="featured-story-media" href={publicationPath(story)} tabindex="-1" aria-hidden="true">
                <Image src={image.src} alt="" widths={[480, 720, 1040]} sizes="(max-width: 820px) calc(100vw - 28px), 50vw" format="webp" quality={84} loading="lazy" decoding="async" />
              </a>
              <div class="featured-story-copy">
                <span>{en ? 'Featured' : 'ข่าวเด่น'} · {formatPublicationDate(date, locale)}</span>
                <h3><a href={publicationPath(story)}>{story.data.title}</a></h3>
                <p>{story.data.summary}</p>
              </div>
            </article>;
          })}
        </div>

        <div class="latest-news-block">
          <div class="latest-news-title">
            <span>{en ? 'Latest' : 'ล่าสุด'}</span>
            <h3>{en ? 'More recent news' : 'ข่าวล่าสุดเพิ่มเติม'}</h3>
          </div>
          <div class="latest-news-list">
            {latestStories.map((story, index) => {
              const date = story.data.publishedAt ?? story.data.eventDate ?? story.data.migratedAt;
              return <a href={publicationPath(story)}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div><time datetime={date}>{formatPublicationDate(date, locale)}</time><strong>{story.data.title}</strong></div>
                <i aria-hidden="true">→</i>
              </a>;
            })}
          </div>
        </div>
      </div>
    </section>

    <section class="governance-section" data-home-section="responsibilities">
      <div class="container">
        <div class="governance-head">
          <h2>{en ? 'Who owns, stores, and connects health data' : 'ใครเป็นเจ้าของ ใครเก็บ และใครเชื่อมข้อมูลสุขภาพ'}</h2>
          <p>{en
            ? 'Health data belongs to the patient. The hospital stewards the clinical record. HealthTAG provides the infrastructure for authorized exchange.'
            : 'ข้อมูลสุขภาพเป็นของผู้ป่วย โรงพยาบาลดูแลเวชระเบียน และ HealthTAG จัดโครงสร้างพื้นฐานสำหรับการแลกเปลี่ยนที่ได้รับอนุญาต'}</p>
        </div>
        <div class="governance-grid">
          {responsibilities.map((item) => (
            <article>
              <span>{item.number} / {item.role}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <a href={`${prefix}${item.path}`}>{item.cta} <i aria-hidden="true">→</i></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section capabilities-section" data-home-section="capabilities">
      <div class="container">
        <div class="section-head split-head">
          <div>
            <div class="eyebrow">{en ? 'Platform capabilities' : 'ความสามารถของแพลตฟอร์ม'}</div>
            <h2>{en ? 'How HealthTAG connects data and checks access' : 'HealthTAG เชื่อมข้อมูลและตรวจสิทธิ์อย่างไร'}</h2>
          </div>
          <p>{en
            ? 'HealthTAG connects existing HIS data through FHIR, links patient identities, checks authorization, and records consent and access events.'
            : 'HealthTAG เชื่อมข้อมูลจาก HIS เดิมผ่าน FHIR เชื่อมตัวตนผู้ป่วย ตรวจสิทธิ์ และบันทึกเหตุการณ์ความยินยอมกับการเข้าถึง'}</p>
        </div>
        <div class="capability-grid">
          {capabilities.map((item) => (
            <article>
              <span>{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <a href={`${prefix}${item.path}`}>{item.cta} <i aria-hidden="true">→</i></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="audience-section" data-home-section="audiences">
      <div class="container audience-grid">
        <div class="audience-intro">
          <div class="eyebrow">{en ? 'Information by role' : 'ข้อมูลตามบทบาท'}</div>
