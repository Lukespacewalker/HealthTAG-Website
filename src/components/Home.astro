<script>
  import * as THREE from 'three';

  document.querySelectorAll<HTMLElement>('[data-network-hero]').forEach((hero) => {
    const controls = Array.from(hero.querySelectorAll<HTMLButtonElement>('[data-hero-phase]'));
    const motionToggle = hero.querySelector<HTMLButtonElement>('[data-hero-motion-toggle]');
    const motionIcon = motionToggle?.querySelector<HTMLElement>('[data-motion-icon]');
    const motionLabel = motionToggle?.querySelector<HTMLElement>('[data-motion-label]');
    const status = hero.querySelector<HTMLElement>('[data-hero-status]');
    const statusTitle = status?.querySelector<HTMLElement>('strong');
    const statusBody = status?.querySelector<HTMLElement>('span');
    if (!controls.length || !statusTitle || !statusBody) return;

    const sceneHost = hero.querySelector<HTMLElement>('[data-three-hero]');
    let phase = 0;
    let visible = false;
    let userControlled = false;
    let motionPaused = false;
    let timer: number | undefined;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let updateScene = (_next: number) => {};

    const setPhase = (next: number, byUser = false) => {
      phase = (next + controls.length) % controls.length;
      const active = controls[phase];
      hero.dataset.phase = String(phase);
      controls.forEach((control, index) => {
        const selected = index === phase;
        control.classList.toggle('active', selected);
        control.setAttribute('aria-pressed', String(selected));
      });
      statusTitle.textContent = `${String(phase + 1).padStart(2, '0')} · ${active.dataset.title ?? ''}`;
      statusBody.textContent = active.dataset.body ?? '';
      updateScene(phase);
      hero.dispatchEvent(new CustomEvent('healthtag:hero-phase-change', { detail: { phase } }));
      if (byUser) {
        userControlled = true;
        stop();
      }
    };

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      if (userControlled || motionPaused || !visible || timer !== undefined || reducedMotion.matches) return;
      timer = window.setInterval(() => setPhase(phase + 1), 4200);
    };

    controls.forEach((control, index) => {
      control.addEventListener('click', () => setPhase(index, true));
      control.addEventListener('focus', () => stop());
      control.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'ArrowLeft' ? phase - 1 : event.key === 'ArrowRight' ? phase + 1 : event.key === 'Home' ? 0 : controls.length - 1;
        controls[(next + controls.length) % controls.length].focus();
        setPhase(next, true);
      });
    });

    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) start(); else stop();
      setSceneActive(visible && !motionPaused && !reducedMotion.matches);
    }, { threshold: 0.25 });
    observer.observe(hero);

    let setSceneActive = (_active: boolean) => {};
    const onMotionToggle = () => {
      if (!motionToggle || !motionIcon || !motionLabel) return;
      motionPaused = !motionPaused;
      motionIcon.textContent = motionPaused ? '▶' : 'Ⅱ';
      const nextLabel = motionPaused ? motionToggle.dataset.playLabel ?? '' : motionToggle.dataset.pauseLabel ?? '';
      motionLabel.textContent = nextLabel;
      motionToggle.setAttribute('aria-label', nextLabel);
      if (motionPaused) {
        stop();
        setSceneActive(false);
      } else {
        userControlled = false;
        start();
        setSceneActive(visible && !reducedMotion.matches);
      }
    };
    motionToggle?.addEventListener('click', onMotionToggle);

    if (sceneHost) {
      try {
        const scene = new THREE.Scene();
        scene.fog = new THREE.FogExp2(0x102f36, 0.052);
        const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 80);
        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'high-performance' });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
        renderer.setClearColor(0x102f36, 0);
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.domElement.className = 'hero-network-canvas';
        sceneHost.append(renderer.domElement);

        const mobile = window.matchMedia('(max-width: 700px)');
        const sceneTimer = new THREE.Timer();
        sceneTimer.connect(document);
        const teal = new THREE.Color(0x70d3c6);
        const amber = new THREE.Color(0xe2a55c);
        const nodeMaterial = new THREE.MeshStandardMaterial({ color: 0x1e6970, metalness: 0.42, roughness: 0.3, emissive: 0x0b4549, emissiveIntensity: 1.15 });
        const trustMaterial = new THREE.MeshStandardMaterial({ color: 0x0b988b, metalness: 0.35, roughness: 0.24, emissive: 0x00766f, emissiveIntensity: 1.45 });
        const patientMaterial = new THREE.MeshStandardMaterial({ color: 0x28747a, metalness: 0.42, roughness: 0.27, emissive: 0x0d565b, emissiveIntensity: 1.15 });
        const auditMaterial = new THREE.MeshStandardMaterial({ color: 0x72451b, metalness: 0.32, roughness: 0.34, emissive: 0x7a3f09, emissiveIntensity: 1.2 });
        const glowMaterial = (color: THREE.ColorRepresentation, opacity = 1) => new THREE.MeshBasicMaterial({ color, transparent: opacity < 1, opacity, blending: THREE.AdditiveBlending, depthWrite: false });
        const resources: Array<THREE.BufferGeometry | THREE.Material | THREE.Texture> = [nodeMaterial, trustMaterial, patientMaterial, auditMaterial];
        const root = new THREE.Group();
        root.position.x = mobile.matches ? .15 : 1.35;
        scene.add(root);
        scene.add(new THREE.HemisphereLight(0xa8e6db, 0x071d22, 1.6));
        const keyLight = new THREE.DirectionalLight(0x9ce8dc, 2.1); keyLight.position.set(-5, 7, 5); scene.add(keyLight);
        const rimLight = new THREE.PointLight(0x35d8c5, 11, 22); rimLight.position.set(3, 2, 4); scene.add(rimLight);
        const auditLight = new THREE.PointLight(0xf0a846, 4.5, 14); auditLight.position.set(4, -2, 2); scene.add(auditLight);

        const unitBox = new THREE.BoxGeometry(1, 1, 1);
        const unitEdges = new THREE.EdgesGeometry(unitBox);
        const unitPlate = new THREE.BoxGeometry(.72, .035, .72);
        const tealFrame = new THREE.LineBasicMaterial({ color: teal, transparent: true, opacity: .92 });
        const amberFrame = new THREE.LineBasicMaterial({ color: amber, transparent: true, opacity: .92 });
        const tealPlate = glowMaterial(teal, .72);
        const amberPlate = glowMaterial(amber, .72);
        resources.push(unitBox, unitEdges, unitPlate, tealFrame, amberFrame, tealPlate, amberPlate);

        const addNode = (position: THREE.Vector3, scale: THREE.Vector3, material: THREE.Material, glow: THREE.ColorRepresentation) => {
          const group = new THREE.Group(); group.position.copy(position);
          const body = new THREE.Mesh(unitBox, material); body.scale.copy(scale); group.add(body);
          const frame = new THREE.LineSegments(unitEdges, glow === amber ? amberFrame : tealFrame); frame.scale.copy(scale); group.add(frame);
          const plate = new THREE.Mesh(unitPlate, glow === amber ? amberPlate : tealPlate); plate.scale.set(scale.x, 1, scale.z); plate.position.y = scale.y / 2 + .025; group.add(plate);
          root.add(group); return group;
        };
        const crossGeometry = new THREE.BoxGeometry(1, 1, .12);
        const crossMaterial = glowMaterial(0xddf3eb, .9); resources.push(crossGeometry, crossMaterial);
        const addMedicalCross = (parent: THREE.Group, size = .28) => {
          const cross = new THREE.Group();
          const vertical = new THREE.Mesh(crossGeometry, crossMaterial); vertical.scale.set(size * .32, size, 1); cross.add(vertical);
          const horizontal = new THREE.Mesh(crossGeometry, crossMaterial); horizontal.scale.set(size, size * .32, 1); cross.add(horizontal);
          cross.position.set(0, parent.children[0].scale.y / 2 + .08, parent.children[0].scale.z / 2 + .08); parent.add(cross);
        };
        // This is a conceptual network: the six identical source boxes are not a
        // deployment map. The Wallet is a patient-facing access point, not a store
        // for the hospitals' clinical records.
        const center = new THREE.Vector3(1.85, .12, 0);
        const wallet = addNode(center.clone().add(new THREE.Vector3(0, .72, .08)), new THREE.Vector3(1.28, 1.58, .24), patientMaterial, teal);
        const cardLines = new THREE.Group();
        [0, 1, 2].forEach((index) => { const line = new THREE.Mesh(new THREE.BoxGeometry(.74 - index * .1, .045, .025), glowMaterial(0xddf3eb, .72)); line.position.set(-.18, .35 - index * .28, .235); cardLines.add(line); resources.push(line.geometry, line.material); });
        wallet.add(cardLines);
        const walletHaloPosition = center.clone().add(new THREE.Vector3(0, -.18, 0));
        const ringRadiusX = mobile.matches ? 2.15 : 2.8;
        const ringRadiusZ = mobile.matches ? 1.6 : 2.15;
        const hospitalScale = new THREE.Vector3(.62, .86, .6);
        const sourcePositions = Array.from({ length: 6 }, (_, index) => {
          const angle = index * Math.PI * 2 / 6;
          return new THREE.Vector3(center.x + Math.cos(angle) * ringRadiusX, center.y, Math.sin(angle) * ringRadiusZ);
        });
        const sourceHospitals = sourcePositions.map((position) => {
          const node = addNode(position, hospitalScale, nodeMaterial, teal);
          addMedicalCross(node, .23);
          return node;
        });
        // The audit layer is intentionally a small, linked record chain: it represents
        // consent/access events only, never a destination for clinical data.
        const auditChain = new THREE.Group(); auditChain.position.set(0, -1.9, .45); auditChain.visible = false; root.add(auditChain);
        // Keep the blocks and their links in one moving group so the audit record
        // reads as a continuous chain rather than unrelated boxes.
        const auditRing = new THREE.Group(); auditChain.add(auditRing);
        const auditBlockGeometry = new THREE.BoxGeometry(.54, .38, .5);
        const auditBlockEdges = new THREE.EdgesGeometry(auditBlockGeometry);
        const auditLinkMaterial = new THREE.LineBasicMaterial({ color: amber, transparent: true, opacity: .22 });
        const auditConnectorMaterial = new THREE.MeshBasicMaterial({ color: amber, transparent: true, opacity: .22, blending: THREE.AdditiveBlending, depthTest: true, depthWrite: false });
        resources.push(auditBlockGeometry, auditBlockEdges, auditLinkMaterial, auditConnectorMaterial);
        const auditBlocks: Array<{ group: THREE.Group; material: THREE.MeshStandardMaterial; base: THREE.Vector3 }> = [];
        const makeAuditBlock = (position: THREE.Vector3, parent = auditRing) => {
          const group = new THREE.Group(); group.position.copy(position);
          const material = auditMaterial.clone(); material.emissiveIntensity = .34; material.transparent = true; material.opacity = .86;
          const body = new THREE.Mesh(auditBlockGeometry, material);
          const frame = new THREE.LineSegments(auditBlockEdges, amberFrame); frame.scale.setScalar(1.015);
          const plate = new THREE.Mesh(unitPlate, amberPlate); plate.scale.set(.54 / .72, 1, .5 / .72); plate.position.y = .215;
          group.add(body, frame, plate); parent.add(group); resources.push(material);
          return { group, material, base: position.clone() };
        };
        const auditCount = mobile.matches ? 5 : 8;
        const auditBlockPositions = Array.from({ length: auditCount }, (_, index) => {
          const progress = index / Math.max(1, auditCount - 1);
          const spacing = mobile.matches ? .68 : .76;
          return new THREE.Vector3(-.35 + index * spacing, .1, -.05 + Math.sin(progress * Math.PI) * .34);
        });
        auditBlockPositions.forEach((position) => auditBlocks.push(makeAuditBlock(position)));
        const auditBlockHalfSize = new THREE.Vector3(.27, .19, .25);
        const blockSurfacePoint = (block: THREE.Vector3, toward: THREE.Vector3) => {
          const direction = toward.clone().sub(block);
          const scale = Math.min(
            auditBlockHalfSize.x / Math.max(Math.abs(direction.x), .0001),
            auditBlockHalfSize.y / Math.max(Math.abs(direction.y), .0001),
            auditBlockHalfSize.z / Math.max(Math.abs(direction.z), .0001),
          );
          return block.clone().add(direction.multiplyScalar(scale));
        };
        auditBlocks.slice(0, -1).forEach((block, index) => {
          const next = auditBlocks[index + 1];
          const start = blockSurfacePoint(block.base, next.base);
          const end = blockSurfacePoint(next.base, block.base);
          const geometry = new THREE.TubeGeometry(new THREE.LineCurve3(start, end), 4, .018, 6, false);
          const link = new THREE.Mesh(geometry, auditConnectorMaterial); auditRing.add(link); resources.push(geometry);
        });
        const pendingAuditBlock = makeAuditBlock(new THREE.Vector3(1.94, .78, .24));
        pendingAuditBlock.group.visible = false;
        const pendingAuditStart = pendingAuditBlock.base.clone();
        const pendingAuditTarget = blockSurfacePoint(auditBlocks[0].base, auditBlocks[1].base).add(new THREE.Vector3(-.24, .12, 0));
        const pendingLinkGeometry = new THREE.BufferGeometry();
        const pendingLinkPositions = new Float32Array(6); pendingLinkGeometry.setAttribute('position', new THREE.BufferAttribute(pendingLinkPositions, 3));
        const pendingLink = new THREE.Line(pendingLinkGeometry, auditLinkMaterial); pendingLink.visible = false; auditRing.add(pendingLink); resources.push(pendingLinkGeometry);
        const haloGeometry = new THREE.TorusGeometry(1.7, .016, 8, 80); const haloMaterial = new THREE.MeshBasicMaterial({ color: teal, transparent: true, opacity: .68, blending: THREE.AdditiveBlending, depthWrite: false }); resources.push(haloGeometry, haloMaterial);
        const halo = new THREE.Mesh(haloGeometry, haloMaterial); halo.rotation.x = Math.PI / 2; halo.position.copy(walletHaloPosition); root.add(halo);
        const haloOuter = new THREE.Mesh(haloGeometry, new THREE.MeshBasicMaterial({ color: 0x8bd9d1, transparent: true, opacity: .22, blending: THREE.AdditiveBlending, depthWrite: false })); haloOuter.scale.setScalar(1.55); resources.push(haloOuter.material); haloOuter.rotation.x = Math.PI / 2; haloOuter.position.copy(halo.position); root.add(haloOuter);
        const person = new THREE.Group();
        const head = new THREE.Mesh(new THREE.SphereGeometry(.3, 18, 12), glowMaterial(0xddf3eb)); resources.push(head.geometry, head.material); head.position.y = .55; person.add(head);
        const torso = new THREE.Mesh(new THREE.CapsuleGeometry(.25, .65, 4, 10), glowMaterial(0x70d3c6, .85)); resources.push(torso.geometry, torso.material); torso.position.y = -.05; person.add(torso); person.position.copy(wallet.position).add(new THREE.Vector3(.4, .12, .38)); person.scale.setScalar(.62); root.add(person);

        const makePath = (points: THREE.Vector3[], color: THREE.ColorRepresentation, dashed = false) => {
          const curve = new THREE.CatmullRomCurve3(points);
          const geometry = dashed
            ? new THREE.BufferGeometry().setFromPoints(curve.getPoints(56))
            : new THREE.TubeGeometry(curve, 56, .014, 6, false);
          const material = dashed
