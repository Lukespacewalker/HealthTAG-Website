---
import Base from '../layouts/Base.astro';
import FounderCard from './FounderCard.astro';
interface Props { locale:'th'|'en' }
const { locale }=Astro.props; const en=locale==='en'; const p=en?'/en':'';
const resources=['Patient','AllergyIntolerance','Encounter','MedicationDispense'];
const proof = en ? [
  ['NIA Corporate SPARK','China Program 2025','https://www.nia.or.th/Shanghai-CorporateSPARK2025'],
  ['ETDA Digital Service Sandbox','Testing goals met','https://www.etda.or.th/th/Our-Service/Digital-Service-Sandbox/announce.aspx'],
  ['APICTA 2022','Start-Up category winner','https://apicta.org/files/apicta_wl_2022.html'],
  ['Orbix × HealthTAG','Strategic collaboration','https://www.kasikornbank.com/en/news/pages/healthtag.aspx']
] : [
  ['NIA Corporate SPARK','China Program 2025','https://www.nia.or.th/Shanghai-CorporateSPARK2025'],
  ['ETDA Digital Service Sandbox','ผ่านเป้าหมายการทดสอบ','https://www.etda.or.th/th/Our-Service/Digital-Service-Sandbox/announce.aspx'],
  ['APICTA 2022','รางวัลชนะเลิศหมวด Start-Up','https://apicta.org/files/apicta_wl_2022.html'],
  ['Orbix × HealthTAG','ความร่วมมือเชิงยุทธศาสตร์','https://www.kasikornbank.com/th/news/pages/healthtag.aspx']
];
const capabilities = en ? [
  ['Connect data','Bring existing HIS data into an interoperable FHIR layer through hospital-owned integration or HealthTAG FHIR Transformer.','/interoperability/'],
  ['Connect identity','Link hospital-local identities with PromptCare ID so one patient can be recognized across providers.','/how-it-works/'],
  ['Control access','Authorize data exchange through a time-limited, auditable access model.','/trust/']
] : [
  ['เชื่อมข้อมูล','นำข้อมูลจาก HIS เดิมเข้าสู่ FHIR layer ผ่านการเชื่อมระบบของโรงพยาบาลเองหรือ HealthTAG FHIR Transformer','/interoperability/'],
  ['เชื่อมตัวตนผู้ป่วย','เชื่อมตัวตนผู้ป่วยเฉพาะโรงพยาบาลกับ PromptCare ID เพื่อระบุผู้ป่วยคนเดียวกันข้ามสถานพยาบาล','/how-it-works/'],
  ['ควบคุมการเข้าถึง','อนุญาตการแลกเปลี่ยนข้อมูลด้วยสิทธิ์ที่มีอายุจำกัดและตรวจสอบย้อนหลังได้','/trust/']
];
---
<Base locale={locale} title={en?'HealthTAG | Healthcare interoperability with hospitals in control':'HealthTAG | เชื่อมข้อมูลสุขภาพโดยโรงพยาบาลยังควบคุมข้อมูล'} description={en?'HealthTAG connects hospital-controlled healthcare data with identity, authorization, PHR, and trusted exchange.':'HealthTAG เชื่อมข้อมูลสุขภาพที่โรงพยาบาลควบคุมเองเข้ากับตัวตนผู้ป่วย การอนุญาต PHR และการแลกเปลี่ยนข้อมูลที่ตรวจสอบย้อนหลังได้'}>
<main>
<section class="hero"><div class="container hero-grid"><div><div class="eyebrow">{en?'Healthcare interoperability infrastructure':'โครงสร้างพื้นฐานเพื่อการเชื่อมโยงข้อมูลสุขภาพ'}</div><h1>{en?'Connect health information. Keep hospitals in control.':'เชื่อมข้อมูลสุขภาพ โดยโรงพยาบาลยังเป็นผู้ควบคุม'}</h1><p>{en?'HealthTAG connects existing hospital systems to interoperable health data, patient identity, controlled access, and PHR without forcing hospitals to replace their core HIS.':'HealthTAG เชื่อมระบบโรงพยาบาลเดิมเข้ากับข้อมูลที่แลกเปลี่ยนได้ ตัวตนผู้ป่วย การควบคุมสิทธิ์ และ PHR โดยไม่บังคับให้โรงพยาบาลเปลี่ยน HIS หลัก'}</p><div class="actions"><a class="btn primary" href={`${p}/interoperability/`}>{en?'Explore the platform':'ดูแพลตฟอร์ม'}</a><a class="btn secondary" href={`${p}/deployments/`}>{en?'See deployments':'ดูการติดตั้งใช้งาน'}</a></div></div><div class="topology-card" role="img" aria-label={en?'Conceptual architecture: existing HIS uses a hospital IT script or FHIR Transformer to reach the hospital-controlled FHIR layer; Kong and HealthTAG Module protect authorized exchange to PHR applications; consent and access events, but not clinical records, go to the audit ledger.' : 'สถาปัตยกรรมเชิงแนวคิด: HIS เดิมใช้สคริปต์ของโรงพยาบาลหรือ FHIR Transformer เพื่อนำข้อมูลเข้าสู่ FHIR layer ที่โรงพยาบาลควบคุม; Kong และ HealthTAG Module ปกป้องการแลกเปลี่ยนตามสิทธิ์ไปยัง PHR; มีเพียงเหตุการณ์การให้ความยินยอมและการเข้าถึง ไม่ใช่เวชระเบียน ที่เข้าสู่ประวัติตรวจสอบ'}><div class="boundary-label">{en?'Conceptual · hospital-controlled environment':'ภาพเชิงแนวคิด · สภาพแวดล้อมที่โรงพยาบาลควบคุม'}</div><div class="topology-ingress"><div class="topology-node"><strong>Existing HIS</strong><small>{en?'Hospital system':'ระบบเดิม'}</small></div><div class="topology-split"><span>↓</span><div><b>IT Script</b><b>FHIR Transformer</b></div><span>↓</span></div></div><div class="topology-fhir"><strong>FHIR Layer</strong><span>HL7 FHIR R4</span><em>{en?'Hospital controlled':'โรงพยาบาลควบคุม'}</em></div><div class="topology-edge"><div><strong>Kong API Gateway</strong><small>{en?'API boundary':'ขอบเขต API'}</small></div><div><strong>HealthTAG Module</strong><small>{en?'Identity · Authorization':'ตัวตน · การอนุญาต'}</small></div></div><div class="topology-out">↓ {en?'Authorized exchange':'แลกเปลี่ยนตามสิทธิ์'} ↓</div><div class="topology-dest"><span>PHR</span><span>{en?'Authorized apps':'แอปที่ได้รับสิทธิ์'}</span></div><div class="topology-audit"><strong>{en?'Consent/access events → audit ledger':'เหตุการณ์การให้ความยินยอม/การเข้าถึง → ประวัติตรวจสอบ'}</strong><small>{en?'No clinical records on blockchain':'ไม่มีเวชระเบียนบน blockchain'}</small></div></div></div></section>

<section class="proof-band"><div class="container"><div class="proof-band-head"><div><div class="eyebrow">{en?'Evidence':'หลักฐาน'}</div><h2>{en?'Validated beyond the product deck.':'ไม่ได้มีแค่คำกล่าวอ้างจากบริษัท'}</h2></div><a href={`${p}/evidence/`}>{en?'See all evidence & sources':'ดูหลักฐานและแหล่งข้อมูลทั้งหมด'} →</a></div><div class="proof-row">{proof.map(([title,meta,href])=><a class="proof-item" href={href} target="_blank" rel="noopener noreferrer"><strong>{title}</strong><span>{meta}</span><i>↗</i></a>)}</div></div></section>

<section class="section"><div class="container"><div class="section-head"><h2>{en?'What HealthTAG does':'HealthTAG ทำอะไร'}</h2><p>{en?'Three responsibilities, separated so hospitals can adopt only what they need.':'แยกความรับผิดชอบเป็นสามส่วน เพื่อให้โรงพยาบาลเลือกใช้เท่าที่จำเป็น'}</p></div><div class="product-grid">{capabilities.map(([title,body,path])=><article class="card"><div class="kicker">HealthTAG Platform</div><h3>{title}</h3><p>{body}</p><div class="actions"><a class="btn secondary" href={`${p}${path}`}>{en?'Learn more':'ดูรายละเอียด'}</a></div></article>)}</div></div></section>

<section class="section"><div class="container"><div class="section-head"><h2>{en?'Two hospitals. Two ingestion paths.':'สองโรงพยาบาล สองทางเลือกในการนำข้อมูลเข้าสู่ FHIR'}</h2><p>{en?'The platform does not require every hospital to use the same connector.':'แพลตฟอร์มไม่ได้บังคับให้ทุกโรงพยาบาลใช้ connector แบบเดียวกัน'}</p></div><div class="case-spread"><article><div class="kicker">Siriraj 5G Smart Hospital</div><h3>{en?'Hospital-owned ingestion':'โรงพยาบาลพัฒนาการนำข้อมูลเข้าเอง'}</h3><p>{en?'Siriraj IT uses its own script to populate the hospital FHIR Server. HealthTAG participated in the Permission-based Blockchain for Personal Health Record workstream.':'ทีม IT ศิริราชใช้ script ของตนเองนำข้อมูลเข้า FHIR Server และ HealthTAG เข้าร่วมในโครงการย่อย Permission-based Blockchain for Personal Health Record'}</p><a href={`${p}/deployments/`}>{en?'Read deployment scope':'ดูขอบเขตการติดตั้งใช้งาน'} →</a></article><article><div class="kicker">Khian Sa Hospital</div><h3>HealthTAG FHIR Transformer</h3><p>{en?'Selected HIS data is mapped into HL7 FHIR R4 resources through HealthTAG FHIR Transformer.':'ข้อมูลที่กำหนดจาก HIS ถูกแปลงเป็น HL7 FHIR R4 ด้วย HealthTAG FHIR Transformer'}</p><div class="resource-list">{resources.map(r=><span class="chip">{r}</span>)}</div></article></div></div></section>

<section class="section product-story"><div class="container product-story-grid"><div><div class="eyebrow">Personal Health Record</div><h2>{en?'Connected data becomes useful when patients can use it.':'ข้อมูลที่เชื่อมกันจะมีความหมายเมื่อผู้ป่วยใช้ประโยชน์ได้จริง'}</h2><p>{en?'The PHR brings authorized records into a patient-facing view. The interface shown here is illustrative, uses synthetic data, and is not a screenshot of the current product or proof of exchange between named hospitals.':'PHR นำข้อมูลที่ได้รับอนุญาตมาแสดงสำหรับผู้ป่วย หน้าจอนี้เป็นภาพประกอบ ใช้ข้อมูลสังเคราะห์ ไม่ใช่ภาพหน้าจอผลิตภัณฑ์ปัจจุบันหรือหลักฐานการแลกเปลี่ยนข้อมูลระหว่างโรงพยาบาลที่ระบุชื่อ'}</p><div class="actions"><a class="btn secondary" href={`${p}/phr/`}>{en?'Explore PHR':'ดู PHR'}</a><a class="btn secondary" href="https://phr.healthtag.io" target="_blank" rel="noopener noreferrer" aria-label={en?'Open the HealthTAG PHR website in a new tab':'เปิดเว็บไซต์ HealthTAG PHR ในแท็บใหม่'}>{en?'Open PHR website':'เปิดเว็บไซต์ PHR'} ↗</a></div></div><div class="phr-window" aria-label={en?'Illustrative PHR interface using synthetic data':'ภาพประกอบหน้าจอ PHR ที่ใช้ข้อมูลสังเคราะห์'}><div class="phr-bar"><span></span><strong>{en?'Illustrative interface · synthetic data':'ภาพประกอบ · ข้อมูลสังเคราะห์'}</strong></div><div class="phr-profile"><div class="avatar">PT</div><div><strong>PromptCare ID · PC-02814</strong><small>{en?'Illustrative providers: 2':'ผู้ให้บริการในภาพประกอบ: 2'}</small></div><span class="access-live">{en?'Access window · 15 minutes':'ช่วงเวลาการเข้าถึง · 15 นาที'}</span></div><div class="phr-tabs"><b>{en?'Timeline':'ไทม์ไลน์'}</b><span>{en?'Allergies':'การแพ้ยา'}</span><span>{en?'Medicines':'ยา'}</span></div><div class="phr-record"><time>12 AUG</time><div><strong>{en?'Outpatient encounter':'การรับบริการผู้ป่วยนอก'}</strong><small>{en?'Provider A':'ผู้ให้บริการ A'} · Encounter</small></div></div><div class="phr-record"><time>04 JUL</time><div><strong>Amoxicillin</strong><small>{en?'Provider B':'ผู้ให้บริการ B'} · MedicationDispense</small></div></div><div class="phr-consent"><strong>{en?'Authorized access':'การเข้าถึงที่ได้รับอนุญาต'}</strong><span>{en?'Time-limited':'มีเวลาจำกัด'}</span></div></div></div></section>

<section class="section"><div class="container company-grid"><div><div class="eyebrow">Vision</div><h2>{en?'Health information should reach the right person, in the right form, at the right time.':'ข้อมูลสุขภาพควรไปถึงคนที่ต้องใช้ ในรูปแบบและเวลาที่เหมาะสม'}</h2><p class="lead-copy">{en?'HealthTAG was built around a clinical problem: health information often exists, but does not move with the patient when it is needed.':'HealthTAG เริ่มจากปัญหาทางคลินิกที่ข้อมูลสุขภาพมักมีอยู่แล้ว แต่ยังไปกับผู้ป่วยเมื่อจำเป็นได้ไม่ดีพอ'}</p></div><FounderCard locale={locale} /></div></section>

<section class="section final-cta"><div class="container"><div class="section-head"><h2>{en?'Talk to HealthTAG about your hospital data flow.':'คุยกับ HealthTAG เรื่องการเชื่อมข้อมูลโรงพยาบาลของคุณ'}</h2><p>{en?'For interoperability, deployment, partnership, or technical discussions.':'สำหรับการเชื่อมโยงข้อมูล การติดตั้งใช้งาน ความร่วมมือ หรือการพูดคุยเชิงเทคนิค'}</p></div><div class="actions"><a class="btn primary" href={`${p}/contact/`}>{en?'Contact HealthTAG':'ติดต่อ HealthTAG'}</a><a class="btn secondary" href={`${p}/evidence/`}>{en?'Review evidence first':'ดูหลักฐานก่อน'}</a></div></div></section>
</main></Base>
