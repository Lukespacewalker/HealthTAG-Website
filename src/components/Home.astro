---
import Base from '../layouts/Base.astro';
interface Props { locale:'th'|'en' }
const { locale }=Astro.props; const en=locale==='en'; const p=en?'/en':'';
const resources=['Patient','AllergyIntolerance','Encounter','MedicationDispense'];
const proof = en ? [
  ['Siriraj 5G Smart Hospital','PHR workstream','https://si.mahidol.ac.th/th/hotnewsdetail.asp?hn_id=2728'],
  ['ETDA Digital Service Sandbox','Testing goals met','https://www.etda.or.th/th/Our-Service/Digital-Service-Sandbox/announce.aspx'],
  ['APICTA 2022','Start-Up category winner','https://www.cioworldbusiness.com/thai-digital-technology-company-that-won-the-apicta-2022-award/'],
  ['Orbix × HealthTAG','Strategic collaboration','https://www.kasikornbank.com/en/news/pages/healthtag.aspx']
] : [
  ['Siriraj 5G Smart Hospital','โครงการย่อยด้าน PHR','https://si.mahidol.ac.th/th/hotnewsdetail.asp?hn_id=2728'],
  ['ETDA Digital Service Sandbox','ผ่านเป้าหมายการทดสอบ','https://www.etda.or.th/th/Our-Service/Digital-Service-Sandbox/announce.aspx'],
  ['APICTA 2022','รางวัลชนะเลิศหมวด Start-Up','https://www.cioworldbusiness.com/thai-digital-technology-company-that-won-the-apicta-2022-award/'],
  ['Orbix × HealthTAG','ความร่วมมือเชิงยุทธศาสตร์','https://www.kasikornbank.com/th/news/pages/healthtag.aspx']
];
---
<Base locale={locale} title={en?'HealthTAG | Healthcare interoperability with hospitals in control':'HealthTAG | เชื่อมข้อมูลสุขภาพโดยโรงพยาบาลยังควบคุมข้อมูล'} description={en?'HealthTAG connects hospital-controlled HL7 FHIR R4 infrastructure with identity, authorization, PHR, and auditable data exchange.':'HealthTAG เชื่อมโครงสร้างข้อมูล HL7 FHIR R4 ที่โรงพยาบาลควบคุมเอง เข้ากับ identity, authorization, PHR และการแลกเปลี่ยนข้อมูลที่ตรวจสอบย้อนหลังได้'}>
<main>
<section class="hero"><div class="container hero-grid"><div><div class="eyebrow">{en?'Healthcare interoperability infrastructure':'โครงสร้างพื้นฐานเพื่อการเชื่อมโยงข้อมูลสุขภาพ'}</div><h1>{en?'Connect health information. Keep hospitals in control.':'เชื่อมข้อมูลสุขภาพ โดยโรงพยาบาลยังเป็นผู้ควบคุม'}</h1><p>{en?'HealthTAG connects hospital-controlled FHIR infrastructure to patient identity, authorization, PHR, and trusted exchange without requiring hospitals to replace their existing HIS or surrender custody of clinical data.':'HealthTAG เชื่อม FHIR infrastructure ที่โรงพยาบาลควบคุมเองเข้ากับตัวตนผู้ป่วย การตรวจสอบสิทธิ์ PHR และการแลกเปลี่ยนข้อมูล โดยไม่บังคับให้เปลี่ยน HIS เดิมหรือยกการถือครองข้อมูลให้ vendor'}</p><div class="actions"><a class="btn primary" href={`${p}/interoperability/`}>{en?'Explore the platform':'ดูแพลตฟอร์ม'}</a><a class="btn secondary" href={`${p}/deployments/`}>{en?'See deployments':'ดูการใช้งานจริง'}</a></div></div><div class="topology-card" aria-label={en?'HealthTAG hospital source node architecture':'สถาปัตยกรรม HealthTAG ฝั่งโรงพยาบาล'}><div class="boundary-label">{en?'Hospital network':'เครือข่ายโรงพยาบาล'}</div><div class="topology-ingress"><div class="topology-node"><strong>Existing HIS</strong><small>{en?'Hospital system':'ระบบเดิม'}</small></div><div class="topology-split"><span>↓</span><div><b>{en?'IT Script':'IT Script'}</b><b>FHIR Transformer</b></div><span>↓</span></div></div><div class="topology-fhir"><strong>HAPI FHIR Server</strong><span>HL7 FHIR R4 · PostgreSQL</span><em>{en?'Hospital controlled':'โรงพยาบาลควบคุม'}</em></div><div class="topology-edge"><div><strong>Kong API Gateway</strong><small>{en?'Protects FHIR API':'ครอบ FHIR API'}</small></div><div><strong>HealthTAG Module</strong><small>Hospital API · Identity · Authorization</small></div></div><div class="topology-out">↓ {en?'Authorized exchange':'แลกเปลี่ยนตามสิทธิ์'} ↓</div><div class="topology-dest"><span>PHR</span><span>{en?'Authorized apps':'แอปที่ได้รับสิทธิ์'}</span><span class="audit-pill">Audit ledger</span></div></div></div></section>
<section class="proof-band"><div class="container"><div class="proof-band-head"><div><div class="eyebrow">{en?'Evidence':'หลักฐาน'}</div><h2>{en?'Validated beyond the product deck.':'ไม่ได้มีแค่คำกล่าวอ้างจากบริษัท'}</h2></div><a href={`${p}/evidence/`}>{en?'See all evidence & sources':'ดูหลักฐานและแหล่งข้อมูลทั้งหมด'} →</a></div><div class="proof-row">{proof.map(([title,meta,href])=><a class="proof-item" href={href} target="_blank" rel="noopener noreferrer"><strong>{title}</strong><span>{meta}</span><i>↗</i></a>)}</div></div></section>
<section class="section"><div class="container"><div class="section-head"><h2>{en?'Two hospitals. Two ingestion paths.':'สองโรงพยาบาล สอง ingestion path'}</h2><p>{en?'The architecture does not require every hospital to use the same connector. Siriraj uses its own IT script; Khian Sa uses HealthTAG FHIR Transformer.':'สถาปัตยกรรมไม่ได้บังคับให้ทุกโรงพยาบาลใช้ connector แบบเดียวกัน ศิริราชใช้ IT Script ของตนเอง ส่วนเคียนซาใช้ HealthTAG FHIR Transformer'}</p></div><div class="case-spread"><article><div class="kicker">Siriraj 5G Smart Hospital</div><h3>{en?'Hospital-owned ingestion':'โรงพยาบาลพัฒนา ingestion เอง'}</h3><p>{en?'Siriraj IT extracts HIS data into the hospital FHIR Server with its own script. HealthTAG participated in the Permission-based Blockchain for Personal Health Record workstream.':'ทีม IT ศิริราชใช้ script ของตนเองนำข้อมูล HIS เข้า FHIR Server และ HealthTAG เข้าร่วมในโครงการย่อย Permission-based Blockchain for Personal Health Record'}</p><a href={`${p}/deployments/`}>{en?'Read deployment scope':'ดูขอบเขต deployment'} →</a></article><article><div class="kicker">Khian Sa Hospital</div><h3>HealthTAG FHIR Transformer</h3><p>{en?'Selected HIS data is mapped into HL7 FHIR R4 resources through HealthTAG FHIR Transformer.':'ข้อมูลที่กำหนดจาก HIS ถูกแปลงเป็น HL7 FHIR R4 ด้วย HealthTAG FHIR Transformer'}</p><div class="resource-list">{resources.map(r=><span class="chip">{r}</span>)}</div></article></div></div></section>
<section class="dark-section"><div class="container"><div class="section-head"><h2>{en?'Six layers, one clear responsibility each.':'6 ชั้น แต่ละชั้นมีหน้าที่ชัดเจน'}</h2><p>{en?'Separate ingestion, standardization, identity, authorization, exchange, and audit so the clinical-data layer can remain under hospital control.':'แยก ingestion, standardization, identity, authorization, exchange และ audit เพื่อให้ clinical-data layer ยังคงอยู่ภายใต้การควบคุมของโรงพยาบาล'}</p></div><div class="steps six">{[['01','CONNECT','IT Script / Transformer'],['02','STANDARDIZE','HAPI FHIR · R4'],['03','IDENTIFY','Local ID → PromptCare ID'],['04','AUTHORIZE','15-minute access'],['05','EXCHANGE','Authorized FHIR'],['06','AUDIT','Consent + access']].map(s=><article class="step"><div class="step-num">{s[0]}</div><h3>{s[1]}</h3><p>{s[2]}</p></article>)}</div></div></section>
<section class="section product-story"><div class="container product-story-grid"><div><div class="eyebrow">Personal Health Record</div><h2>{en?'Infrastructure becomes useful when patients can actually use it.':'Infrastructure จะมีความหมายเมื่อผู้ป่วยใช้ประโยชน์จากมันได้จริง'}</h2><p>{en?'The PHR brings authorized records from multiple providers into one patient-facing view. The interface shown here uses synthetic data and illustrates the intended information model, not a live patient account.':'PHR รวมข้อมูลที่ได้รับอนุญาตจากหลายผู้ให้บริการมาเป็นมุมมองเดียวสำหรับผู้ป่วย หน้าจอนี้ใช้ข้อมูลสังเคราะห์เพื่ออธิบาย information model ไม่ใช่บัญชีผู้ป่วยจริง'}</p><div class="actions"><a class="btn secondary" href={`${p}/phr/`}>{en?'Explore PHR':'ดู PHR'}</a><a class="btn secondary" href="https://phr.healthtag.io" target="_blank" rel="noopener noreferrer">{en?'Open PHR':'เปิด PHR'} ↗</a></div></div><div class="phr-window"><div class="phr-bar"><span></span><strong>{en?'Synthetic demo':'ตัวอย่างข้อมูลสังเคราะห์'}</strong></div><div class="phr-profile"><div class="avatar">PT</div><div><strong>PromptCare ID · PC-02814</strong><small>{en?'Connected providers: 2':'เชื่อมข้อมูลจาก 2 สถานพยาบาล'}</small></div><span class="access-live">15:00</span></div><div class="phr-tabs"><b>{en?'Timeline':'ไทม์ไลน์'}</b><span>{en?'Allergies':'การแพ้ยา'}</span><span>{en?'Medicines':'ยา'}</span></div><div class="phr-record"><time>12 AUG</time><div><strong>{en?'Outpatient encounter':'การรับบริการผู้ป่วยนอก'}</strong><small>Siriraj Hospital · Encounter</small></div></div><div class="phr-record"><time>04 JUL</time><div><strong>Amoxicillin</strong><small>Khian Sa Hospital · MedicationDispense</small></div></div><div class="phr-consent"><strong>{en?'Access granted':'อนุญาตการเข้าถึง'}</strong><span>{en?'Expires automatically after 15 minutes':'หมดอายุอัตโนมัติหลัง 15 นาที'}</span></div></div></div></section>
<section class="section"><div class="container trust-strip"><div class="trust-copy"><div class="eyebrow">Trust architecture</div><h2>{en?'The hospital keeps the clinical record.':'ข้อมูลเวชระเบียนยังอยู่กับโรงพยาบาล'}</h2><p>{en?'HAPI FHIR Server and PostgreSQL remain under hospital control. Blockchain is used for consent and access audit history, not as the clinical database.':'HAPI FHIR Server และ PostgreSQL อยู่ภายใต้การควบคุมของโรงพยาบาล ส่วน blockchain ใช้สำหรับประวัติ consent และ access ไม่ใช่ฐานข้อมูลเวชระเบียน'}</p><div class="actions"><a class="btn secondary" href={`${p}/trust/`}>{en?'Read the trust model':'อ่าน Trust Model'}</a></div></div><aside class="trust-ledger"><div class="system-label">Illustrative 15-minute access</div><div class="ledger-event">09:42 consent.granted</div><div class="ledger-event">09:42 access.authorized</div><div class="ledger-event">09:47 fhir.read</div><div class="ledger-event">09:57 authorization.expired</div></aside></div></section>
<section class="section"><div class="container"><div class="section-head"><h2>{en?'A network, not a claim counter.':'เครือข่ายที่มีชื่อจริง ไม่ใช่ตัวเลขลอย ๆ'}</h2><p>{en?'Partner relationships are shown separately from production deployments. Historical HealthTAG materials identify hospital partners including Siriraj, Mahidol, Piyavate, Thammasat, and Khon Kaen.':'ความสัมพันธ์แบบ partner ถูกแยกจาก production deployment โดยข้อมูล HealthTAG เดิมระบุ hospital partners เช่น ศิริราช มหิดล ปิยะเวท ธรรมศาสตร์ และขอนแก่น'}</p></div><div class="partner-wordmarks">{['Siriraj','Mahidol','Piyavate','Thammasat','Khon Kaen'].map(x=><span>{x}</span>)}</div><div class="actions"><a class="btn secondary" href={`${p}/network/`}>{en?'View network context':'ดูบริบทเครือข่าย'}</a></div></div></section>
<section class="section"><div class="container company-grid"><div><div class="eyebrow">Vision</div><h2>{en?'Health information should reach the right person, in the right form, at the right time.':'ข้อมูลสุขภาพควรไปถึงคนที่ต้องใช้ ในรูปแบบและเวลาที่เหมาะสม'}</h2><p class="lead-copy">{en?'Connected care should not require hospitals to surrender custody of their data or replace systems they already depend on.':'Connected care ไม่ควรบังคับให้โรงพยาบาลยกการถือครองข้อมูลหรือเปลี่ยนระบบหลักที่ยังใช้งานได้ดี'}</p></div><article class="card founder-card"><div class="kicker">CEO & Founder</div><h3>{en?'Dechowat Promda, M.D.':'นพ. เดโชวัต พรมดา'}</h3><p>{en?'HealthTAG began from a physician’s observation that health information often already exists, but still fails to move with the patient when it is needed.':'HealthTAG เริ่มจากข้อสังเกตของแพทย์ว่า ข้อมูลสุขภาพมักมีอยู่แล้ว แต่ยังไม่สามารถเดินทางไปกับผู้ป่วยเมื่อจำเป็นได้ดีพอ'}</p><p class="founder-meta">{en?'Doctor of Medicine, Khon Kaen University · APICTA 2022 Start-Up winner':'แพทยศาสตรบัณฑิต มหาวิทยาลัยขอนแก่น · ผู้ชนะ APICTA 2022 หมวด Start-Up'}</p><div class="actions"><a class="btn secondary" href={`${p}/company/`}>{en?'Meet the company':'รู้จักบริษัท'}</a></div></article></div></section>
</main></Base>
