---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import overviewScreen from '../assets/phr/phr-overview-redacted.png';
import { publications } from '../data/publications';
import FounderCard from './FounderCard.astro';
interface Props { locale:'th'|'en' }
const { locale }=Astro.props; const en=locale==='en'; const p=en?'/en':'';
const heroStory = publications.find((item) => item.id === 'digital-health-forum-2026');
if (!heroStory?.images?.[0]) throw new Error('Missing Digital Health Forum hero story');
const heroStoryImage = heroStory.images[0];
const resources=['Patient','AllergyIntolerance','Encounter','MedicationDispense'];
const proof = en ? [
  ['NIA Corporate SPARK','China Program 2025','https://www.nia.or.th/Shanghai-CorporateSPARK2025'],
  ['ETDA Digital Service Sandbox','Testing goals met','https://www.etda.or.th/th/Our-Service/Digital-Service-Sandbox/announce.aspx'],
  ['APICTA 2022','Start-Up category winner','https://apicta.org/files/apicta_wl_2022.html'],
  ['Orbix × HealthTAG','Strategic collaboration','https://www.kasikornbank.com/en/news/pages/healthtag.aspx']
] : [
  ['NIA Corporate SPARK','China Program 2025','https://www.nia.or.th/Shanghai-CorporateSPARK2025'],
  ['ETDA Digital Service Sandbox','ผ่านเป้าหมายการทดสอบ','https://www.etda.or.th/th/Our-Service/Digital-Service-Sandbox/announce.aspx'],
  ['APICTA 2022','รางวัลชนะเลิศหมวด Start-Up','https://apicta.org/files/apicta_wl_2022.html'],
  ['Orbix × HealthTAG','ความร่วมมือเชิงยุทธศาสตร์','https://www.kasikornbank.com/th/news/pages/healthtag.aspx']
];
const capabilities = en ? [
  ['Connect data','Send data from an existing HIS to the hospital FHIR system through an IT-managed script or HealthTAG FHIR Transformer.','/interoperability/','Read about interoperability'],
  ['Connect identity','Link hospital-local identities with PromptCare ID so one patient can be recognized across providers.','/how-it-works/','See the exchange flow'],
  ['Check consent and access','Use consent-aware authorization and an auditable, time-limited access model before returning permitted data.','/trust/','Read about consent and access']
] : [
  ['เชื่อมข้อมูล','ส่งข้อมูลจาก HIS เดิมเข้าสู่ระบบ FHIR ของโรงพยาบาล ผ่านสคริปต์ของทีม IT หรือ HealthTAG FHIR Transformer','/interoperability/','อ่านเรื่องการเชื่อมโยงข้อมูล'],
  ['เชื่อมตัวตนผู้ป่วย','เชื่อมตัวตนผู้ป่วยเฉพาะโรงพยาบาลกับ PromptCare ID เพื่อระบุผู้ป่วยคนเดียวกันข้ามสถานพยาบาล','/how-it-works/','ดูขั้นตอนการแลกเปลี่ยนข้อมูล'],
  ['ตรวจความยินยอมและสิทธิ์','ใช้การตรวจสิทธิ์ที่คำนึงถึงความยินยอม พร้อมจำกัดเวลาและบันทึกเหตุการณ์ให้ตรวจสอบย้อนหลังได้','/trust/','อ่านเรื่องความยินยอมและสิทธิ์']
];
const founderPillars = en ? [
  ['01','Patient ownership','Health data belongs to the patient. Consent determines whether and how that data may be used.','/trust/'],
  ['02','Hospital stewardship','Hospitals keep clinical records in source systems and remain responsible for operating and protecting those systems.','/interoperability/'],
  ['03','A connected Thailand','HealthTAG is building toward permitted health information connecting across institutions on open standards.','/company/#mission-vision']
] : [
  ['01','ผู้ป่วยเป็นเจ้าของข้อมูล','ข้อมูลสุขภาพเป็นของผู้ป่วย ความยินยอมเป็นตัวกำหนดว่าจะใช้ข้อมูลได้หรือไม่และใช้อย่างไร','/trust/'],
  ['02','โรงพยาบาลดูแลเวชระเบียน','โรงพยาบาลเก็บรักษาเวชระเบียนในระบบต้นทาง และรับผิดชอบการทำงานกับการปกป้องระบบเหล่านั้น','/interoperability/'],
  ['03','ประเทศไทยที่เชื่อมถึงกัน','HealthTAG กำลังสร้างระบบที่ช่วยให้ข้อมูลสุขภาพตามความยินยอมเชื่อมระหว่างสถาบันบนมาตรฐานเปิด','/company/#mission-vision']
];
---
<Base locale={locale} title={en?'HealthTAG | Your data. Your consent. One connected Thailand.':'HealthTAG | ข้อมูลของคุณ ความยินยอมของคุณ เชื่อมถึงกันทั้งประเทศ'} description={en?'HealthTAG connects patient-owned health data through consent-aware infrastructure while hospitals steward clinical records in source systems.':'HealthTAG เชื่อมข้อมูลสุขภาพที่เป็นของผู้ป่วยผ่านโครงสร้างพื้นฐานที่คำนึงถึงความยินยอม โดยโรงพยาบาลเก็บรักษาและดูแลเวชระเบียนในระบบต้นทาง'}>
<main>
<section class="hero home-hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">{en ? "HealthTAG's vision" : 'วิสัยทัศน์ของ HealthTAG'}</div>
        <h1>
          <span>{en ? 'Your data.' : 'ข้อมูลของคุณ'}</span>
          <span>{en ? 'Your consent.' : 'ความยินยอมของคุณ'}</span>
          <span>{en ? 'One connected Thailand.' : 'เชื่อมถึงกันทั้งประเทศ'}</span>
        </h1>
        <p>{en
          ? 'HealthTAG PHR presents the health information available and permitted for each patient. Hospitals continue to store and steward the original clinical records in their source systems.'
          : 'HealthTAG PHR แสดงข้อมูลสุขภาพที่มีอยู่และได้รับอนุญาตสำหรับผู้ป่วยแต่ละคน ขณะที่โรงพยาบาลยังจัดเก็บและดูแลเวชระเบียนต้นฉบับในระบบต้นทาง'}</p>
        <div class="actions">
          <a class="btn primary" href={`${p}/phr/`}>{en ? 'Explore the PHR' : 'ดูหน้าจอ PHR'}</a>
          <a class="btn secondary" href={`${p}/how-it-works/`}>{en ? 'See how data reaches the PHR' : 'ดูเส้นทางข้อมูลมายัง PHR'}</a>
        </div>
      </div>
      <figure class="hero-product">
        <div class="hero-product-bar" aria-hidden="true"><span></span><span></span><span></span><strong>HealthTAG PHR</strong></div>
        <div class="hero-product-screen">
          <Image
            src={overviewScreen}
            alt={en
              ? 'HealthTAG PHR overview showing a health score, clinical and biological summaries, and continuous readings'
              : 'หน้าภาพรวม HealthTAG PHR แสดงคะแนนสุขภาพ สรุปข้อมูลทางคลินิกและชีวภาพ และข้อมูลต่อเนื่อง'}
            width={overviewScreen.width}
            height={overviewScreen.height}
            widths={[720, 960, 1440]}
            sizes="(max-width: 900px) calc(100vw - 28px), 58vw"
            format="webp"
            quality={86}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </figure>
    </div>

    <a class="hero-story" href={`${p}/news/#publication-${heroStory.id}`}>
      <figure>
        <Image
          src={heroStoryImage.src}
          alt={heroStoryImage.alt[locale]}
          width={heroStoryImage.src.width}
          height={heroStoryImage.src.height}
          widths={[240, 360, 480]}
          sizes="(max-width: 620px) calc(100vw - 28px), 180px"
          format="webp"
          quality={82}
          loading="eager"
          decoding="async"
        />
      </figure>
      <div class="hero-story-copy">
        <span>{en ? 'Latest news · 25 and 26 Aug 2026' : 'ข่าวล่าสุด · 25 และ 26 ส.ค. 2569'}</span>
        <h2>{heroStory.title[locale]}</h2>
        <p>{heroStory.summary[locale]}</p>
      </div>
      <i aria-hidden="true">→</i>
    </a>
  </div>
</section>

<section class="governance-section"><div class="container"><div class="governance-head"><h2>{en?'Who owns the data, who keeps the records, and who connects the systems':'ใครเป็นเจ้าของข้อมูล ใครเก็บเวชระเบียน และใครเชื่อมระบบ'}</h2><p>{en?'These roles are separate. The patient owns the health data, the hospital stewards the clinical record, and HealthTAG provides the infrastructure for permitted exchange.':'ทั้งสามบทบาทแยกจากกัน ผู้ป่วยเป็นเจ้าของข้อมูลสุขภาพ โรงพยาบาลดูแลเวชระเบียน และ HealthTAG จัดโครงสร้างพื้นฐานสำหรับการแลกเปลี่ยนตามความยินยอมและสิทธิ์'}</p></div><div class="governance-grid">{founderPillars.map(([number,title,body,path])=><article><span>{number}</span><h3>{title}</h3><p>{body}</p><a href={`${p}${path}`}>{en?'Read the principle':'อ่านหลักการ'} <i aria-hidden="true">→</i></a></article>)}</div></div></section>

<section class="proof-band"><div class="container"><div class="proof-band-head"><div><div class="eyebrow">{en?'Evidence':'หลักฐาน'}</div><h2>{en?'Evidence from official sources':'หลักฐานจากประกาศและเอกสารทางการ'}</h2></div><a href={`${p}/evidence/`}>{en?'See all evidence & sources':'ดูหลักฐานและแหล่งข้อมูลทั้งหมด'} →</a></div><div class="proof-row">{proof.map(([title,meta,href])=><a class="proof-item" href={href} target="_blank" rel="noopener noreferrer"><strong>{title}</strong><span>{meta}</span><i aria-hidden="true">↗</i></a>)}</div></div></section>

<section class="section"><div class="container"><div class="section-head"><h2>{en?'How HealthTAG supports this vision':'HealthTAG ทำให้วิสัยทัศน์นี้เกิดขึ้นอย่างไร'}</h2><p>{en?'Hospitals can connect existing systems while continuing to operate and safeguard their source records.':'โรงพยาบาลเชื่อมระบบเดิมได้ โดยยังคงดูแลการทำงานและปกป้องเวชระเบียนในระบบต้นทาง'}</p></div><div class="product-grid">{capabilities.map(([title,body,path,cta])=><article class="card"><div class="kicker">{en?'HealthTAG platform':'แพลตฟอร์ม HealthTAG'}</div><h3>{title}</h3><p>{body}</p><div class="actions"><a class="btn secondary" href={`${p}${path}`}>{cta}</a></div></article>)}</div></div></section>

<section class="section"><div class="container"><div class="section-head"><h2>{en?'Siriraj and Khian Sa use different ingestion paths':'ศิริราชและเคียนซาใช้วิธีนำข้อมูลเข้าแตกต่างกัน'}</h2><p>{en?'Each hospital can connect its HIS in the way that fits its own systems.':'แต่ละโรงพยาบาลเลือกวิธีเชื่อม HIS ให้เหมาะกับระบบของตน'}</p></div><div class="case-spread"><article><div class="kicker">Siriraj 5G Smart Hospital</div><h3>{en?'Hospital IT script':'สคริปต์ของทีม IT โรงพยาบาล'}</h3><p>{en?'Siriraj IT uses its own script to send HIS data to the FHIR Server. HealthTAG says it participated in the Permission-based Blockchain for Personal Health Record subproject.':'ทีม IT ศิริราชใช้สคริปต์ของตนเองนำข้อมูลจาก HIS เข้า FHIR Server ส่วน HealthTAG ระบุว่าเข้าร่วมโครงการย่อย Permission-based Blockchain for Personal Health Record'}</p><a href={`${p}/deployments/`}>{en?'Read the Siriraj case':'อ่านกรณีศิริราช'} →</a></article><article><div class="kicker">Khian Sa Hospital</div><h3>HealthTAG FHIR Transformer</h3><p>{en?'HealthTAG FHIR Transformer maps selected HIS data to HL7 FHIR R4.':'HealthTAG FHIR Transformer แปลงข้อมูล HIS ที่เลือกเป็น HL7 FHIR R4'}</p><div class="resource-list">{resources.map(r=><span class="chip">{r}</span>)}</div></article></div></div></section>

<section class="section"><div class="container company-grid"><div><div class="eyebrow">{en?'Founded from clinical work':'เริ่มจากงานดูแลผู้ป่วย'}</div><h2>{en?'HealthTAG began with a problem seen in patient care':'HealthTAG เริ่มจากปัญหาที่พบในการดูแลผู้ป่วย'}</h2><p class="lead-copy">{en?'Health records may exist in several systems but still be difficult to use when a patient needs care. The founder framework asks whether each design makes care better for the patient.':'เวชระเบียนอาจอยู่ในหลายระบบ แต่ยังนำมาใช้ได้ยากเมื่อผู้ป่วยต้องรับการดูแล แนวทางของผู้ก่อตั้งจึงเริ่มจากคำถามว่า การออกแบบนั้นช่วยให้การดูแลผู้ป่วยดีขึ้นจริงหรือไม่'}</p></div><FounderCard locale={locale} /></div></section>

<section class="section final-cta"><div class="container"><div class="section-head"><h2>{en?'Talk to HealthTAG about trusted health data infrastructure':'คุยกับ HealthTAG เรื่องโครงสร้างพื้นฐานข้อมูลสุขภาพที่วางใจได้'}</h2><p>{en?'Contact us about hospital integration, public-sector or university work, deployment, or industry partnership.':'ติดต่อเราเรื่องการเชื่อมระบบโรงพยาบาล งานร่วมกับภาครัฐหรือมหาวิทยาลัย การติดตั้งใช้งาน หรือความร่วมมือกับภาคอุตสาหกรรม'}</p></div><div class="actions"><a class="btn primary" href={`${p}/contact/`}>{en?'Contact HealthTAG':'ติดต่อ HealthTAG'}</a><a class="btn secondary" href={`${p}/evidence/`}>{en?'View evidence & sources':'ดูหลักฐานและแหล่งข้อมูล'}</a></div></div></section>
</main></Base>

<style>
  .home-hero { padding: clamp(4rem, 7vw, 6.75rem) 0 clamp(2.25rem, 4vw, 3.5rem); overflow: hidden; border-bottom: 1px solid var(--line); background: linear-gradient(155deg, var(--paper) 0%, var(--paper) 56%, #e8f5f0 100%); }
  .home-hero .hero-grid { grid-template-columns: minmax(0, .95fr) minmax(32rem, 1.05fr); gap: clamp(2.5rem, 4.5vw, 4.5rem); }
  .home-hero .hero-copy { position: relative; z-index: 1; }
  .home-hero h1 { max-width: none; font-size: clamp(3.25rem, 4.7vw, 4.75rem); line-height: 1; letter-spacing: -.06em; text-wrap: balance; }
  .home-hero h1 span { display: block; white-space: nowrap; }
  .home-hero h1 span:last-child { max-width: 11ch; color: var(--teal); white-space: normal; }
  .home-hero .hero-copy > p { max-width: 62ch; font-size: clamp(1rem, 1.35vw, 1.16rem); }
  .hero-product { position: relative; z-index: 1; min-width: 0; margin: 0; border: 1px solid var(--line); background: var(--white); box-shadow: 0 28px 74px rgba(16, 47, 54, .14); }
  .hero-product::before { content: ''; position: absolute; inset: -1.25rem 1.25rem 1.25rem -1.25rem; z-index: -1; border: 1px solid #a9d9cf; background: var(--mint); }
  .hero-product-bar { min-height: 2.85rem; display: flex; align-items: center; gap: .42rem; padding: 0 1rem; border-bottom: 1px solid var(--line); color: var(--muted); font-size: .73rem; }
  .hero-product-bar > span { width: .48rem; height: .48rem; border-radius: 50%; background: var(--line); }
  .hero-product-bar > span:first-child { background: var(--teal); }
  .hero-product-bar > span:nth-child(2) { background: var(--amber); }
  .hero-product-bar strong { margin-left: auto; color: var(--ink); letter-spacing: .02em; }
  .hero-product-screen { aspect-ratio: 16 / 9; overflow: hidden; background: #f5f5fb; }
  .hero-product-screen :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 58%; }
  .hero-story { display: grid; grid-template-columns: 11rem minmax(0, 1fr) auto; gap: clamp(1rem, 2.5vw, 2rem); align-items: center; margin-top: clamp(2.5rem, 5vw, 4.5rem); padding-top: 1.4rem; border-top: 1px solid color-mix(in srgb, var(--teal) 32%, var(--line)); }
  .hero-story figure { min-width: 0; aspect-ratio: 3 / 2; margin: 0; overflow: hidden; border: 1px solid var(--line); background: var(--white); }
  .hero-story figure :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hero-story-copy > span { color: var(--teal); font: 600 .72rem/1.4 'IBM Plex Mono', ui-monospace, monospace; letter-spacing: .04em; text-transform: uppercase; }
  .hero-story h2 { margin: .35rem 0 .3rem; font-size: clamp(1.15rem, 2vw, 1.55rem); line-height: 1.25; letter-spacing: -.025em; text-wrap: balance; }
  .hero-story p { max-width: 82ch; margin: 0; color: var(--muted); font-size: .88rem; line-height: 1.55; }
  .hero-story > i { width: 2.75rem; height: 2.75rem; display: grid; place-items: center; border: 1px solid var(--ink); border-radius: 50%; font-style: normal; transition: color .2s ease, background-color .2s ease, transform .2s ease; }
  .hero-story:hover > i { color: var(--white); background: var(--teal); border-color: var(--teal); transform: translateX(.2rem); }
  .product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .product-grid .card { display: flex; min-width: 0; flex-direction: column; }
  .product-grid .actions { margin-top: auto; padding-top: 24px; }
  .governance-section { padding: clamp(72px, 8vw, 108px) 0; color: var(--paper); background: var(--ink); }
  .governance-head { display: grid; grid-template-columns: .95fr 1.05fr; gap: clamp(30px, 7vw, 90px); align-items: end; }
  .governance-head h2 { max-width: 760px; margin: 0; font-size: clamp(2.2rem, 4.6vw, 4.8rem); line-height: 1.05; letter-spacing: -.05em; text-wrap: balance; }
  .governance-head p { max-width: 680px; margin: 0; color: #bdd0d0; font-size: 1.04rem; }
  .governance-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: clamp(42px, 6vw, 72px); border-top: 1px solid rgba(221,243,235,.2); border-bottom: 1px solid rgba(221,243,235,.2); }
  .governance-grid article { min-width: 0; padding: 28px clamp(20px, 3vw, 38px) 32px 0; }
  .governance-grid article + article { padding-left: clamp(20px, 3vw, 38px); border-left: 1px solid rgba(221,243,235,.2); }
  .governance-grid span { font-family: 'IBM Plex Mono', ui-monospace, monospace; color: #8bd9d1; font-size: .72rem; }
  .governance-grid h3 { margin: 34px 0 12px; font-size: clamp(1.35rem, 2.2vw, 2rem); line-height: 1.2; }
  .governance-grid p { margin: 0; color: #bdd0d0; }
  .governance-grid a { display: inline-block; margin-top: 24px; color: #8bd9d1; font-weight: 600; }
  .governance-grid i { font-style: normal; }
  @media (max-width: 820px) {
    .home-hero .hero-grid { grid-template-columns: 1fr; }
    .home-hero h1 { max-width: 12ch; }
    .home-hero h1 span { white-space: normal; }
    .hero-product { margin: 1.25rem 1.25rem 0 0; }
    .product-grid, .governance-head, .governance-grid { grid-template-columns: 1fr; }
    .governance-head { align-items: start; }
    .governance-grid article, .governance-grid article + article { padding: 26px 0; border-left: 0; border-bottom: 1px solid rgba(221,243,235,.2); }
    .governance-grid article:last-child { border-bottom: 0; }
    .governance-grid h3 { margin-top: 18px; }
  }
  @media (max-width: 620px) {
    .home-hero { padding-top: 3.25rem; }
    .home-hero h1 { font-size: clamp(2.8rem, 13vw, 4rem); }
    .hero-product { margin-right: .7rem; }
    .hero-product::before { inset: -.7rem .7rem .7rem -.7rem; }
    .hero-product-screen { aspect-ratio: 4 / 3; }
    .hero-story { grid-template-columns: 1fr auto; }
    .hero-story figure { grid-column: 1 / -1; }
    .hero-story-copy { min-width: 0; }
    .hero-story p { font-size: .84rem; }
  }
</style>
