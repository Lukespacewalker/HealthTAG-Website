---
import Base from '../layouts/Base.astro';
import type { Locale } from '../data/site-content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const prefix = en ? '/en' : '';
const contactEmail = 'contact@healthtag.io';

const enquiryTypes = en ? [
  ['Provider integration', 'HealthTAG enquiry: Provider integration'],
  ['Government or university', 'HealthTAG enquiry: Government or university'],
  ['Business partnership', 'HealthTAG enquiry: Business partnership'],
  ['Investor Relations', 'HealthTAG enquiry: Investor Relations'],
  ['Press', 'HealthTAG enquiry: Press'],
  ['Other', 'HealthTAG enquiry: Other'],
] : [
  ['การเชื่อมระบบผู้ให้บริการสุขภาพ', 'ติดต่อ HealthTAG: การเชื่อมระบบผู้ให้บริการสุขภาพ'],
  ['ภาครัฐหรือมหาวิทยาลัย', 'ติดต่อ HealthTAG: ภาครัฐหรือมหาวิทยาลัย'],
  ['ความร่วมมือทางธุรกิจ', 'ติดต่อ HealthTAG: ความร่วมมือทางธุรกิจ'],
  ['นักลงทุนสัมพันธ์', 'ติดต่อ HealthTAG: นักลงทุนสัมพันธ์'],
  ['สื่อมวลชน', 'ติดต่อ HealthTAG: สื่อมวลชน'],
  ['เรื่องอื่น', 'ติดต่อ HealthTAG: เรื่องอื่น'],
];

const mailto = (subject: string) => `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}`;
---

<Base
  locale={locale}
  path="contact"
  title={en ? 'Contact HealthTAG | Hospital integration and partnerships' : 'ติดต่อ HealthTAG | การเชื่อมระบบโรงพยาบาลและความร่วมมือ'}
  description={en ? 'Email HealthTAG about hospital interoperability, technical integration, partnerships, investors, or media enquiries. Do not include health data or credentials.' : 'ส่งอีเมลถึง HealthTAG เรื่องการเชื่อมโยงข้อมูลโรงพยาบาล การเชื่อมต่อทางเทคนิค ความร่วมมือ นักลงทุน หรือสื่อ โดยไม่ส่งข้อมูลสุขภาพหรือข้อมูลลับ'}
>
  <main>
    <section class="page-hero contact-hero">
      <div class="container contact-hero-grid">
        <div>
          <div class="eyebrow">HealthTAG / {en ? 'Contact HealthTAG' : 'ติดต่อ HealthTAG'}</div>
          <h1>{en ? 'Email us without including sensitive data' : 'ส่งอีเมลหาเราโดยไม่แนบข้อมูลอ่อนไหว'}</h1>
        </div>
        <p>{en ? 'Choose the closest topic to open your email app with a prepared subject line. The team will reply to your email address within seven days.' : 'เลือกหัวข้อที่ใกล้เคียงเพื่อเปิดโปรแกรมอีเมลพร้อมหัวเรื่อง ทีมจะติดต่อกลับทางอีเมลภายใน 7 วัน'}</p>
      </div>
    </section>

    <section class="section contact-section">
      <div class="container contact-layout">
        <aside class="contact-aside" aria-labelledby="contact-safety-heading">
          <div class="safety-panel">
            <div class="safety-label">{en ? 'Before you write' : 'ก่อนเขียนอีเมล'}</div>
            <h2 id="contact-safety-heading">{en ? 'Do not send sensitive information.' : 'โปรดอย่าส่งข้อมูลอ่อนไหว'}</h2>
            <p>{en ? 'Do not include patient information, medical records, health data, passwords, API keys, credentials, or other sensitive information.' : 'ห้ามระบุข้อมูลผู้ป่วย เวชระเบียน ข้อมูลสุขภาพ รหัสผ่าน API key ข้อมูลรับรองการเข้าใช้ระบบ หรือข้อมูลอ่อนไหวประเภทอื่น'}</p>
          </div>
          <div class="support-panel">
            <span>{en ? 'Looking for reader support?' : 'ต้องการความช่วยเหลือเรื่องเครื่องอ่าน?'}</span>
            <a href={`${prefix}/support/`}>{en ? 'Reader setup and downloads' : 'ติดตั้งเครื่องอ่านและดาวน์โหลด'} <span aria-hidden="true">→</span></a>
          </div>
        </aside>

        <div class="email-panel">
          <div class="email-intro">
            <div>
              <div class="eyebrow">{en ? 'Corporate email' : 'อีเมลองค์กร'}</div>
              <h2>{contactEmail}</h2>
            </div>
            <p>{en ? 'Corporate enquiries are separate from hospital clinical systems and PHR access. Your email provider and HealthTAG mailbox may retain the message under their own policies.' : 'การติดต่อบริษัทแยกจากระบบข้อมูลทางคลินิกของโรงพยาบาลและการเข้าถึง PHR ผู้ให้บริการอีเมลและกล่องจดหมายของ HealthTAG อาจเก็บข้อความตามนโยบายของแต่ละระบบ'}</p>
          </div>

          <a class="btn primary email-primary" href={mailto(en ? 'HealthTAG enquiry' : 'ติดต่อ HealthTAG')}>{en ? 'Open your email app' : 'เปิดโปรแกรมอีเมล'}</a>

          <div class="topic-heading">
            <h3>{en ? 'Start with a topic' : 'เลือกหัวข้ออีเมล'}</h3>
            <p>{en ? 'The link prepares the subject only. Review the message before you send it.' : 'ลิงก์จะเตรียมเฉพาะหัวเรื่อง โปรดตรวจข้อความก่อนส่ง'}</p>
          </div>
          <ul class="topic-grid" role="list">
            {enquiryTypes.map(([label, subject]) => (
              <li><a href={mailto(subject)}><span>{label}</span><span aria-hidden="true">↗</span></a></li>
            ))}
          </ul>

          <p class="privacy-link">{en ? 'Read the' : 'อ่าน'} <a href={`${prefix}/privacy/`}>{en ? 'website privacy notice' : 'ประกาศความเป็นส่วนตัวของเว็บไซต์'}</a>{en ? ' before emailing.' : ' ก่อนส่งอีเมล'}</p>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .contact-hero { padding-bottom: 74px; }
  .contact-hero-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(320px, .7fr); gap: 72px; align-items: end; }
  .contact-hero h1 { max-width: 820px; }
  .contact-hero p { margin: 0 0 8px; }
  .contact-section { background: #eef1f3; }
  .contact-layout { display: grid; grid-template-columns: minmax(280px, .65fr) minmax(0, 1.35fr); gap: 28px; align-items: start; }
  .contact-aside { display: grid; gap: 18px; position: sticky; top: 104px; }
  .safety-panel, .support-panel, .email-panel { border: 1px solid var(--line); border-radius: var(--radius); }
  .safety-panel { padding: 28px; border-color: #dfc7a9; background: var(--amber-soft); }
  .safety-label { color: var(--amber-ink); font-size: .75rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .safety-panel h2 { margin: 12px 0; font-size: clamp(1.6rem, 3vw, 2.35rem); line-height: 1.18; letter-spacing: -.035em; }
  .safety-panel p { margin: 0; color: var(--muted); }
  .support-panel { padding: 24px 28px; background: var(--white); }
  .support-panel > span { display: block; color: var(--muted); font-size: .82rem; }
  .support-panel a { display: inline-block; margin-top: 9px; color: var(--teal); font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
  .email-panel { padding: clamp(26px, 4vw, 48px); background: var(--white); }
  .email-intro { display: grid; gap: 22px; }
  .email-intro h2 { margin: 9px 0 0; font-size: clamp(1.8rem, 3.8vw, 3.2rem); overflow-wrap: anywhere; }
  .email-intro p { max-width: 680px; margin: 0; color: var(--muted); }
  .email-primary { margin-top: 32px; }
  .topic-heading { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: end; margin-top: 48px; padding-top: 30px; border-top: 1px solid var(--line); }
  .topic-heading h3 { margin: 0; font-size: clamp(1.5rem, 3vw, 2.25rem); }
  .topic-heading p { margin: 0; color: var(--muted); font-size: .92rem; }
  .topic-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 22px 0 0; padding: 0; list-style: none; }
  .topic-grid a { display: flex; justify-content: space-between; gap: 18px; min-height: 58px; padding: 16px 18px; border: 1px solid var(--line); border-radius: 9px; color: var(--ink); background: #fbfcfb; font-weight: 600; }
  .topic-grid a:hover { border-color: var(--teal); background: var(--mint); }
  .topic-grid a span:last-child { color: var(--teal); }
  .privacy-link { margin: 28px 0 0; color: var(--muted); font-size: .9rem; }
  .privacy-link a { color: var(--teal); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 860px) {
    .contact-hero-grid, .contact-layout { grid-template-columns: 1fr; gap: 28px; }
    .contact-aside { position: static; }
  }
  @media (max-width: 560px) {
    .topic-heading, .topic-grid { grid-template-columns: 1fr; }
  }
</style>
