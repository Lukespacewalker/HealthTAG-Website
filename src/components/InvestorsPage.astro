---
import Base from '../layouts/Base.astro';
import FounderCard from './FounderCard.astro';
import { evidence } from '../data/evidence';
import type { Locale } from '../data/site-content';

interface Props { locale: Locale }

const { locale } = Astro.props;
const en = locale === 'en';
const prefix = en ? '/en' : '';

const localLinks = en
  ? [
      ['#position', 'Position'],
      ['#why-now', 'Why now'],
      ['#evidence', 'Evidence'],
      ['#business-model', 'Business model'],
      ['#team', 'Founder and team'],
      ['#contact-investors', 'Contact'],
    ]
  : [
      ['#position', 'จุดยืน'],
      ['#why-now', 'ทำไมตอนนี้'],
      ['#evidence', 'หลักฐาน'],
      ['#business-model', 'โมเดลธุรกิจ'],
      ['#team', 'ผู้ก่อตั้งและทีม'],
      ['#contact-investors', 'ติดต่อ'],
    ];

const investmentEvidenceIds = [
  'who-thailand-dhw-workshop-2026',
  'mahidol-moph-digital-health-mou-2026',
  'asean-digital-awards-2024',
  'apicta-2022',
  'etda-digital-service-sandbox',
  'orbix-healthtag',
];
const investmentEvidence = evidence.filter((item) => investmentEvidenceIds.includes(item.id));

const businessModel = en
  ? [
      ['Connectivity services', 'Ongoing service fees for institutions connected through a deployment or network project.'],
      ['Usage services', 'Fees tied to consent checks and permitted data exchange when that structure applies to the engagement.'],
      ['Infrastructure projects', 'Scoped system work with universities, public agencies, and private-sector partners.'],
    ]
  : [
      ['บริการเชื่อมต่อ', 'ค่าบริการต่อเนื่องสำหรับองค์กรที่เชื่อมผ่านการติดตั้งหรือโครงการเครือข่าย'],
      ['บริการตามการใช้งาน', 'ค่าบริการตามการตรวจความยินยอมและการแลกเปลี่ยนข้อมูลที่ได้รับอนุญาต เมื่อโครงสร้างนี้ใช้กับงานนั้น'],
      ['โครงการโครงสร้างพื้นฐาน', 'งานวางระบบตามขอบเขตร่วมกับมหาวิทยาลัย หน่วยงานภาครัฐ และพันธมิตรภาคเอกชน'],
    ];
---

<Base
  locale={locale}
  path="investors"
  title={en ? 'For investors | HealthTAG' : 'สำหรับนักลงทุน | HealthTAG'}
  description={en
    ? 'HealthTAG business model, deployments, published records, and contact information for investor enquiries.'
    : 'โมเดลธุรกิจ การติดตั้งใช้งาน ข้อมูลที่เผยแพร่ และช่องทางติดต่อสำหรับนักลงทุนที่สนใจ HealthTAG'}
>
  <main>
    <section class="page-hero investor-hero" aria-labelledby="investor-heading">
      <div class="container investor-hero-layout">
        <div>
          <div class="eyebrow">HealthTAG / {en ? 'For investors' : 'สำหรับนักลงทุน'}</div>
          <h1 id="investor-heading">{en ? 'Health data infrastructure for authorized exchange' : 'โครงสร้างพื้นฐานข้อมูลสุขภาพสำหรับการแลกเปลี่ยนตามสิทธิ์'}</h1>
          <p>{en
            ? 'HealthTAG connects existing hospital systems through HL7 FHIR R4 and separates identity, authorization, exchange, and audit responsibilities. Clinical records stay in hospital source systems.'
            : 'HealthTAG เชื่อมระบบเดิมของโรงพยาบาลด้วย HL7 FHIR R4 และแยกหน้าที่ด้านตัวตน การอนุญาต การแลกเปลี่ยน และการตรวจสอบให้ชัดเจน โดยเวชระเบียนยังอยู่ในระบบต้นทางของโรงพยาบาล'}</p>
          <div class="actions">
            <a class="btn primary" href={`${prefix}/evidence/`}>{en ? 'Review public evidence' : 'ตรวจสอบหลักฐานสาธารณะ'}</a>
            <a class="btn secondary" href={`${prefix}/contact/`}>{en ? 'Contact investor relations' : 'ติดต่อฝ่ายนักลงทุนสัมพันธ์'}</a>
          </div>
        </div>
        <aside class="principle-note">
          <span class="mono">TRUST BEFORE INTELLIGENCE</span>
          <p>{en
            ? 'Current HealthTAG systems do not use health data to train medical AI.'
            : 'ปัจจุบันระบบของ HealthTAG ไม่ได้นำข้อมูลสุขภาพไปใช้ฝึก AI ทางการแพทย์'}</p>
        </aside>
      </div>
    </section>

    <nav class="page-index" aria-label={en ? 'On this page' : 'สารบัญหน้านี้'}>
      <div class="container">
        <span class="mono">{en ? 'INVESTOR OVERVIEW' : 'ข้อมูลสำหรับนักลงทุน'}</span>
        <ul role="list">
          {localLinks.map(([href, label], index) => <li><a href={href}><span>0{index + 1}</span>{label}</a></li>)}
        </ul>
      </div>
    </nav>

    <section id="position" class="section position-section" aria-labelledby="position-heading">
      <div class="container position-layout">
        <div>
          <span class="mono">{en ? 'HEALTH DATA INFRASTRUCTURE' : 'โครงสร้างพื้นฐานข้อมูลสุขภาพ'}</span>
          <h2 id="position-heading">{en ? 'Authorized exchange while records remain with hospitals' : 'แลกเปลี่ยนข้อมูลตามสิทธิ์ โดยเวชระเบียนยังอยู่กับโรงพยาบาล'}</h2>
        </div>
        <div class="position-copy">
          <p>{en
            ? 'Patients own their health data and control consent and use. Hospitals store and steward clinical records. HealthTAG provides the infrastructure around an authorized exchange without replacing the core HIS or putting clinical records on blockchain.'
            : 'ผู้ป่วยเป็นเจ้าของข้อมูลสุขภาพและกำหนดความยินยอมกับการใช้ข้อมูล โรงพยาบาลจัดเก็บและดูแลเวชระเบียน ส่วน HealthTAG จัดเตรียมโครงสร้างพื้นฐานสำหรับการแลกเปลี่ยนตามสิทธิ์ โดยไม่แทนที่ HIS หลักและไม่นำเวชระเบียนไปเก็บบน blockchain'}</p>
          <dl>
            <div><dt>{en ? 'Interoperability' : 'การเชื่อมโยงข้อมูล'}</dt><dd>{en ? 'Selected HIS data enters a hospital-stewarded HL7 FHIR R4 system.' : 'ข้อมูลที่เลือกจาก HIS เข้าสู่ระบบ HL7 FHIR R4 ที่โรงพยาบาลดูแล'}</dd></div>
            <div><dt>{en ? 'Identity' : 'ตัวตน'}</dt><dd>{en ? 'The identity linkage service connects hospital-local patient identifiers through a common identity reference.' : 'บริการเชื่อมตัวตนผู้ป่วยเชื่อมรหัสผู้ป่วยของแต่ละโรงพยาบาลผ่านตัวระบุกลาง'}</dd></div>
            <div><dt>{en ? 'Trust and audit' : 'ความไว้วางใจและการตรวจสอบ'}</dt><dd>{en ? 'Authorization is checked before a permitted response. Consent and access events remain available for later review.' : 'ระบบตรวจการอนุญาตก่อนส่งคำตอบตามสิทธิ์ และเก็บเหตุการณ์ความยินยอมกับการเข้าถึงไว้ตรวจสอบภายหลัง'}</dd></div>
          </dl>
          <a class="text-link" href={`${prefix}/platform/`}>{en ? 'HealthTAG platform' : 'แพลตฟอร์ม HealthTAG'} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section id="why-now" class="section why-now-section" aria-labelledby="why-now-heading">
      <div class="container why-now-layout">
        <header>
          <span class="mono">{en ? 'WHY NOW' : 'ทำไมตอนนี้'}</span>
          <h2 id="why-now-heading">{en ? 'Thailand and ASEAN are moving toward portable, interoperable health information' : 'ไทยและอาเซียนกำลังเดินหน้าสู่ข้อมูลสุขภาพที่พกพาและเชื่อมต่อกันได้'}</h2>
        </header>
        <div class="why-now-records">
          <article>
            <time datetime="2026-03-23">{en ? 'March 2026' : 'มีนาคม 2569'}</time>
            <h3>{en ? 'WHO launched a three-year digital health wallet initiative for ASEAN' : 'WHO เปิดโครงการ Digital Health Wallet ระยะ 3 ปีสำหรับอาเซียน'}</h3>
            <p>{en
              ? 'WHO, the Alliance for Health Policy and Systems Research, and Temasek Foundation launched an initiative to help ASEAN Member States move from paper records to secure, interoperable digital health wallets.'
              : 'WHO, Alliance for Health Policy and Systems Research และ Temasek Foundation เปิดโครงการเพื่อช่วยประเทศสมาชิกอาเซียนเปลี่ยนจากเวชระเบียนกระดาษไปสู่ Digital Health Wallet ที่ปลอดภัยและเชื่อมต่อกันได้'}</p>
            <a href="https://www.who.int/news/item/23-03-2026-who-and-partners-launch-new-initiative-to-expand-use-of-digital-health-wallets" target="_blank" rel="noopener noreferrer">WHO <span aria-hidden="true">↗</span></a>
          </article>
          <article>
            <time datetime="2026-06-05">{en ? 'June 2026' : 'มิถุนายน 2569'}</time>
            <h3>{en ? 'Mahidol University and the Ministry of Public Health signed a health-data MOU' : 'มหิดลและกระทรวงสาธารณสุขลงนาม MOU ด้านข้อมูลสุขภาพ'}</h3>
            <p>{en
              ? 'The MOU covers connections to the Ministry\'s Digital Health Platform for research, innovation, and data-informed public-health policy.'
              : 'MOU ครอบคลุมการเชื่อมโยงข้อมูลบน Digital Health Platform ของกระทรวง เพื่อสนับสนุนงานวิจัย นวัตกรรม และนโยบายสาธารณสุขที่ใช้ข้อมูลประกอบ'}</p>
            <a href="https://www.thecoverage.info/news/content/11474" target="_blank" rel="noopener noreferrer">The Coverage <span aria-hidden="true">↗</span></a>
          </article>
          <aside>
            <strong>{en ? 'The connection to HealthTAG' : 'ความเกี่ยวข้องกับ HealthTAG'}</strong>
            <p>{en
              ? 'Neither source identifies HealthTAG as part of the WHO initiative or as a signatory to the MOU. The sources describe work on portable health information, identity, permission checks, and standards-based exchange. HealthTAG works on these capabilities within the deployments and collaborations documented on this site.'
              : 'ทั้งสองแหล่งไม่ได้ระบุว่า HealthTAG เป็นส่วนหนึ่งของโครงการ WHO หรือเป็นคู่ลงนาม MOU แหล่งข้อมูลเหล่านี้กล่าวถึงงานด้านข้อมูลสุขภาพที่พกพาได้ การจัดการตัวตน การตรวจสิทธิ์ และการแลกเปลี่ยนตามมาตรฐาน ซึ่งเป็นขอบเขตงานของ HealthTAG ในการติดตั้งและความร่วมมือที่มีหลักฐานบนเว็บไซต์นี้'}</p>
          </aside>
        </div>
      </div>
    </section>

    <section id="evidence" class="section evidence-section" aria-labelledby="investor-evidence-heading">
      <div class="container">
        <div class="section-head">
          <h2 id="investor-evidence-heading">{en ? 'Published records across programmes, awards, and collaborations' : 'หลักฐานจากโครงการ รางวัล และความร่วมมือ'}</h2>
          <p>{en
            ? 'Programmes, awards, sandbox participation, announced collaborations, and hospital deployments have different scopes.'
            : 'โครงการ รางวัล การเข้าร่วม sandbox ความร่วมมือที่ประกาศแล้ว และการติดตั้งในโรงพยาบาลมีขอบเขตต่างกัน'}</p>
        </div>
        <article class="deployment-record">
          <div><span class="record-type">{en ? 'Deployment' : 'การใช้งานจริง'}</span><h3>{en ? 'Three confirmed deployment models' : 'สามรูปแบบการติดตั้งที่ยืนยันแล้ว'}</h3></div>
          <p>{en
            ? 'Siriraj uses a hospital-developed HIS-to-FHIR script. Khian Sa uses HealthTAG FHIR Transformer. MU Health Data Network connects five live institutions and 60,000 active users.'
            : 'ศิริราชใช้ HIS-to-FHIR script ที่ทีมโรงพยาบาลพัฒนาเอง เคียนซาใช้ HealthTAG FHIR Transformer ส่วน MU Health Data Network เชื่อม 5 หน่วยงานที่เปิดใช้งานจริงและมีผู้ใช้งานจริง 60,000 คน'}</p>
          <a href={`${prefix}/deployments/`}>{en ? 'Compare the deployment models' : 'เปรียบเทียบรูปแบบการติดตั้ง'} <span aria-hidden="true">→</span></a>
        </article>
        <div class="evidence-grid">
          {investmentEvidence.map((item) => (
            <article>
              <div class="evidence-meta"><span class="record-type">{item.tag[locale]}</span><span>{item.sourceOrganization[locale]}</span></div>
              <h3>{item.title}</h3>
              <p>{item.externallyConfirmed[locale]}</p>
              <div class="record-links">
                <a href={`${prefix}/evidence/#${item.id}`}>{en ? 'Evidence record' : 'หน้าหลักฐาน'} <span aria-hidden="true">→</span></a>
                <a href={item.href[locale]} target="_blank" rel="noopener noreferrer">{en ? 'Open the source' : 'เปิดแหล่งข้อมูล'}: {item.sourceOrganization[locale]} <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="business-model" class="section business-section" aria-labelledby="business-heading">
      <div class="container business-layout">
        <div class="business-intro">
          <span class="mono">{en ? 'BUSINESS MODEL' : 'โมเดลธุรกิจ'}</span>
          <h2 id="business-heading">{en ? 'How HealthTAG earns revenue' : 'HealthTAG มีรายได้จากอะไร'}</h2>
          <p>{en
            ? 'HealthTAG\'s business model covers connectivity services, usage services, and scoped infrastructure projects. Pricing, forecasts, valuation, contract terms, and detailed financial information are shared only through investor relations.'
            : 'โมเดลธุรกิจของ HealthTAG ครอบคลุมบริการเชื่อมต่อ บริการตามการใช้งาน และโครงการโครงสร้างพื้นฐานตามขอบเขต ส่วนข้อมูลราคา ประมาณการ มูลค่า เงื่อนไขสัญญา และข้อมูลทางการเงินโดยละเอียดจะให้ผ่านฝ่ายนักลงทุนสัมพันธ์เท่านั้น'}</p>
        </div>
        <ol class="business-list">
          {businessModel.map(([title, body], index) => (
            <li><span>0{index + 1}</span><div><h3>{title}</h3><p>{body}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

    <section id="team" class="section team-section" aria-labelledby="team-heading">
      <div class="container team-layout">
        <div class="team-copy">
          <span class="mono">{en ? 'FOUNDER AND TEAM' : 'ผู้ก่อตั้งและทีม'}</span>
          <h2 id="team-heading">{en ? 'Founded from a problem seen in patient care' : 'ก่อตั้งจากปัญหาที่พบในการดูแลผู้ป่วย'}</h2>
          <p>{en
            ? 'Dechowat Promda, M.D. founded HealthTAG after seeing one patient\'s records scattered across systems that did not connect. He remains in clinical practice while leading the company.'
            : 'นพ.เดโชวัต พรมดา ก่อตั้ง HealthTAG หลังพบว่าเวชระเบียนของผู้ป่วยหนึ่งคนกระจายอยู่ในระบบที่ไม่เชื่อมกัน ปัจจุบันยังปฏิบัติงานทางคลินิกควบคู่กับการนำบริษัท'}</p>
          <blockquote>{en
            ? '"Don\'t trust. Just verify." A principle the founder presented at TEDx in 2022 and now applies to the design of HealthTAG Connect.'
            : '"Don\'t trust. Just verify." หลักการที่ผู้ก่อตั้งนำเสนอบนเวที TEDx เมื่อปี 2565 และนำมาใช้กับการออกแบบ HealthTAG Connect ในปัจจุบัน'}</blockquote>
          <a class="text-link" href={`${prefix}/company/#founder`}>{en ? 'Company, founder and current team' : 'บริษัท ผู้ก่อตั้ง และทีมปัจจุบัน'} <span aria-hidden="true">→</span></a>
        </div>
        <FounderCard locale={locale} />
      </div>
    </section>

    <section id="contact-investors" class="investor-cta" aria-labelledby="investor-contact-heading">
      <div class="container contact-layout">
        <div>
          <span class="mono">INVESTOR RELATIONS</span>
          <h2 id="investor-contact-heading">{en ? 'Request investor information' : 'ขอข้อมูลสำหรับนักลงทุน'}</h2>
        </div>
        <div>
          <p>{en
            ? 'Use the Investor Relations topic when contacting HealthTAG. The team will reply to the supplied email address within seven days. Do not send patient, medical, credential, or other sensitive data.'
            : 'เลือกหัวข้อ Investor Relations เมื่อติดต่อ HealthTAG ทีมจะตอบกลับทางอีเมลที่ระบุภายใน 7 วัน และไม่ควรส่งข้อมูลผู้ป่วย ข้อมูลทางการแพทย์ รหัสผ่าน หรือข้อมูลอ่อนไหวอื่น'}</p>
          <a class="btn primary" href={`${prefix}/contact/`}>{en ? 'Contact investor relations' : 'ติดต่อฝ่ายนักลงทุนสัมพันธ์'}</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: .7rem; letter-spacing: .08em; color: var(--teal); }
  .investor-hero { padding-bottom: 78px; }
  .investor-hero-layout { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(20rem, .6fr); gap: clamp(42px, 8vw, 110px); align-items: end; }
  .investor-hero h1 { max-width: 16ch; }
  .principle-note { padding: 30px; border-top: 3px solid var(--amber); background: var(--amber-soft); }
  .principle-note .mono { color: var(--amber-ink); }
  .principle-note p { margin: 20px 0 0; color: var(--ink); }

  .page-index { position: sticky; top: 76px; z-index: 10; border-block: 1px solid var(--line); background: rgba(255,255,255,.96); backdrop-filter: blur(12px); }
  .page-index .container { display: grid; grid-template-columns: minmax(150px, .3fr) 1fr; gap: 24px; align-items: center; min-height: 66px; }
  .page-index > .container > .mono { color: var(--muted); }
  .page-index ul { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 5px; margin: 0; padding: 0; list-style: none; }
  .page-index a { display: flex; gap: 8px; align-items: baseline; min-height: 44px; padding: 8px; border-radius: 7px; font-size: .85rem; font-weight: 600; line-height: 1.35; }
  .page-index a:hover { background: var(--mint); }
  .page-index a span { color: var(--teal); font: 500 .65rem/1 'IBM Plex Mono', ui-monospace, monospace; }

  .position-section { background: var(--white); }
  .position-layout, .business-layout { display: grid; grid-template-columns: minmax(0, .72fr) minmax(0, 1.28fr); gap: clamp(44px, 8vw, 110px); align-items: start; }
  .position-layout h2, .business-intro h2, .team-copy h2 { margin: 15px 0 0; font-size: clamp(2.2rem, 4vw, 4rem); }
  .position-copy > p { margin: 0; color: var(--muted); font-size: 1.08rem; }
  .position-copy dl { margin: 36px 0 24px; }
  .position-copy dl div { display: grid; grid-template-columns: minmax(130px, .32fr) minmax(0, 1fr); gap: 22px; padding: 18px 0; border-top: 1px solid var(--line); }
  .position-copy dl div:last-child { border-bottom: 1px solid var(--line); }
  .position-copy dt { font-weight: 700; }
  .position-copy dd { margin: 0; color: var(--muted); }
  .text-link { display: inline-block; color: var(--teal); font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }

  .why-now-section { color: var(--paper); background: var(--ink); }
  .why-now-layout { display: grid; grid-template-columns: minmax(18rem, .68fr) minmax(0, 1.32fr); gap: clamp(42px, 8vw, 110px); align-items: start; }
  .why-now-layout > header { position: sticky; top: 176px; }
  .why-now-layout > header .mono { color: #8bb6d9; }
  .why-now-layout > header h2 { margin: 16px 0 0; color: var(--paper); font-size: clamp(2.2rem, 4vw, 4rem); line-height: 1.08; letter-spacing: -.045em; }
