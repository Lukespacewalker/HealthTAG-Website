---
import Home from './Home.astro';

interface Props { locale: 'th' | 'en' }
const { locale } = Astro.props;
---

<Home locale={locale} />

<script>
  import { mountHealthTagFlagshipHero } from '../lib/home-network-flagship';

  document.querySelectorAll<HTMLElement>('[data-network-hero]').forEach((hero) => {
    if (hero.dataset.flagshipHeroMounted === 'true') return;
    hero.dataset.flagshipHeroMounted = 'true';

    const host = hero.querySelector<HTMLElement>('[data-three-hero]');
    const controls = Array.from(hero.querySelectorAll<HTMLButtonElement>('[data-hero-phase]'));
    const status = hero.querySelector<HTMLElement>('[data-hero-status]');
    const statusTitle = status?.querySelector<HTMLElement>('strong');
    const statusBody = status?.querySelector<HTMLElement>('span');
    const motionToggle = hero.querySelector<HTMLButtonElement>('[data-hero-motion-toggle]');
    const motionIcon = motionToggle?.querySelector<HTMLElement>('[data-motion-icon]');
    const motionLabel = motionToggle?.querySelector<HTMLElement>('[data-motion-label]');
    if (!host || !controls.length || !statusTitle || !statusBody) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let scene: ReturnType<typeof mountHealthTagFlagshipHero> | null = null;
    let visible = false;
    let paused = false;
    let userControlled = false;
    let timer: number | undefined;
    let disposed = false;

    const stopTimer = () => {
      if (timer !== undefined) window.clearTimeout(timer);
      timer = undefined;
    };

    const setPhaseUi = (phase: number) => {
      const next = Math.min(controls.length - 1, Math.max(0, phase));
      const active = controls[next];
      hero.dataset.phase = String(next);
      controls.forEach((control, index) => {
        const selected = index === next;
        control.classList.toggle('active', selected);
        control.setAttribute('aria-pressed', String(selected));
      });
      statusTitle.textContent = `${String(next + 1).padStart(2, '0')} · ${active.dataset.title ?? ''}`;
      statusBody.textContent = active.dataset.body ?? '';
      scene?.setPhase(next);
    };

    const scheduleNextPhase = () => {
      stopTimer();
      if (paused || userControlled || !visible || reducedMotion.matches) return;
      const current = Number(hero.dataset.phase ?? 0);
      if (current >= controls.length - 1) return;
      timer = window.setTimeout(() => {
        setPhaseUi(current + 1);
        scheduleNextPhase();
      }, 3600);
    };

    const syncMotionButton = () => {
      if (!motionToggle || !motionIcon || !motionLabel) return;
      const label = paused ? motionToggle.dataset.playLabel ?? '' : motionToggle.dataset.pauseLabel ?? '';
      motionIcon.textContent = paused ? '▶' : 'Ⅱ';
      motionLabel.textContent = label;
      motionToggle.setAttribute('aria-label', label);
    };

    const takeControl = () => {
      userControlled = true;
      stopTimer();
    };

    const onControlClick = (event: Event) => {
      const control = event.currentTarget as HTMLButtonElement;
      takeControl();
      setPhaseUi(Number(control.dataset.heroPhase ?? 0));
    };

    const onControlFocus = () => takeControl();

    const onControlKeydown = (event: KeyboardEvent) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      takeControl();
      const current = Number(hero.dataset.phase ?? 0);
      const next = event.key === 'ArrowLeft'
        ? current - 1
        : event.key === 'ArrowRight'
          ? current + 1
          : event.key === 'Home'
            ? 0
            : controls.length - 1;
      const bounded = Math.min(controls.length - 1, Math.max(0, next));
      controls[bounded].focus();
      setPhaseUi(bounded);
    };

    controls.forEach((control) => {
      control.addEventListener('click', onControlClick);
      control.addEventListener('focus', onControlFocus);
      control.addEventListener('keydown', onControlKeydown);
    });

    const onMotionToggle = (event: Event) => {
      event.preventDefault();
      paused = !paused;
      syncMotionButton();
      if (paused) {
        stopTimer();
        scene?.setActive(false);
      } else {
        userControlled = false;
        if (Number(hero.dataset.phase ?? 0) >= controls.length - 1) setPhaseUi(0);
        scene?.setActive(visible && !reducedMotion.matches);
        scheduleNextPhase();
      }
    };
    motionToggle?.addEventListener('click', onMotionToggle);

    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      scene?.setActive(visible && !paused && !reducedMotion.matches);
      if (visible) scheduleNextPhase(); else stopTimer();
    }, { threshold: 0.25 });
    observer.observe(hero);

    const onReducedMotionChange = () => {
      if (reducedMotion.matches) {
        stopTimer();
        setPhaseUi(controls.length - 1);
        scene?.setActive(false);
      } else if (!paused) {
        scene?.setActive(visible);
        scheduleNextPhase();
      }
    };
    reducedMotion.addEventListener('change', onReducedMotionChange);

    try {
      scene = mountHealthTagFlagshipHero(host);
      hero.classList.add('flagship-network-hero');
      hero.classList.remove('flagship-network-hero-failed');
    } catch (error) {
      console.warn('HealthTAG flagship hero could not start; keeping the static fallback.', error);
      host.replaceChildren();
      host.classList.add('hero-network-fallback');
      hero.classList.add('flagship-network-hero-failed');
      paused = true;
      syncMotionButton();
    }

    const phase = reducedMotion.matches ? controls.length - 1 : Number(hero.dataset.phase ?? 0);
    setPhaseUi(phase);
    if (scene) {
      scene.setActive(visible && !reducedMotion.matches);
      if (reducedMotion.matches) setPhaseUi(controls.length - 1);
      else scheduleNextPhase();
    }

    const dispose = () => {
      if (disposed) return;
      disposed = true;
      stopTimer();
      observer.disconnect();
      reducedMotion.removeEventListener('change', onReducedMotionChange);
      controls.forEach((control) => {
        control.removeEventListener('click', onControlClick);
        control.removeEventListener('focus', onControlFocus);
        control.removeEventListener('keydown', onControlKeydown);
      });
      motionToggle?.removeEventListener('click', onMotionToggle);
      scene?.dispose();
      scene = null;
      delete hero.dataset.flagshipHeroMounted;
    };

    window.addEventListener('pagehide', dispose, { once: true });
    document.addEventListener('astro:before-swap', dispose, { once: true });
  });
</script>

<style>
  :global(.home-hero.flagship-network-hero .hero-network) {
    background:
      radial-gradient(ellipse at 76% 45%, rgba(31, 139, 128, .3), transparent 34%),
      radial-gradient(ellipse at 82% 70%, rgba(7, 29, 34, .12), rgba(7, 29, 34, .7) 70%),
      #102f36;
  }
  :global(.home-hero.flagship-network-hero .hero-network::after) {
    background:
      radial-gradient(ellipse at 73% 48%, rgba(112, 211, 198, .055), transparent 30%),
      linear-gradient(90deg, rgba(16, 47, 54, 1) 0%, rgba(16, 47, 54, .985) 34%, rgba(16, 47, 54, .84) 46%, rgba(16, 47, 54, .18) 66%, rgba(16, 47, 54, .32) 100%);
  }
  :global(.home-hero .hero-network-canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
  :global(.hero-network-flagship-canvas) {
    filter: saturate(.9) contrast(1.035);
  }
  :global(.home-hero.flagship-network-hero-failed .hero-network) {
    background:
      radial-gradient(circle at 76% 42%, rgba(112, 211, 198, .2), transparent 24%),
      linear-gradient(120deg, #102f36, #0b292f 72%, #071d22);
  }

  @media (max-width: 620px) {
    :global(.home-hero.flagship-network-hero .hero-network::after) {
      background:
        linear-gradient(180deg, rgba(16, 47, 54, .96) 0%, rgba(16, 47, 54, .72) 48%, rgba(16, 47, 54, .94) 78%, #102f36 100%);
    }
    :global(.hero-network-flagship-canvas) {
      filter: saturate(.86) contrast(1.025);
    }
  }
</style>
