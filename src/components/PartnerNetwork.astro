---
import { Image } from 'astro:assets';
import { networkGroups } from '../data/partners';
import type { Locale } from '../data/site-content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const prefix = en ? '/en' : '';
---

<section class="ecosystem-principle" data-founder-copy aria-labelledby="ecosystem-principle-heading">
  <div class="container principle-inner">
    <div>
      <span>{en ? 'FOUNDER PRINCIPLE' : 'หลักการของผู้ก่อตั้ง'}</span>
      <h2 id="ecosystem-principle-heading">{en ? 'Ecosystem, not ego' : 'ระบบนิเวศสำคัญกว่าการยึดตัวเองเป็นศูนย์กลาง'}</h2>
    </div>
    <p>{en ? 'Hospitals, universities, public agencies, and technology organizations have different responsibilities. They connect through open standards with defined roles. A relationship with HealthTAG counts as a deployment only when that status is stated.' : 'โรงพยาบาล มหาวิทยาลัย หน่วยงานภาครัฐ และองค์กรเทคโนโลยีรับผิดชอบงานคนละส่วน โดยเชื่อมต่อกันผ่านมาตรฐานเปิดและกำหนดบทบาทให้ชัดเจน ความสัมพันธ์กับ HealthTAG จะนับเป็นการติดตั้งใช้งานเมื่อมีการระบุสถานะนั้นเท่านั้น'}</p>
  </div>
</section>

<div class="network-groups">
  {networkGroups.map((group, index) => (
    <section class:list={['network-group', { 'network-group-tinted': index % 2 === 1 }]} aria-labelledby={`network-${group.id}`} data-network-group={group.id}>
      <div class="container">
        <div class="group-heading">
          <p class="group-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
          <div>
            <h2 id={`network-${group.id}`}>{group.title[locale]}</h2>
            <p>{group.introduction[locale]}</p>
          </div>
        </div>
        <ul class="organization-grid" role="list">
          {group.organizations.map((organization) => (
            <li class="organization-card" data-organization={organization.id}>
              <div class:list={['organization-mark', { 'text-mark': !organization.logo }]}>
                {organization.logo
                  ? <Image src={organization.logo} alt={organization.name[locale]} width={organization.logo.width} height={organization.logo.height} loading="lazy" decoding="async" format="webp" quality={100} />
                  : <strong aria-hidden="true">{organization.mark?.[locale] ?? organization.name[locale]}</strong>}
              </div>
              <div class="organization-copy">
                <span class="relationship-badge">{organization.badge[locale]}</span>
                <h3>{organization.name[locale]}</h3>
                <p>{organization.relationship[locale]}</p>
                {organization.detailPage && <a href={`${prefix}/${organization.detailPage}/`} aria-label={`${en ? 'View evidence for' : 'ดูหลักฐานของ'} ${organization.name[locale]}`}>{en ? 'View evidence' : 'ดูหลักฐาน'} <span aria-hidden="true">→</span></a>}
                {organization.detailPath && <a href={`${prefix}${organization.detailPath}`} aria-label={`${en ? 'View published record for' : 'ดูข้อมูลที่เผยแพร่ของ'} ${organization.name[locale]}`}>{en ? 'View published record' : 'ดูข้อมูลที่เผยแพร่'} <span aria-hidden="true">→</span></a>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</div>

<style>
  .ecosystem-principle { padding: clamp(42px, 7vw, 72px) 0; border-top: 1px solid var(--line); background: var(--mint); }
  .principle-inner { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(32px, 7vw, 84px); align-items: start; }
  .principle-inner span, .group-index { color: var(--teal); font: 600 .72rem/1.2 'IBM Plex Mono', ui-monospace, monospace; letter-spacing: .08em; }
  .principle-inner h2 { max-width: 15ch; margin: 12px 0 0; font-size: clamp(2rem, 4vw, 3.6rem); line-height: 1.16; letter-spacing: -.04em; }
  .principle-inner p { margin: 0; color: var(--ink); font-size: clamp(1rem, 1.4vw, 1.15rem); }
  .network-group { padding: clamp(52px, 7vw, 82px) 0; border-top: 1px solid var(--line); }
  .network-group-tinted { background: #eef3f1; }
  .group-heading { display: grid; grid-template-columns: minmax(52px, .18fr) minmax(0, 1.82fr); gap: 22px; margin-bottom: 34px; align-items: start; }
  .group-index { margin: 8px 0 0; }
  .group-heading h2 { max-width: 22ch; margin: 0; font-size: clamp(1.9rem, 3.4vw, 3rem); line-height: 1.18; letter-spacing: -.035em; }
  .group-heading div > p { max-width: 70ch; margin: 12px 0 0; color: var(--muted); }
  .organization-grid { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; padding: 0; margin: 0; }
  .organization-card { min-width: 0; display: grid; grid-template-rows: 132px 1fr; border-top: 2px solid var(--ink); background: rgba(255, 255, 255, .72); }
  .organization-mark { display: flex; align-items: center; justify-content: center; padding: 20px; border-bottom: 1px solid var(--line); }
  .organization-mark img { display: block; max-width: 100%; width: auto; max-height: 92px; height: auto; object-fit: contain; }
  .organization-mark.text-mark { padding-inline: 24px; color: var(--teal); background: color-mix(in srgb, var(--mint) 65%, var(--white)); text-align: center; }
  .organization-mark.text-mark strong { max-width: 18ch; font-size: clamp(1rem, 1.8vw, 1.35rem); line-height: 1.2; letter-spacing: -.025em; overflow-wrap: anywhere; }
  .organization-copy { display: flex; flex-direction: column; align-items: flex-start; padding: 18px 18px 22px; }
  .relationship-badge { display: inline-flex; min-height: 29px; align-items: center; width: fit-content; border: 1px solid #8fbab3; border-radius: 999px; padding: 4px 9px; color: var(--ink); background: #f6fbf9; font-size: .69rem; font-weight: 600; letter-spacing: .055em; text-transform: uppercase; }
  .organization-copy h3 { margin: 13px 0 0; font-size: 1rem; line-height: 1.45; overflow-wrap: anywhere; }
  .organization-copy p { margin: 8px 0 0; color: var(--muted); font-size: .88rem; line-height: 1.55; }
  .organization-copy a { margin-top: auto; padding-top: 14px; color: var(--teal); font-size: .88rem; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 960px) { .organization-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .principle-inner { grid-template-columns: 1fr; gap: 18px; }
    .group-heading { grid-template-columns: 1fr; gap: 10px; }
    .group-index { margin: 0; }
    .organization-grid { grid-template-columns: 1fr; gap: 12px; }
    .organization-card { grid-template-rows: 132px 1fr; }
    .organization-mark { padding: 15px; }
    .organization-copy { padding: 16px 14px 20px; }
  }
</style>
