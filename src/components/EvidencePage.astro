---
import Base from '../layouts/Base.astro';
import { evidence } from '../data/evidence';

interface Props { locale: 'th' | 'en' }
const { locale } = Astro.props;
const en = locale === 'en';
---

<Base
  locale={locale}
  path="evidence"
  title={en ? 'Evidence and sources | HealthTAG' : 'หลักฐานและแหล่งข้อมูล | HealthTAG'}
  description={en ? 'Official records from Siriraj, ETDA, APICTA, NIA, ODESS, depa, and KASIKORNBANK related to HealthTAG.' : 'ข้อมูลที่เผยแพร่โดยศิริราช ETDA APICTA NIA ODESS depa และธนาคารกสิกรไทย ซึ่งเกี่ยวข้องกับ HealthTAG'}
>
  <main>
    <section class="page-hero evidence-hero">
      <div class="container evidence-hero-grid">
        <div>
          <div class="eyebrow">HealthTAG / {en ? 'Evidence & sources' : 'หลักฐานและแหล่งข้อมูล'}</div>
          <h1>{en ? 'Records from external organizations' : 'ข้อมูลจากหน่วยงานภายนอก'}</h1>
        </div>
        <p>{en ? 'Siriraj, ETDA, APICTA, NIA, ODESS, depa, and KASIKORNBANK have published records related to HealthTAG. Hospital implementation details come from HealthTAG.' : 'ศิริราช ETDA APICTA NIA ODESS depa และธนาคารกสิกรไทยเผยแพร่ข้อมูลที่เกี่ยวข้องกับ HealthTAG ส่วนรายละเอียดการติดตั้งโรงพยาบาลมาจาก HealthTAG'}</p>
      </div>
    </section>

    <section class="section evidence-section">
      <div class="container evidence-list">
        {evidence.map((item, index) => (
          <article class="evidence-entry" id={item.id}>
            <header class="evidence-index">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <time datetime={item.eventDate}>{item.displayDate[locale]}</time>
              <strong class="evidence-tag">{item.tag[locale]}</strong>
            </header>
            <div class="evidence-body">
              <h2>{item.title}</h2>
              <dl class="source-meta">
                <div><dt>{en ? 'Source organization' : 'หน่วยงานต้นทาง'}</dt><dd>{item.sourceOrganization[locale]}</dd></div>
                <div><dt>{en ? 'Source publication' : 'วันที่เผยแพร่ของแหล่งข้อมูล'}</dt><dd>{item.sourcePublicationDate[locale]}</dd></div>
              </dl>
              <section class="claim-block external-claim">
                <span>{en ? 'What the source states' : 'ข้อมูลจากหน่วยงานที่เกี่ยวข้อง'}</span>
                <p>{item.externallyConfirmed[locale]}</p>
              </section>
              <section class="claim-block context-claim">
                <span>{en ? 'Information from HealthTAG' : 'ข้อมูลจาก HealthTAG'}</span>
                <p>{item.healthTagContext[locale]}</p>
              </section>
              <a class="source-link" href={item.href[locale]} target="_blank" rel="noopener noreferrer" aria-label={`${en ? 'Open the official reference for' : 'เปิดข้อมูลจากหน่วยงานที่เกี่ยวข้องของ'} ${item.title} ${en ? 'in a new tab' : 'ในแท็บใหม่'}`}>{en ? 'Open official reference' : 'ดูข้อมูลจากหน่วยงานที่เกี่ยวข้อง'} <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

  </main>
</Base>

<style>
  .evidence-hero-grid { display: grid; grid-template-columns: 1.15fr .65fr; gap: 68px; align-items: end; }
  .evidence-hero p { margin: 0 0 8px; }
  .evidence-section { background: #eef3f1; }
  .evidence-list { display: grid; gap: 18px; }
  .evidence-entry { display: grid; grid-template-columns: minmax(170px, .35fr) minmax(0, 1.65fr); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: var(--white); scroll-margin-top: 92px; }
  .evidence-index { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 30px; border-right: 1px solid var(--line); background: var(--paper); }
  .evidence-index > span { font-family: 'IBM Plex Mono', ui-monospace, monospace; color: var(--teal); font-size: 2rem; line-height: 1; }
  .evidence-index time { color: var(--muted); font-size: .86rem; }
  .evidence-tag { display: inline-flex; min-height: 30px; align-items: center; margin-top: auto; border: 1px solid #8fbab3; border-radius: 999px; padding: 4px 9px; color: var(--ink); background: #f6fbf9; font-size: .68rem; letter-spacing: .06em; text-transform: uppercase; }
  .evidence-body { padding: clamp(26px, 4vw, 46px); }
  .evidence-body h2 { margin: 0 0 24px; font-size: clamp(1.8rem, 3.5vw, 3rem); line-height: 1.1; letter-spacing: -.04em; }
  .source-meta { display: grid; grid-template-columns: 1.1fr .9fr; gap: 18px; margin: 0 0 28px; }
  .source-meta div { border-top: 1px solid var(--line); padding-top: 10px; }
  .source-meta dt { color: var(--muted); font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; }
  .source-meta dd { margin: 4px 0 0; font-size: .9rem; font-weight: 600; }
  .claim-block { display: grid; grid-template-columns: minmax(150px, .35fr) minmax(0, 1.65fr); gap: 22px; padding: 20px 0; border-top: 1px solid var(--line); }
  .claim-block > span { font-size: .72rem; font-weight: 600; letter-spacing: .065em; text-transform: uppercase; color: var(--teal); }
  .claim-block p { margin: 0; color: var(--muted); }
  .context-claim > span { color: var(--amber-ink); }
  .source-link { display: inline-flex; gap: 8px; margin-top: 22px; color: var(--teal); font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 760px) {
    .evidence-hero-grid, .evidence-entry { grid-template-columns: 1fr; gap: 30px; }
    .evidence-index { display: grid; grid-template-columns: auto 1fr auto; align-items: center; padding: 20px; border-right: 0; border-bottom: 1px solid var(--line); }
    .evidence-tag { margin: 0; }
    .source-meta { grid-template-columns: 1fr; gap: 10px; }
    .claim-block { grid-template-columns: 1fr; gap: 8px; }
  }
  @media (max-width: 420px) { .evidence-index { grid-template-columns: auto 1fr; } .evidence-tag { grid-column: 1 / -1; } }
</style>
