---
import Base from '../layouts/Base.astro';
import { evidence } from '../data/evidence';
interface Props { locale:'th'|'en' }
const { locale } = Astro.props; const en = locale === 'en';
---
<Base locale={locale} path="evidence" title={en?'Evidence & Milestones | HealthTAG':'หลักฐานและหมุดหมาย | HealthTAG'} description={en?'Source-backed milestones and external validation for HealthTAG.':'หลักฐานภายนอกและหมุดหมายสำคัญของ HealthTAG พร้อมลิงก์ต้นทาง'}>
<main>
<section class="page-hero"><div class="container"><div class="eyebrow">HealthTAG / {en?'Evidence':'หลักฐาน'}</div><h1>{en?'Claims should be traceable.':'ทุก claim ควรย้อนกลับไปดูแหล่งที่มาได้'}</h1><p>{en?'External validation, public-sector programs, awards, deployments, and strategic collaborations with direct links to original sources.':'รวบรวมหลักฐานจากหน่วยงานภายนอก โครงการภาครัฐ รางวัล การใช้งานจริง และความร่วมมือเชิงยุทธศาสตร์ พร้อมลิงก์ต้นทางโดยตรง'}</p></div></section>
<section class="section"><div class="container evidence-grid">{evidence.map(item=><article class="evidence-card"><div class="evidence-top"><span class="evidence-year">{item.year}</span><span class="evidence-tag">{item.tag[locale]}</span></div><h2>{item.title}</h2><p>{item.body[locale]}</p><a class="source-link" href={item.href[locale]} target="_blank" rel="noopener noreferrer">{en?'Read original source':'เปิดแหล่งข้อมูลต้นทาง'} ↗ <span>{item.source[locale]}</span></a></article>)}</div></section>
<section class="section"><div class="container prose"><div class="callout"><strong>{en?'Evidence policy:':'หลักการของหน้านี้:'}</strong> {en?'A partner relationship is not presented as a deployment, an award is not presented as regulatory approval, and a future collaboration is not presented as a live production capability.':'ความสัมพันธ์กับ partner จะไม่ถูกเขียนให้เหมือน deployment, รางวัลจะไม่ถูกเขียนให้เหมือนการรับรองด้านกฎระเบียบ และความร่วมมือในอนาคตจะไม่ถูกเขียนให้เหมือน capability ที่ใช้งาน production แล้ว'}</div></div></section>
</main>
</Base>
