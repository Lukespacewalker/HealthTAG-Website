---
import Base from '../layouts/Base.astro';
interface Props { locale:'th'|'en' }
const { locale } = Astro.props;
const en = locale === 'en';
const sources = en ? [
  {year:'2021',tag:'Deployment',title:'Siriraj 5G Smart Hospital',body:'Siriraj officially described nine smart-hospital workstreams, including Permission based blockchain for personal health record. HealthTAG participated in that PHR workstream.',href:'https://www2.si.mahidol.ac.th/en/2021/',source:'Faculty of Medicine Siriraj Hospital'},
  {year:'2022',tag:'Award',title:'APICTA 2022 · Cross Category – Start-Up',body:'HealthTAG was recognized as the winner in the Cross Category – Start-Up category at APICTA 2022.',href:'https://www.cioworldbusiness.com/thai-digital-technology-company-that-won-the-apicta-2022-award/',source:'CIO World Business'},
  {year:'2023–2024',tag:'Regulatory validation',title:'ETDA Digital Service Sandbox',body:'ETDA lists HealthTAG’s health-data exchange network as having completed the Digital Service Sandbox, with testing outcomes meeting the defined goals and success indicators.',href:'https://www.etda.or.th/th/Our-Service/Digital-Service-Sandbox/announce.aspx',source:'ETDA'},
  {year:'2023',tag:'Public-sector collaboration',title:'depa × HealthTAG',body:'depa announced an MoU with HealthTAG to develop blockchain infrastructure for public services.',href:'https://www.depa.or.th/th/article-view/20230112_03',source:'depa'},
  {year:'2025',tag:'International ecosystem',title:'NIA Corporate SPARK Outbound · China',body:'NIA selected HealthTAG as one of three Thai companies for the 2025 China Program, including business matching and market-expansion support.',href:'https://www.nia.or.th/Shanghai-CorporateSPARK2025',source:'National Innovation Agency'},
  {year:'2025–2026',tag:'International recognition',title:'ODESS field profile',body:'ODESS profiles HealthTAG as a Thai digital-health initiative focused on fragmented health data, interoperability, patient access, and HL7 FHIR.',href:'https://www.odess.io/en/initiative/decentralized-health-care-empowering-well-being-countrywide/',source:'ODESS / Fondation Pierre Fabre'},
  {year:'2026',tag:'Strategic collaboration',title:'Orbix Technology × HealthTAG',body:'KASIKORNBANK announced a collaboration between Orbix Technology and HealthTAG around digital health-data infrastructure, HealthTAG Wallet, HL7 FHIR interoperability, and Quarix blockchain infrastructure.',href:'https://www.kasikornbank.com/en/news/pages/healthtag.aspx',source:'KASIKORNBANK'}
] : [
  {year:'2021',tag:'Deployment',title:'Siriraj 5G Smart Hospital',body:'ศิริราชประกาศโครงการ Smart Hospital จำนวน 9 โครงการย่อย โดยมี Permission based blockchain for personal health record เป็นหนึ่งในโครงการ และ HealthTAG เข้าร่วมใน workstream ด้าน PHR นี้',href:'https://si.mahidol.ac.th/th/hotnewsdetail.asp?hn_id=2728',source:'คณะแพทยศาสตร์ศิริราชพยาบาล'},
  {year:'2022',tag:'Award',title:'APICTA 2022 · Cross Category – Start-Up',body:'HealthTAG ได้รับรางวัลชนะเลิศในหมวด Cross Category – Start-Up ในงาน APICTA 2022',href:'https://www.cioworldbusiness.com/thai-digital-technology-company-that-won-the-apicta-2022-award/',source:'CIO World Business'},
  {year:'2023–2024',tag:'Regulatory validation',title:'ETDA Digital Service Sandbox',body:'ETDA ระบุบริการเครือข่ายเชื่อมโยงข้อมูลสุขภาพ HealthTAG และสถานะออกจาก Digital Service Sandbox โดยผลการทดสอบเป็นไปตามเป้าหมายและตัวชี้วัดความสำเร็จที่กำหนด',href:'https://www.etda.or.th/th/Our-Service/Digital-Service-Sandbox/announce.aspx',source:'ETDA'},
  {year:'2023',tag:'Public-sector collaboration',title:'depa × HealthTAG',body:'depa ประกาศการลงนาม MoU ร่วมกับ HealthTAG เพื่อพัฒนาโครงสร้างพื้นฐาน Blockchain สำหรับบริการประชาชน',href:'https://www.depa.or.th/th/article-view/20230112_03',source:'depa'},
  {year:'2025',tag:'International ecosystem',title:'NIA Corporate SPARK Outbound · China',body:'NIA คัดเลือก HealthTAG เป็นหนึ่งในสามผู้ประกอบการไทยใน China Program 2025 พร้อมกิจกรรม business matching และการสนับสนุนด้านการขยายตลาด',href:'https://www.nia.or.th/Shanghai-CorporateSPARK2025',source:'สำนักงานนวัตกรรมแห่งชาติ'},
  {year:'2025–2026',tag:'International recognition',title:'ODESS field profile',body:'ODESS นำเสนอ HealthTAG เป็นโครงการ digital health จากไทยที่แก้ปัญหาข้อมูลสุขภาพกระจัดกระจาย interoperability การเข้าถึงข้อมูลของผู้ป่วย และการใช้ HL7 FHIR',href:'https://www.odess.io/en/initiative/decentralized-health-care-empowering-well-being-countrywide/',source:'ODESS / Fondation Pierre Fabre'},
  {year:'2026',tag:'Strategic collaboration',title:'Orbix Technology × HealthTAG',body:'ธนาคารกสิกรไทยประกาศความร่วมมือ Orbix Technology และ HealthTAG ในการพัฒนาโครงสร้างพื้นฐานข้อมูลสุขภาพดิจิทัล โดยกล่าวถึง HealthTAG Wallet, HL7 FHIR interoperability และ Quarix blockchain infrastructure',href:'https://www.kasikornbank.com/th/news/pages/healthtag.aspx',source:'ธนาคารกสิกรไทย'}
];
---
<Base locale={locale} path="evidence" title={en?'Evidence & Milestones | HealthTAG':'หลักฐานและหมุดหมาย | HealthTAG'} description={en?'Source-backed milestones and external validation for HealthTAG.':'หลักฐานภายนอกและหมุดหมายสำคัญของ HealthTAG พร้อมลิงก์ต้นทาง'}>
<main>
<section class="page-hero"><div class="container"><div class="eyebrow">HealthTAG / {en?'Evidence':'หลักฐาน'}</div><h1>{en?'Claims should be traceable.':'ทุก claim ควรย้อนกลับไปดูแหล่งที่มาได้'}</h1><p>{en?'This page collects external validation, public-sector programs, awards, deployments, and strategic collaborations with direct links to the original sources.':'หน้านี้รวบรวมหลักฐานจากหน่วยงานภายนอก โครงการภาครัฐ รางวัล การใช้งานจริง และความร่วมมือเชิงยุทธศาสตร์ พร้อมลิงก์ไปยังแหล่งข่าวต้นทางโดยตรง'}</p></div></section>
<section class="section"><div class="container evidence-grid">{sources.map(item=><article class="evidence-card"><div class="evidence-top"><span class="evidence-year">{item.year}</span><span class="evidence-tag">{item.tag}</span></div><h2>{item.title}</h2><p>{item.body}</p><a class="source-link" href={item.href} target="_blank" rel="noopener noreferrer">{en?'Read original source':'เปิดแหล่งข้อมูลต้นทาง'} ↗ <span>{item.source}</span></a></article>)}</div></section>
<section class="section"><div class="container prose"><div class="callout"><strong>{en?'Evidence policy:':'หลักการของหน้านี้:'}</strong> {en?'A partner relationship is not presented as a deployment, an award is not presented as regulatory approval, and a future collaboration is not presented as a live production capability.':'ความสัมพันธ์กับ partner จะไม่ถูกเขียนให้เหมือน deployment, รางวัลจะไม่ถูกเขียนให้เหมือนการรับรองด้านกฎระเบียบ และความร่วมมือในอนาคตจะไม่ถูกเขียนให้เหมือน capability ที่ใช้งาน production แล้ว'}</div></div></section>
</main>
</Base>
