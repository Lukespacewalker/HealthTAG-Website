---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { formatPublicationDate, getPublishedPublications, pageSize, publicationPath, publicationSearchText, type PublicationKind, type PublicationLocale } from '../lib/publications';

interface Props { locale: PublicationLocale; view: 'all' | 'news' | 'articles' | 'awards'; }
const { locale, view } = Astro.props;
const en = locale === 'en';
const prefix = en ? '/en' : '';
const path = view === 'all' ? 'posts' : view;
const selectedKind: PublicationKind | undefined = view === 'articles' ? 'article' : view === 'awards' ? 'award' : view === 'news' ? 'news' : undefined;
const allEntries = await getPublishedPublications(locale);
const entries = allEntries.filter((entry) => selectedKind ? entry.data.kind === selectedKind : entry.data.kind !== 'award');
const featuredEntries = view === 'news' ? entries.filter((entry) => entry.data.featured) : [];
const browserEntries = view === 'news' ? entries.filter((entry) => !entry.data.featured) : entries;
const copy = {
  all: { title: en ? 'News and articles from HealthTAG' : 'ข่าวและบทความจาก HealthTAG', description: en ? 'Company news and HealthTAG articles about health data, interoperability, and patient access.' : 'ข่าวบริษัทและบทความจาก HealthTAG เรื่องข้อมูลสุขภาพ การเชื่อมโยงระบบ และการเข้าถึงข้อมูลของผู้ป่วย' },
  news: { title: en ? 'HealthTAG news' : 'ข่าวจาก HealthTAG', description: en ? 'Company activity, events, and collaborations from HealthTAG.' : 'ความเคลื่อนไหว กิจกรรม และความร่วมมือของ HealthTAG' },
  articles: { title: en ? 'HealthTAG articles' : 'บทความจาก HealthTAG', description: en ? 'HealthTAG articles about healthcare data and the systems that connect it.' : 'บทความจาก HealthTAG เรื่องข้อมูลสุขภาพและระบบที่ใช้เชื่อมโยงข้อมูล' },
  awards: { title: en ? 'Awards' : 'รางวัล', description: en ? 'Awards and competition results involving HealthTAG.' : 'รางวัลและผลการแข่งขันที่เกี่ยวข้องกับ HealthTAG' },
}[view];
const eyebrow = {
  all: en ? 'All news & articles' : 'ข่าวและบทความทั้งหมด',
  news: en ? 'News' : 'ข่าว',
  articles: en ? 'Articles' : 'บทความ',
  awards: en ? 'Awards' : 'รางวัล',
}[view];
const tabs = [
  ['posts', en ? 'All news & articles' : 'ข่าวและบทความทั้งหมด', view === 'all'],
  ['news', en ? 'News' : 'ข่าว', view === 'news'],
  ['articles', en ? 'Articles' : 'บทความ', view === 'articles'],
  ['awards', en ? 'Awards' : 'รางวัล', view === 'awards'],
] as const;
const collectionJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'CollectionPage', name: copy.title, description: copy.description, inLanguage: locale, mainEntity: { '@type': 'ItemList', numberOfItems: entries.length, itemListElement: entries.map((entry, index) => ({ '@type': 'ListItem', position: index + 1, url: new URL(publicationPath(entry), Astro.site ?? 'https://healthtag.io').href, name: entry.data.title })) } });
---
<Base locale={locale} path={path} title={`${copy.title} | HealthTAG`} description={copy.description}>
  <script type="application/ld+json" set:html={collectionJson} is:inline></script>
  <main>
    <header class="publication-index-hero">
      <div class="container publication-index-heading">
        <div><p class="eyebrow">HealthTAG / {eyebrow}</p><h1>{copy.title}</h1><p>{copy.description}</p></div>
      </div>
      <nav class="container publication-tabs" aria-label={en ? 'Publication sections' : 'หมวดเนื้อหาเผยแพร่'}>
        {tabs.map(([href, label, active]) => <a href={`${prefix}/${href}/`} aria-current={active ? 'page' : undefined}>{label}</a>)}
      </nav>
    </header>
    {featuredEntries.length > 0 && <section class="publication-featured" aria-labelledby="publication-featured-title">
      <div class="container">
        <div class="publication-featured-head">
          <p class="eyebrow">HealthTAG / {en ? 'News' : 'ข่าว'}</p>
          <h2 id="publication-featured-title">{en ? 'Featured news' : 'ข่าวเด่น'}</h2>
        </div>
        <div class="publication-featured-grid">
          {featuredEntries.map((entry, index) => {
            const image = entry.data.images[0];
            const date = entry.data.publishedAt ?? entry.data.eventDate ?? entry.data.migratedAt;
            return <article class:list={['publication-featured-card', { lead: index === 0 }]}>
              <a class="publication-featured-media" href={publicationPath(entry)} tabindex="-1" aria-hidden="true">
                <Image src={image.src} alt="" widths={[480, 760, 1120]} sizes="(max-width: 800px) calc(100vw - 28px), 60vw" loading={index === 0 ? 'eager' : 'lazy'} />
              </a>
              <div class="publication-featured-copy">
                <div><span>{en ? 'Featured' : 'ข่าวเด่น'}</span><time datetime={date}>{formatPublicationDate(date, locale)}</time></div>
                <h3><a href={publicationPath(entry)}>{entry.data.title}</a></h3>
                <p>{entry.data.summary}</p>
              </div>
            </article>;
          })}
        </div>
      </div>
    </section>}
    <section class="publication-browser" aria-labelledby="publication-browser-title">
      <div class="container">
        <h2 id="publication-browser-title" class="sr-only">{en ? 'Browse publications' : 'ค้นหาเนื้อหาเผยแพร่'}</h2>
        <form class="publication-search" role="search" method="get" action={`${prefix}/${path}/`} data-publication-search>
          <label for={`publication-query-${locale}`}>{view === 'news' ? (en ? 'Search more news' : 'ค้นหาข่าวเพิ่มเติม') : (en ? 'Search this section' : 'ค้นหาในหมวดนี้')}</label>
          <div><input id={`publication-query-${locale}`} name="q" type="search" autocomplete="off" placeholder={en ? 'Search title, summary, or category' : 'ค้นหาชื่อเรื่อง เนื้อหาสรุป หรือหมวดหมู่'} /><button type="submit">{en ? 'Search' : 'ค้นหา'}</button></div>
        </form>
        <p class="publication-results" aria-live="polite" data-results-count data-label-one={en ? 'result' : 'รายการ'} data-label-many={en ? 'results' : 'รายการ'}></p>
        <div class="publication-card-list" data-publication-list>
          {browserEntries.map((entry) => {
            const image = entry.data.images[0];
            const label = entry.data.kind === 'article' ? (en ? 'Article' : 'บทความ') : entry.data.kind === 'award' ? (en ? 'Award' : 'รางวัล') : (en ? 'News' : 'ข่าว');
            return <article class="publication-card" data-search={publicationSearchText(entry)}>
              <a class="publication-card-media" href={publicationPath(entry)} tabindex="-1" aria-hidden="true"><Image src={image.src} alt="" widths={[360, 560, 760]} sizes="(max-width: 700px) calc(100vw - 28px), 33vw" loading="lazy" /></a>
              <div class="publication-card-copy">
                <div class="publication-card-meta"><span>{label}</span><time datetime={entry.data.publishedAt ?? entry.data.eventDate ?? entry.data.migratedAt}>{formatPublicationDate(entry.data.publishedAt ?? entry.data.eventDate ?? entry.data.migratedAt, locale)}</time></div>
                <h2><a href={publicationPath(entry)}>{entry.data.title}</a></h2><p>{entry.data.summary}</p>
                <div class="publication-card-footer"><span>{entry.data.category}</span><span>{entry.data.author}</span></div>
              </div>
            </article>;
          })}
        </div>
        <p class="publication-empty" data-empty hidden>{en ? 'No publications match this search.' : 'ไม่พบเนื้อหาที่ตรงกับคำค้น'}</p>
        <nav class="publication-pagination" aria-label={en ? 'Publication pages' : 'หน้ารายการเนื้อหา'} data-pagination></nav>
      </div>
    </section>
  </main>
  <script is:inline define:vars={{ pageSize }}>
    (() => {
      const form = document.querySelector('[data-publication-search]');
      const input = form?.querySelector('input[name="q"]');
      const cards = [...document.querySelectorAll('[data-publication-list] > [data-search]')];
      const count = document.querySelector('[data-results-count]');
      const empty = document.querySelector('[data-empty]');
      const pagination = document.querySelector('[data-pagination]');
      if (!form || !input || !count || !empty || !pagination) return;
      const normalized = (value) => value.normalize('NFKC').toLocaleLowerCase(document.documentElement.lang).trim();
      const pageUrl = (page, query) => { const url = new URL(window.location.href); query ? url.searchParams.set('q', query) : url.searchParams.delete('q'); page > 1 ? url.searchParams.set('page', String(page)) : url.searchParams.delete('page'); return `${url.pathname}${url.search}`; };
      const render = () => {
        const params = new URLSearchParams(window.location.search); const query = params.get('q') ?? ''; input.value = query;
        const matches = cards.filter((card) => card.dataset.search.includes(normalized(query))); const pageCount = Math.max(1, Math.ceil(matches.length / pageSize));
        const requestedPage = Number.parseInt(params.get('page') ?? '1', 10); const page = Number.isFinite(requestedPage) ? Math.min(Math.max(requestedPage, 1), pageCount) : 1;
        cards.forEach((card) => { card.hidden = true; }); matches.slice((page - 1) * pageSize, page * pageSize).forEach((card) => { card.hidden = false; });
        const label = matches.length === 1 ? count.dataset.labelOne : count.dataset.labelMany; count.textContent = `${matches.length} ${label}`; empty.hidden = matches.length !== 0; pagination.replaceChildren();
        for (let number = 1; number <= pageCount && matches.length; number += 1) { const link = document.createElement('a'); link.href = pageUrl(number, query); link.textContent = String(number); link.setAttribute('aria-label', `${document.documentElement.lang === 'th' ? 'หน้า' : 'Page'} ${number}`); if (number === page) link.setAttribute('aria-current', 'page'); pagination.append(link); }
      };
      const navigate = (url) => { history.pushState({}, '', url); render(); window.scrollTo({ top: form.offsetTop - 100, behavior: 'smooth' }); };
      form.addEventListener('submit', (event) => { event.preventDefault(); navigate(pageUrl(1, input.value.trim())); });
      pagination.addEventListener('click', (event) => { const link = event.target.closest('a'); if (!link) return; event.preventDefault(); navigate(link.getAttribute('href')); });
      window.addEventListener('popstate', render); render();
    })();
  </script>
</Base>

<style>
  .publication-featured { padding: clamp(3rem, 6vw, 5rem) 0; color: var(--paper); background: var(--ink); }
  .publication-featured-head { display: grid; grid-template-columns: minmax(10rem, .42fr) minmax(0, 1.58fr); gap: clamp(1.5rem, 5vw, 4rem); align-items: end; margin-bottom: clamp(1.75rem, 4vw, 3rem); }
  .publication-featured-head .eyebrow { margin: 0; color: #8bb6d9; }
  .publication-featured-head h2 { margin: 0; font-size: clamp(2.2rem, 4.8vw, 4.4rem); line-height: 1.04; letter-spacing: -.05em; }
  .publication-featured-grid { display: grid; grid-template-columns: minmax(0, 1.18fr) minmax(0, .82fr); gap: 1px; background: rgba(228,241,250, .22); border: 1px solid rgba(228,241,250, .22); }
  .publication-featured-card { display: grid; min-width: 0; grid-template-rows: auto 1fr; background: var(--ink); }
  .publication-featured-media { aspect-ratio: 16 / 10; overflow: hidden; background: #09152a; }
  .publication-featured-media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .25s ease; }
  .publication-featured-card:hover .publication-featured-media :global(img) { transform: scale(1.02); }
  .publication-featured-copy { padding: clamp(1.25rem, 3vw, 2.25rem); }
  .publication-featured-copy > div { display: flex; gap: 1rem; justify-content: space-between; color: #bdc7d0; font-size: .75rem; }
  .publication-featured-copy > div span { color: #8bb6d9; font: 600 .68rem/1.4 'IBM Plex Mono', ui-monospace, monospace; letter-spacing: .06em; text-transform: uppercase; }
  .publication-featured-card h3 { margin: .85rem 0 .7rem; font-size: clamp(1.45rem, 2.7vw, 2.45rem); line-height: 1.12; letter-spacing: -.035em; text-wrap: balance; }
  .publication-featured-card:not(.lead) h3 { font-size: clamp(1.35rem, 2.2vw, 1.9rem); }
  .publication-featured-card h3 a:hover { color: #8bb6d9; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .publication-featured-card p { margin: 0; color: #bdc7d0; }
  @media (max-width: 800px) {
    .publication-featured-head, .publication-featured-grid { grid-template-columns: 1fr; }
    .publication-featured-head { align-items: start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .publication-featured-media :global(img) { transition: none; }
    .publication-featured-card:hover .publication-featured-media :global(img) { transform: none; }
  }
</style>
